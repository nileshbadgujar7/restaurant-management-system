@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Sign In - " + Model.RestaurantName;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title id="pageTitle">@ViewData["Title"]</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --brand-emerald: #059669;
            --brand-emerald-hover: #047857;
            --brand-amber: #d97706;
            --border-color: #cbd5e1;
        }

        body {
            background-color: #f1f5f9;
            background-image: 
                radial-gradient(circle at 15% 20%, rgba(5, 150, 105, 0.08) 0%, transparent 40%),
                radial-gradient(circle at 85% 80%, rgba(217, 119, 6, 0.06) 0%, transparent 40%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px 16px;
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            color: #0f172a;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            background: #ffffff;
            border: 1.5px solid var(--border-color);
            border-radius: 20px;
            box-shadow: 0 16px 36px rgba(15, 23, 42, 0.07);
            padding: 32px 28px;
        }

        .brand-crest {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: linear-gradient(135deg, #059669 0%, #10b981 50%, #d97706 100%);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-family: 'Outfit', sans-serif;
            font-weight: 800;
            font-size: 1.5rem;
            box-shadow: 0 6px 14px rgba(5, 150, 105, 0.25);
            border: 2px solid #ffffff;
        }

        .brand-title {
            font-family: 'Outfit', sans-serif;
            font-weight: 800;
            font-size: 1.55rem;
            letter-spacing: -0.3px;
            background: linear-gradient(135deg, #059669 0%, #0d9488 45%, #d97706 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Sleek Dynamic Role & Mode Indicator */
        .role-mode-indicator {
            background: #f8fafc;
            border: 1.5px solid #e2e8f0;
            transition: all 0.2s ease;
        }

        .role-mode-indicator.highlight {
            background: #f0fdf4;
            border-color: #86efac;
        }

        .role-chip-btn {
            border: 1px solid var(--border-color);
            background: #ffffff;
            color: #475569;
            border-radius: 16px;
            padding: 3px 10px;
            font-size: 0.72rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s ease;
            user-select: none;
        }

        .role-chip-btn:hover, .role-chip-btn.active {
            background: #ecfdf5;
            border-color: var(--brand-emerald);
            color: var(--brand-emerald);
        }

        /* Form Inputs */
        .input-group-custom {
            position: relative;
        }

        .input-group-custom .form-control {
            border: 1.5px solid var(--border-color);
            border-radius: 10px;
            height: 46px;
            padding-left: 40px;
            font-size: 0.92rem;
            color: #0f172a;
        }

        .input-group-custom .form-control:focus {
            border-color: var(--brand-emerald);
            box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.14);
        }

        .input-group-custom .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 0.95rem;
            pointer-events: none;
        }

        .toggle-pw-btn {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #94a3b8;
            font-size: 0.9rem;
            cursor: pointer;
        }

        .toggle-pw-btn:hover {
            color: var(--brand-emerald);
        }

        .btn-signin {
            background: linear-gradient(135deg, #059669 0%, #10b981 100%);
            border: none;
            color: #ffffff;
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            font-size: 0.95rem;
            border-radius: 10px;
            height: 46px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 4px 12px rgba(5, 150, 105, 0.25);
            transition: all 0.2s ease;
        }

        .btn-signin:hover {
            background: linear-gradient(135deg, #047857 0%, #059669 100%);
            color: #ffffff;
            transform: translateY(-1px);
        }
    </style>
</head>
<body>

<div class="login-card">
    <!-- Language Switcher Pill -->
    <div class="d-flex justify-content-end mb-2">
        <div class="btn-group btn-group-sm rounded-pill border bg-white p-1 shadow-sm" role="group">
            <button type="button" class="btn btn-outline-secondary rounded-pill py-0 px-2 fw-bold active" id="langEnBtn" onclick="setLanguage('en')">
                English
            </button>
            <button type="button" class="btn btn-outline-secondary rounded-pill py-0 px-2 fw-bold" id="langMrBtn" onclick="setLanguage('mr')">
                मराठी
            </button>
        </div>
    </div>

    <!-- Brand Header: Dynamic Logo & Name -->
    <div class="text-center mb-3">
        @if (!string.IsNullOrEmpty(Model.LogoUrl))
        {
            <div class="mb-2">
                <img src="@Model.LogoUrl" alt="Logo" id="brandLogo" style="max-height: 56px; max-width: 180px; object-fit: contain;" onerror="this.style.display='none'; document.getElementById('brandCrestFallback').style.display='inline-flex';" />
                <div class="brand-crest mb-2" id="brandCrestFallback" style="display: none;">
                    @((string.IsNullOrEmpty(Model.RestaurantName) ? "G" : Model.RestaurantName.Substring(0, 1).ToUpper()))
                </div>
            </div>
        }
        else
        {
            <div class="brand-crest mb-2">
                @((string.IsNullOrEmpty(Model.RestaurantName) ? "G" : Model.RestaurantName.Substring(0, 1).ToUpper()))
            </div>
        }
        <h2 class="brand-title mb-0" id="brandNameDisplay">@Model.RestaurantName</h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success p-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
            <i class="fa-solid fa-circle-check text-success flex-shrink-0"></i>
            <div>@TempData["Success"]</div>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger p-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
            <i class="fa-solid fa-circle-exclamation flex-shrink-0"></i>
            <div>@Model.ErrorMessage</div>
        </div>
    }

    <!-- Dynamic Role & Operational Mode Indicator -->
    <div class="role-mode-indicator d-flex align-items-center justify-content-between p-2 px-3 rounded-3 mb-2" id="roleIndicatorBox">
        <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-briefcase text-success" id="roleIcon"></i>
            <span class="fw-bold small text-dark" id="roleName">Restaurant Manager</span>
        </div>
        <span class="badge bg-light text-secondary border rounded-pill px-2 py-1" style="font-size: 0.72rem;" id="modeName">
            Operations Mode
        </span>
    </div>

    <!-- Quick Role Switcher Chips -->
    <div class="d-flex flex-wrap justify-content-center gap-1 mb-3">
        <button type="button" class="role-chip-btn active" id="chipManager" onclick="pickRole('manager', 'manager123', 'Restaurant Manager', 'fa-briefcase', '#059669', 'Operations Mode', this)">Manager</button>
        <button type="button" class="role-chip-btn" id="chipAdmin" onclick="pickRole('admin', 'admin123', 'Administrator', 'fa-user-gear', '#dc2626', 'Full Admin Mode', this)">Admin</button>
        <button type="button" class="role-chip-btn" id="chipCashier" onclick="pickRole('cashier', 'cashier123', 'Cashier', 'fa-cash-register', '#4f46e5', 'Billing Mode', this)">Cashier</button>
        <button type="button" class="role-chip-btn" id="chipWaiter" onclick="pickRole('waiter', 'waiter123', 'Waiter', 'fa-tray', '#d97706', 'Fast POS Mode', this)">Waiter</button>
        <button type="button" class="role-chip-btn" id="chipKitchen" onclick="pickRole('kitchen', 'kitchen123', 'Kitchen Head', 'fa-kitchen-set', '#ea580c', 'KDS Screen Mode', this)">Kitchen</button>
    </div>

    <!-- Sign In Form Panel -->
    <div id="loginFormSection">
        <form method="post" asp-action="Login" asp-controller="Account">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

            <div class="input-group-custom mb-3">
                <input type="text" class="form-control" id="usernameInput" name="Username" value="@Model.Username" placeholder="Username" required autocomplete="username" oninput="onUserType(this.value)" />
                <i class="fa-regular fa-user input-icon"></i>
            </div>

            <div class="input-group-custom mb-3">
                <input type="password" class="form-control" id="passwordInput" name="Password" value="@Model.Password" placeholder="Password" required autocomplete="current-password" />
                <i class="fa-solid fa-lock input-icon"></i>
                <button type="button" class="toggle-pw-btn" onclick="toggleVisibility('passwordInput', this)"><i class="fa-regular fa-eye"></i></button>
            </div>

            <div class="d-flex align-items-center justify-content-between mb-3 small">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="rememberMe" name="RememberMe" value="true" checked />
                    <label class="form-check-label text-secondary fw-semibold" for="rememberMe" id="rememberMeLabel">Remember me</label>
                </div>
                <button type="button" class="btn btn-link p-0 small text-decoration-none fw-bold" style="color: var(--brand-emerald);" onclick="toggleForgotPassword(true)" id="forgotPasswordLink">
                    Forgot password?
                </button>
            </div>

            <button type="submit" class="btn btn-signin w-100" id="signInSubmitBtn">
                <i class="fa-solid fa-right-to-bracket me-1"></i> <span id="signInBtnText">Sign In</span>
            </button>
        </form>
    </div>

    <!-- Forgot Password Panel -->
    <div id="forgotPasswordSection" class="d-none">
        <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom">
            <span class="fw-bold small text-dark" id="resetHeaderLabel"><i class="fa-solid fa-key text-warning me-1"></i> Reset Password</span>
            <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none small text-secondary" onclick="toggleForgotPassword(false)" id="backToLoginBtn">
                <i class="fa-solid fa-arrow-left me-1"></i> Back
            </button>
        </div>

        <div id="forgotStatusAlert" class="alert d-none p-2 px-3 small rounded-3 mb-2"></div>

        <form id="resetForm" onsubmit="submitForgotPassword(event)">
            <div class="input-group-custom mb-2">
                <input type="text" class="form-control form-control-sm" id="resetUser" placeholder="Username" required />
                <i class="fa-regular fa-user input-icon"></i>
            </div>

            <div class="input-group-custom mb-2">
                <input type="password" class="form-control form-control-sm" id="resetPin" placeholder="Manager PIN (1234)" required maxlength="10" />
                <i class="fa-solid fa-shield-halved input-icon"></i>
            </div>

            <div class="input-group-custom mb-2">
                <input type="password" class="form-control form-control-sm" id="resetNewPass" placeholder="New Password (min 4 chars)" required minlength="4" />
                <i class="fa-solid fa-lock input-icon"></i>
            </div>

            <div class="input-group-custom mb-3">
                <input type="password" class="form-control form-control-sm" id="resetConfirmPass" placeholder="Confirm New Password" required minlength="4" />
                <i class="fa-solid fa-check-double input-icon"></i>
            </div>

            <button type="submit" class="btn btn-signin w-100" id="resetSubmitBtn">
                Reset &amp; Save
            </button>
        </form>
    </div>

    <div class="text-center mt-3 pt-2 border-top text-muted small" style="font-size: 0.75rem;" id="loginFooterText">
        Secure Terminal Access
    </div>
</div>

<script>
    const nameEnglish = "@Html.Raw(Model.RestaurantName.Replace("\"", "\\\""))";
    const nameMarathi = "@Html.Raw((string.IsNullOrEmpty(Model.RestaurantNameMarathi) ? Model.RestaurantName : Model.RestaurantNameMarathi).Replace("\"", "\\\""))";

    const roleMap = {
        'admin': { 
            nameEn: 'Administrator', nameMr: 'प्रशासक (Admin)', 
            icon: 'fa-user-gear', color: '#dc2626', 
            modeEn: 'Full Admin Mode', modeMr: 'संपूर्ण अ‍ॅडमिन मोड', 
            pass: 'admin123' 
        },
        'manager': { 
            nameEn: 'Restaurant Manager', nameMr: 'रेस्टॉरंट व्यवस्थापक (Manager)', 
            icon: 'fa-briefcase', color: '#059669', 
            modeEn: 'Operations Mode', modeMr: 'ऑपरेशन्स मोड', 
            pass: 'manager123' 
        },
        'cashier': { 
            nameEn: 'Cashier & Billing', nameMr: 'कॅशियर आणि बिलिंग', 
            icon: 'fa-cash-register', color: '#4f46e5', 
            modeEn: 'Billing Mode', modeMr: 'बिलिंग मोड', 
            pass: 'cashier123' 
        },
        'waiter': { 
            nameEn: 'Floor Captain / Waiter', nameMr: 'फ्लोअर कॅप्टन / वेटर', 
            icon: 'fa-tray', color: '#d97706', 
            modeEn: 'Fast POS Mode', modeMr: 'फास्ट पीओएस मोड', 
            pass: 'waiter123' 
        },
        'kitchen': { 
            nameEn: 'Kitchen Head / Chef', nameMr: 'किचन हेड / मुख्य शेफ', 
            icon: 'fa-kitchen-set', color: '#ea580c', 
            modeEn: 'KDS Screen Mode', modeMr: 'केडीएस स्क्रीन मोड', 
            pass: 'kitchen123' 
        }
    };

    let currentSelectedUser = 'manager';
    let currentSelectedRoleInfo = roleMap['manager'];

    function pickRole(user, pass, name, icon, color, mode, btn) {
        currentSelectedUser = user;
        currentSelectedRoleInfo = roleMap[user];
        document.getElementById('usernameInput').value = user;
        document.getElementById('passwordInput').value = pass;
        document.getElementById('resetUser').value = user;

        document.querySelectorAll('.role-chip-btn').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');

        applyRoleBadge();
    }

    function onUserType(val) {
        val = (val || '').trim().toLowerCase();
        currentSelectedUser = val;
        const role = roleMap[val];
        if (role) {
            currentSelectedRoleInfo = role;
            applyRoleBadge();
            document.querySelectorAll('.role-chip-btn').forEach(b => {
                b.classList.toggle('active', b.id.toLowerCase().includes(val));
            });
        } else if (val.length > 0) {
            currentSelectedRoleInfo = {
                nameEn: 'Staff User (' + val + ')',
                nameMr: 'कर्मचारी (' + val + ')',
                icon: 'fa-user',
                color: '#64748b',
                modeEn: 'Standard Terminal',
                modeMr: 'प्रमाणित टर्मिनल'
            };
            applyRoleBadge();
            document.querySelectorAll('.role-chip-btn').forEach(b => b.classList.remove('active'));
        }
    }

    function applyRoleBadge() {
        const lang = localStorage.getItem('girana_rms_lang') || 'en';
        const isMr = lang === 'mr';
        const iconElem = document.getElementById('roleIcon');
        const nameElem = document.getElementById('roleName');
        const modeElem = document.getElementById('modeName');
        const box = document.getElementById('roleIndicatorBox');

        if (currentSelectedRoleInfo) {
            iconElem.className = 'fa-solid ' + currentSelectedRoleInfo.icon;
            iconElem.style.color = currentSelectedRoleInfo.color;
            nameElem.textContent = isMr ? currentSelectedRoleInfo.nameMr : currentSelectedRoleInfo.nameEn;
            modeElem.textContent = isMr ? currentSelectedRoleInfo.modeMr : currentSelectedRoleInfo.modeEn;
            box.classList.add('highlight');
        }
    }

    function toggleVisibility(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('i');
        const isPw = input.type === 'password';
        input.type = isPw ? 'text' : 'password';
        icon.className = isPw ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye';
    }

    function toggleForgotPassword(show) {
        document.getElementById('loginFormSection').classList.toggle('d-none', show);
        document.getElementById('forgotPasswordSection').classList.toggle('d-none', !show);
        if (show) {
            document.getElementById('resetUser').value = document.getElementById('usernameInput').value;
            document.getElementById('resetPin').focus();
        } else {
            document.getElementById('usernameInput').focus();
        }
    }

    async function submitForgotPassword(e) {
        e.preventDefault();
        const btn = document.getElementById('resetSubmitBtn');
        const alertBox = document.getElementById('forgotStatusAlert');

        const user = document.getElementById('resetUser').value.trim();
        const pin = document.getElementById('resetPin').value.trim();
        const newPass = document.getElementById('resetNewPass').value;
        const confirmPass = document.getElementById('resetConfirmPass').value;

        if (newPass !== confirmPass) {
            alertBox.className = 'alert alert-danger p-2 px-3 small rounded-3 mb-2';
            alertBox.textContent = (localStorage.getItem('girana_rms_lang') === 'mr') ? 'पासवर्ड जुळत नाहीत.' : 'Passwords do not match.';
            alertBox.classList.remove('d-none');
            return;
        }

        btn.disabled = true;
        btn.textContent = (localStorage.getItem('girana_rms_lang') === 'mr') ? 'अद्ययावत करत आहे...' : 'Updating...';

        try {
            const resp = await fetch('/Account/ForgotPassword', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ Username: user, ManagerPin: pin, NewPassword: newPass, ConfirmPassword: confirmPass })
            });
            const data = await resp.json();

            if (data.success) {
                alertBox.className = 'alert alert-success p-2 px-3 small rounded-3 mb-2';
                alertBox.textContent = data.message;
                alertBox.classList.remove('d-none');

                document.getElementById('usernameInput').value = user;
                document.getElementById('passwordInput').value = newPass;

                setTimeout(() => {
                    toggleForgotPassword(false);
                    alertBox.classList.add('d-none');
                }, 1500);
            } else {
                alertBox.className = 'alert alert-danger p-2 px-3 small rounded-3 mb-2';
                alertBox.textContent = data.message || 'Error resetting password.';
                alertBox.classList.remove('d-none');
            }
        } catch (err) {
            alertBox.className = 'alert alert-danger p-2 px-3 small rounded-3 mb-2';
            alertBox.textContent = 'Server communication error.';
            alertBox.classList.remove('d-none');
        } finally {
            btn.disabled = false;
            btn.textContent = (localStorage.getItem('girana_rms_lang') === 'mr') ? 'रीसेट करा आणि सेव्ह करा' : 'Reset & Save';
        }
    }

    // Bilingual (English / Marathi) dictionary & persistence
    const translations = {
        en: {
            brandName: nameEnglish,
            title: "Sign In - " + nameEnglish,
            username: 'Username',
            password: 'Password',
            rememberMe: 'Remember me',
            forgotPassword: 'Forgot password?',
            signIn: 'Sign In',
            resetTitle: '<i class="fa-solid fa-key text-warning me-1"></i> Reset Password',
            back: '<i class="fa-solid fa-arrow-left me-1"></i> Back',
            resetUserPh: 'Username',
            resetPinPh: 'Manager PIN (1234)',
            resetNewPassPh: 'New Password (min 4 chars)',
            resetConfirmPassPh: 'Confirm New Password',
            resetSubmitBtn: 'Reset & Save',
            footer: 'Secure Terminal Access',
            chipMgr: 'Manager',
            chipAdm: 'Admin',
            chipCash: 'Cashier',
            chipWait: 'Waiter',
            chipKit: 'Kitchen'
        },
        mr: {
            brandName: nameMarathi,
            title: "साइन इन करा - " + nameMarathi,
            username: 'वापरकर्ता नाव (Username)',
            password: 'पासवर्ड (Password)',
            rememberMe: 'मला लक्षात ठेवा',
            forgotPassword: 'पासवर्ड विसरलात?',
            signIn: 'साइन इन करा',
            resetTitle: '<i class="fa-solid fa-key text-warning me-1"></i> पासवर्ड रीसेट करा',
            back: '<i class="fa-solid fa-arrow-left me-1"></i> मागे जा',
            resetUserPh: 'वापरकर्ता नाव',
            resetPinPh: 'मॅनेजर पिन (1234)',
            resetNewPassPh: 'नवीन पासवर्ड (किमान 4 अक्षरे)',
            resetConfirmPassPh: 'नवीन पासवर्ड पुष्टी करा',
            resetSubmitBtn: 'रीसेट करा आणि सेव्ह करा',
            footer: 'सुरक्षित टर्मिनल प्रवेश (Secure Terminal Access)',
            chipMgr: 'व्यवस्थापक',
            chipAdm: 'अ‍ॅडमिन',
            chipCash: 'कॅशियर',
            chipWait: 'वेटर',
            chipKit: 'किचन'
        }
    };

    function setLanguage(lang) {
        localStorage.setItem('girana_rms_lang', lang);
        document.cookie = `GiranaRMS.Language=${lang};path=/;max-age=31536000;SameSite=Lax`;

        const bEn = document.getElementById('langEnBtn');
        const bMr = document.getElementById('langMrBtn');
        if (lang === 'mr') {
            bMr.classList.add('active');
            bEn.classList.remove('active');
        } else {
            bEn.classList.add('active');
            bMr.classList.remove('active');
        }

        const t = translations[lang] || translations.en;
        document.title = t.title;
        const brandElem = document.getElementById('brandNameDisplay');
        if (brandElem) brandElem.textContent = t.brandName;

        const uIn = document.getElementById('usernameInput');
        if (uIn) uIn.placeholder = t.username;
        const pIn = document.getElementById('passwordInput');
        if (pIn) pIn.placeholder = t.password;
        const rmL = document.getElementById('rememberMeLabel');
        if (rmL) rmL.textContent = t.rememberMe;
        const fpL = document.getElementById('forgotPasswordLink');
        if (fpL) fpL.textContent = t.forgotPassword;
        const siT = document.getElementById('signInBtnText');
        if (siT) siT.textContent = t.signIn;

        const cM = document.getElementById('chipManager');
        if (cM) cM.textContent = t.chipMgr;
        const cA = document.getElementById('chipAdmin');
        if (cA) cA.textContent = t.chipAdm;
        const cC = document.getElementById('chipCashier');
        if (cC) cC.textContent = t.chipCash;
        const cW = document.getElementById('chipWaiter');
        if (cW) cW.textContent = t.chipWait;
        const cK = document.getElementById('chipKitchen');
        if (cK) cK.textContent = t.chipKit;

        const rhL = document.getElementById('resetHeaderLabel');
        if (rhL) rhL.innerHTML = t.resetTitle;
        const bBtn = document.getElementById('backToLoginBtn');
        if (bBtn) bBtn.innerHTML = t.back;
        const rUser = document.getElementById('resetUser');
        if (rUser) rUser.placeholder = t.resetUserPh;
        const rPin = document.getElementById('resetPin');
        if (rPin) rPin.placeholder = t.resetPinPh;
        const rNP = document.getElementById('resetNewPass');
        if (rNP) rNP.placeholder = t.resetNewPassPh;
        const rCP = document.getElementById('resetConfirmPass');
        if (rCP) rCP.placeholder = t.resetConfirmPassPh;
        const rSub = document.getElementById('resetSubmitBtn');
        if (rSub) rSub.textContent = t.resetSubmitBtn;
        const fTxt = document.getElementById('loginFooterText');
        if (fTxt) fTxt.textContent = t.footer;

        applyRoleBadge();
    }

    document.addEventListener('DOMContentLoaded', function() {
        const savedLang = localStorage.getItem('girana_rms_lang') || 
            (document.cookie.match(/(?:^|;\s*)GiranaRMS\.Language=([^;]+)/) || [])[1] || 'en';
        setLanguage(savedLang);

        const u = document.getElementById('usernameInput').value;
        if (u) onUserType(u);
    });
</script>
</body>
</html>