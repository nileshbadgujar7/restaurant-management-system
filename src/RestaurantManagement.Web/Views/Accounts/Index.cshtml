@model AccountsViewModel
@{
    ViewData["Title"] = "Accounts & Payroll Management";
    string activeTab = Model.ActiveTab;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 animated-fade-in">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 fs-6">
                <li class="breadcrumb-item">
                    <a href="/Dashboard" class="text-decoration-none fw-semibold text-success">
                        <i class="fa-solid fa-chart-pie me-1"></i> Dashboard
                    </a>
                </li>
                <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">
                    <i class="fa-solid fa-file-invoice-dollar text-success me-1"></i> Accounts & Payroll
                </li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-file-invoice-dollar text-success me-2"></i>Accounts, Ledger & Payroll
        </h2>
        <div class="text-muted small mt-1">
            Employee advances, repayment collections, attendance-based salary calculations & restaurant cash flow
        </div>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#giveAdvanceModal">
            <i class="fa-solid fa-hand-holding-dollar me-1"></i> Give Advance
        </button>
        <button class="btn btn-outline-success rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#collectPaymentModal">
            <i class="fa-solid fa-money-bill-transfer me-1"></i> Collect Advance Repayment
        </button>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Accounts KPI Overview Cards -->
<div class="row g-3 mb-4 animated-fade-in">
    <div class="col-xl-3 col-md-6 col-12">
        <div class="glass-card p-3 p-xl-4 h-100 border-start border-4 border-success">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Total Settled Revenue</div>
                    <div class="fs-3 fw-bold text-success mt-1">₹@Model.TotalRevenue.ToString("N0")</div>
                    <div class="small text-muted mt-1">From All Closed Orders</div>
                </div>
                <div class="p-3 bg-success-subtle text-success rounded-circle">
                    <i class="fa-solid fa-sack-dollar fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12">
        <div class="glass-card p-3 p-xl-4 h-100 border-start border-4 border-danger">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Total Expenses</div>
                    <div class="fs-3 fw-bold text-danger mt-1">₹@Model.TotalExpenses.ToString("N0")</div>
                    <div class="small text-muted mt-1">Salaries: ₹@Model.TotalSalariesPaid.ToString("N0")</div>
                </div>
                <div class="p-3 bg-danger-subtle text-danger rounded-circle">
                    <i class="fa-solid fa-arrow-trend-down fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12">
        <div class="glass-card p-3 p-xl-4 h-100 border-start border-4 border-warning">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Outstanding Advances</div>
                    <div class="fs-3 fw-bold text-warning mt-1">₹@Model.TotalAdvancesOutstanding.ToString("N0")</div>
                    <div class="small text-muted mt-1">Due from staff employees</div>
                </div>
                <div class="p-3 bg-warning-subtle text-warning rounded-circle">
                    <i class="fa-solid fa-receipt fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12">
        <div class="glass-card p-3 p-xl-4 h-100 border-start border-4 border-primary">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Net Operating Margin</div>
                    <div class="fs-3 fw-bold text-primary mt-1">₹@Model.NetOperatingBalance.ToString("N0")</div>
                    <div class="small text-muted mt-1">Cash Flow Balance</div>
                </div>
                <div class="p-3 bg-primary-subtle text-primary rounded-circle">
                    <i class="fa-solid fa-scale-balanced fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Tabs Navigation -->
<div class="glass-card p-4 animated-fade-in shadow-sm">
    <ul class="nav nav-pills mb-4 gap-2 border-bottom pb-3" id="accountTabs" role="tablist">
        <li class="nav-item">
            <a class="nav-link rounded-pill px-4 fw-bold @(activeTab == "ledger" ? "active bg-success text-white" : "text-dark bg-light")" 
               href="/Accounts?tab=ledger">
                <i class="fa-solid fa-address-book me-2"></i> Employee-wise Ledger & Advances
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-pill px-4 fw-bold @(activeTab == "payroll" ? "active bg-success text-white" : "text-dark bg-light")" 
               href="/Accounts?tab=payroll&month=@Model.SelectedMonth&year=@Model.SelectedYear">
                <i class="fa-solid fa-calculator me-2"></i> Attendance-Based Salary Issue
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-pill px-4 fw-bold @(activeTab == "expenses" ? "active bg-success text-white" : "text-dark bg-light")" 
               href="/Accounts?tab=expenses">
                <i class="fa-solid fa-wallet me-2"></i> Restaurant Expenses
            </a>
        </li>
    </ul>

    <!-- Tab 1: Employee-wise Ledger -->
    @if (activeTab == "ledger")
    {
        <div class="row g-4">
            <!-- Left Column: Employee Master Directory with Outstanding Balances -->
            <div class="col-lg-5">
                <div class="border rounded-4 p-3 bg-white shadow-sm h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-dark mb-0"><i class="fa-solid fa-users me-2 text-primary"></i>Staff Members</h6>
                        <span class="badge bg-secondary-subtle text-dark">@Model.EmployeeLedgers.Count registered</span>
                    </div>

                    <div class="list-group list-group-flush gap-2" style="max-height: 520px; overflow-y: auto;">
                        @foreach (var emp in Model.EmployeeLedgers)
                        {
                            bool isSelected = Model.SelectedEmployeeLedger?.EmployeeId == emp.EmployeeId;
                            <a href="/Accounts?tab=ledger&employeeId=@emp.EmployeeId" 
                               class="list-group-item list-group-item-action rounded-3 border p-3 @(isSelected ? "border-success bg-success-subtle shadow-sm" : "")">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="fw-bold text-dark fs-6">@emp.EmployeeName</div>
                                        <div class="small text-muted">@emp.Role &bull; ₹@emp.BaseSalary.ToString("N0")/mo</div>
                                    </div>
                                    <div class="text-end">
                                        @if (emp.OutstandingAdvance > 0)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2 py-1">
                                                ₹@emp.OutstandingAdvance.ToString("N0") Due
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
                                                Clear
                                            </span>
                                        }
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Column: Selected Employee Ledger Statement -->
            <div class="col-lg-7">
                @if (Model.SelectedEmployeeLedger != null)
                {
                    var sel = Model.SelectedEmployeeLedger;
                    <div class="border rounded-4 p-4 bg-white shadow-sm h-100">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 border-bottom pb-3">
                            <div>
                                <h5 class="fw-bold text-dark mb-1">
                                    <i class="fa-solid fa-user text-success me-2"></i>@sel.EmployeeName
                                </h5>
                                <div class="text-muted small">
                                    Role: <span class="fw-semibold text-dark">@sel.Role</span> &bull; 
                                    Phone: <span class="fw-semibold text-dark">@sel.Phone</span> &bull; 
                                    Base Salary: <span class="fw-semibold text-dark">₹@sel.BaseSalary.ToString("N0")</span>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3" 
                                        onclick="openGiveAdvanceFor('@sel.EmployeeId', '@sel.EmployeeName')">
                                    <i class="fa-solid fa-plus me-1"></i> Give Advance
                                </button>
                                <button class="btn btn-sm btn-outline-success rounded-pill px-3" 
                                        onclick="openCollectPaymentFor('@sel.EmployeeId', '@sel.EmployeeName', '@sel.OutstandingAdvance')">
                                    <i class="fa-solid fa-hand-holding-dollar me-1"></i> Collect
                                </button>
                            </div>
                        </div>

                        <!-- Mini KPI summary for this employee -->
                        <div class="row g-2 mb-3">
                            <div class="col-4">
                                <div class="p-2 bg-light rounded-3 text-center border">
                                    <div class="small text-muted">Total Advance</div>
                                    <div class="fw-bold text-dark">₹@sel.TotalAdvanceGiven.ToString("N0")</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 bg-light rounded-3 text-center border">
                                    <div class="small text-muted">Total Recovered</div>
                                    <div class="fw-bold text-success">₹@sel.TotalRepaidOrDeducted.ToString("N0")</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 rounded-3 text-center border @(sel.OutstandingAdvance > 0 ? "bg-warning-subtle text-warning-emphasis border-warning" : "bg-light text-muted")">
                                    <div class="small">Balance Due</div>
                                    <div class="fw-bold fs-6">₹@sel.OutstandingAdvance.ToString("N0")</div>
                                </div>
                            </div>
                        </div>

                        <!-- Ledger Transaction History Table -->
                        <div class="table-responsive" style="max-height: 420px; overflow-y: auto;">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light text-muted small text-uppercase">
                                    <tr>
                                        <th>Date</th>
                                        <th>Type</th>
                                        <th>Amount</th>
                                        <th>Mode</th>
                                        <th>Notes</th>
                                        <th class="text-end">Balance Due</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!sel.Transactions.Any())
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center py-4 text-muted small">
                                                No ledger transactions recorded yet. Click "Give Advance" to issue an advance.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var t in sel.Transactions)
                                        {
                                            string typeBadge = t.TransactionType switch
                                            {
                                                "Advance" => "bg-danger-subtle text-danger border border-danger-subtle",
                                                "Repayment" => "bg-success-subtle text-success border border-success-subtle",
                                                "SalaryDeduction" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
                                                "SalaryPayment" => "bg-info-subtle text-info border border-info-subtle",
                                                _ => "bg-secondary-subtle text-dark"
                                            };
                                            <tr>
                                                <td class="small fw-semibold">@t.TransactionDate.ToString("dd MMM yyyy")</td>
                                                <td><span class="badge rounded-pill @typeBadge" style="font-size:0.7rem;">@t.TransactionType</span></td>
                                                <td class="fw-bold @(t.TransactionType == "Advance" ? "text-danger" : "text-success")">
                                                    @(t.TransactionType == "Advance" ? "+" : "-")₹@t.Amount.ToString("N0")
                                                </td>
                                                <td class="small text-muted">@t.PaymentMethod</td>
                                                <td class="small text-truncate" style="max-width: 140px;" title="@t.Notes">@t.Notes</td>
                                                <td class="text-end fw-bold text-dark">₹@t.RunningBalance.ToString("N0")</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <div class="border rounded-4 p-5 text-center text-muted bg-white">
                        <i class="fa-solid fa-user-clock fs-2 d-block mb-2 opacity-50"></i>
                        <p class="mb-0">Select an employee from the directory on the left to view their detailed ledger.</p>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Tab 2: Attendance-Based Salary & Payroll -->
    @if (activeTab == "payroll")
    {
        <!-- Month & Year Selector -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 p-3 bg-light rounded-4 border">
            <div>
                <h6 class="fw-bold text-dark mb-0"><i class="fa-solid fa-calendar-check text-success me-2"></i>Select Payroll Month</h6>
                <div class="small text-muted">Salary is computed automatically based on Present, Half day (50%), Paid Leaves and Unpaid Absences</div>
            </div>
            <form method="get" action="/Accounts" class="d-flex align-items-center gap-2">
                <input type="hidden" name="tab" value="payroll" />
                <select name="month" class="form-select form-select-sm rounded-pill" style="width: 140px;">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == Model.SelectedMonth)">@(new DateTime(2026, m, 1).ToString("MMMM"))</option>
                    }
                </select>
                <select name="year" class="form-select form-select-sm rounded-pill" style="width: 100px;">
                    @for (int y = DateTime.UtcNow.Year; y >= DateTime.UtcNow.Year - 4; y--)
                    {
                        <option value="@y" selected="@(y == Model.SelectedYear)">@y</option>
                    }
                </select>
                <button type="submit" class="btn btn-sm btn-dark rounded-pill px-3"><i class="fa-solid fa-arrows-rotate me-1"></i> Calculate</button>
            </form>
        </div>

        <!-- Payroll Calculation Table -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th>Employee</th>
                        <th>Base Salary</th>
                        <th class="text-center" title="Days in month">Total Days</th>
                        <th class="text-center text-success" title="Present (100%)">Present</th>
                        <th class="text-center text-warning" title="Half day (50%)">Half Day</th>
                        <th class="text-center text-info" title="Approved paid leave">Paid Leave</th>
                        <th class="text-center text-danger" title="Unpaid absence">Unpaid</th>
                        <th class="text-end">Daily Rate</th>
                        <th class="text-end">Gross Earned</th>
                        <th class="text-end text-warning">Advance Due</th>
                        <th class="text-end text-success">Net Payable</th>
                        <th class="text-center">Status</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.PayrollRecords)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@p.EmployeeName</div>
                                <div class="small text-muted">@p.Role</div>
                            </td>
                            <td class="fw-semibold text-dark">₹@p.BaseSalary.ToString("N0")</td>
                            <td class="text-center small text-muted">@p.TotalDaysInMonth</td>
                            <td class="text-center"><span class="badge bg-success-subtle text-success rounded-pill px-2">@p.PresentDays</span></td>
                            <td class="text-center"><span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2">@p.HalfDays</span></td>
                            <td class="text-center"><span class="badge bg-info-subtle text-info rounded-pill px-2">@p.PaidLeaveDays</span></td>
                            <td class="text-center"><span class="badge bg-danger-subtle text-danger rounded-pill px-2">@p.UnpaidLeaveDays</span></td>
                            <td class="text-end small text-muted">₹@p.DailyRate.ToString("N0")</td>
                            <td class="text-end fw-bold text-dark">₹@p.GrossSalary.ToString("N0")</td>
                            <td class="text-end text-warning fw-semibold">₹@p.OutstandingAdvance.ToString("N0")</td>
                            <td class="text-end fw-bold text-success fs-6">₹@p.NetSalary.ToString("N0")</td>
                            <td class="text-center">
                                @if (p.IsPaid)
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-1"><i class="fa-solid fa-check me-1"></i> Paid</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-dark border rounded-pill px-3 py-1">Pending</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (p.IsPaid)
                                {
                                    <a href="/Accounts/SalarySlip?employeeId=@p.EmployeeId&month=@p.Month&year=@p.Year" 
                                       target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-2" title="Print Salary Slip">
                                        <i class="fa-solid fa-receipt me-1"></i> Slip
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-success rounded-pill px-3 shadow-sm"
                                            onclick="openDisburseSalaryModal('@p.EmployeeId', '@p.EmployeeName', '@p.BaseSalary', '@p.GrossSalary', '@p.OutstandingAdvance', '@p.AdvanceDeduction', '@p.NetSalary', '@p.Month', '@p.Year')">
                                        <i class="fa-solid fa-hand-holding-dollar me-1"></i> Issue
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- Tab 3: Restaurant Expenses -->
    @if (activeTab == "expenses")
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0"><i class="fa-solid fa-wallet text-danger me-2"></i>Operational Expenses</h5>
            <button class="btn btn-sm btn-danger rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#addExpenseModal">
                <i class="fa-solid fa-plus me-1"></i> Log Expense
            </button>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Logged By</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Expenses.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted small">No expenses logged.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var exp in Model.Expenses)
                        {
                            <tr>
                                <td class="small fw-semibold">@exp.ExpenseDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                <td><span class="badge bg-secondary-subtle text-dark rounded-pill px-3 py-1">@exp.Category</span></td>
                                <td class="text-dark">@exp.Description</td>
                                <td class="small text-muted">@exp.RecordedBy</td>
                                <td class="text-end fw-bold text-danger fs-6">₹@exp.Amount.ToString("N0")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal 1: Give Advance Pay -->
<div class="modal fade" id="giveAdvanceModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="GiveAdvance" method="post" class="modal-content rounded-4 border-0 shadow-lg text-start">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-hand-holding-dollar text-primary me-2"></i>Give Advance Payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold small">Select Employee</label>
                    <select name="EmployeeId" id="advEmployeeId" class="form-select" required>
                        @foreach (var emp in Model.EmployeeLedgers)
                        {
                            <option value="@emp.EmployeeId">@emp.EmployeeName (@emp.Role) - Base: ₹@emp.BaseSalary.ToString("N0")</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Advance Amount (₹)</label>
                    <input type="number" step="100" min="100" name="Amount" class="form-control" placeholder="e.g. 5000" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Payment Method</label>
                    <select name="PaymentMethod" class="form-select">
                        <option value="Cash">Cash</option>
                        <option value="UPI">UPI / QR</option>
                        <option value="Bank Transfer">Bank Transfer / NEFT</option>
                        <option value="Cheque">Cheque</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Reference # (Optional)</label>
                    <input type="text" name="ReferenceNumber" class="form-control" placeholder="e.g. UPI-99823 or Cheque #" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Reason / Notes</label>
                    <textarea name="Notes" class="form-control" rows="2" placeholder="e.g. Medical emergency advance requested by employee"></textarea>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary rounded-pill px-4">Disburse Advance</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal 2: Collect Advance Repayment -->
<div class="modal fade" id="collectPaymentModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="CollectAdvancePayment" method="post" class="modal-content rounded-4 border-0 shadow-lg text-start">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-money-bill-transfer text-success me-2"></i>Collect Advance Repayment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold small">Select Employee</label>
                    <select name="EmployeeId" id="repEmployeeId" class="form-select" required>
                        @foreach (var emp in Model.EmployeeLedgers)
                        {
                            <option value="@emp.EmployeeId">@emp.EmployeeName - Current Due: ₹@emp.OutstandingAdvance.ToString("N0")</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Repayment Amount (₹)</label>
                    <input type="number" step="100" min="50" name="Amount" id="repAmount" class="form-control" placeholder="e.g. 1000" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Payment Method</label>
                    <select name="PaymentMethod" class="form-select">
                        <option value="Cash">Cash</option>
                        <option value="UPI">UPI / QR</option>
                        <option value="Bank Transfer">Bank Transfer</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Reference # (Optional)</label>
                    <input type="text" name="ReferenceNumber" class="form-control" placeholder="e.g. Cash Receipt #" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Notes</label>
                    <textarea name="Notes" class="form-control" rows="2" placeholder="e.g. Employee returned cash repayment"></textarea>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-success rounded-pill px-4">Record Collection</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal 3: Issue Attendance-Based Salary -->
<div class="modal fade" id="disburseSalaryModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="DisburseSalary" method="post" class="modal-content rounded-4 border-0 shadow-lg text-start">
            <input type="hidden" name="EmployeeId" id="salEmployeeId" />
            <input type="hidden" name="Month" id="salMonth" />
            <input type="hidden" name="Year" id="salYear" />
            
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-calculator text-success me-2"></i>Issue Attendance Salary</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="p-3 bg-light rounded-4 mb-3 border">
                    <div class="fw-bold fs-6 text-dark" id="salEmpName">Amit Kumar</div>
                    <div class="small text-muted" id="salPeriodLabel">Month: October 2026</div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small fw-bold">Gross Earned (₹)</label>
                        <input type="text" id="salGross" class="form-control bg-light fw-bold text-dark" readonly />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-bold text-warning">Advance Due (₹)</label>
                        <input type="text" id="salAdvDue" class="form-control bg-light text-warning-emphasis fw-bold" readonly />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold small text-danger">Advance Deduction for this Month (₹)</label>
                    <input type="number" step="100" min="0" name="AdvanceDeduction" id="salAdvDeduct" class="form-control" oninput="recalcSalaryModal()" />
                    <div class="form-text small">Amount to deduct from employee's outstanding advance.</div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small fw-bold">Other Deductions (₹)</label>
                        <input type="number" step="50" min="0" name="OtherDeductions" id="salOtherDeduct" value="0" class="form-control" oninput="recalcSalaryModal()" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-bold">Bonus / Incentives (₹)</label>
                        <input type="number" step="50" min="0" name="Bonus" id="salBonus" value="0" class="form-control" oninput="recalcSalaryModal()" />
                    </div>
                </div>

                <div class="p-3 bg-success-subtle rounded-3 text-center border border-success-subtle mb-3">
                    <div class="small text-secondary fw-bold text-uppercase">Net Salary Payable</div>
                    <div class="fs-3 fw-bold text-success" id="salNetPayable">₹0</div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold small">Disbursement Mode</label>
                    <select name="PaymentMethod" class="form-select">
                        <option value="Cash">Cash Payout</option>
                        <option value="Bank Transfer">Bank Transfer / NEFT</option>
                        <option value="UPI">UPI / QR</option>
                        <option value="Cheque">Cheque</option>
                    </select>
                </div>

                <div class="mb-2">
                    <label class="form-label fw-bold small">Notes (Optional)</label>
                    <input type="text" name="Notes" class="form-control" placeholder="e.g. Payout processed by manager" />
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-success rounded-pill px-4">Confirm & Issue Salary</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal 4: Add Operational Expense -->
<div class="modal fade" id="addExpenseModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="AddExpense" method="post" class="modal-content rounded-4 border-0 shadow-lg text-start">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-receipt text-danger me-2"></i>Log Expense</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold small">Expense Category</label>
                    <select name="Category" class="form-select">
                        <option value="Raw Materials / Grocery">Raw Materials / Grocery</option>
                        <option value="Vegetables & Dairy">Vegetables & Dairy</option>
                        <option value="Electricity / Power">Electricity / Power</option>
                        <option value="Cooking Gas (LPG)">Cooking Gas (LPG)</option>
                        <option value="Rent">Premises Rent</option>
                        <option value="Maintenance / Repairs">Maintenance / Repairs</option>
                        <option value="Packaging & Disposables">Packaging & Disposables</option>
                        <option value="Marketing / Promotion">Marketing / Promotion</option>
                        <option value="Other Operations">Other Operations</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Amount (₹)</label>
                    <input type="number" step="0.5" min="1" name="Amount" class="form-control" placeholder="e.g. 2500" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Description / Vendor</label>
                    <input type="text" name="Description" class="form-control" placeholder="e.g. Paid electricity bill via online portal" required />
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger rounded-pill px-4">Save Expense</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function openGiveAdvanceFor(empId, empName) {
        $('#advEmployeeId').val(empId);
        var modal = new bootstrap.Modal(document.getElementById('giveAdvanceModal'));
        modal.show();
    }

    function openCollectPaymentFor(empId, empName, dueAmt) {
        $('#repEmployeeId').val(empId);
        if (dueAmt && dueAmt > 0) {
            $('#repAmount').val(dueAmt);
        }
        var modal = new bootstrap.Modal(document.getElementById('collectPaymentModal'));
        modal.show();
    }

    let currentGross = 0;
    function openDisburseSalaryModal(empId, empName, baseSalary, grossSalary, advanceDue, defaultDeduct, netSalary, month, year) {
        $('#salEmployeeId').val(empId);
        $('#salMonth').val(month);
        $('#salYear').val(year);
        $('#salEmpName').text(empName);
        $('#salPeriodLabel').text(`Month: ${month}/${year} (Base: ₹${baseSalary})`);
        currentGross = parseFloat(grossSalary) || 0;
        $('#salGross').val('₹' + currentGross.toFixed(0));
        $('#salAdvDue').val('₹' + (parseFloat(advanceDue) || 0).toFixed(0));
        $('#salAdvDeduct').val(defaultDeduct || 0);
        $('#salOtherDeduct').val(0);
        $('#salBonus').val(0);
        recalcSalaryModal();

        var modal = new bootstrap.Modal(document.getElementById('disburseSalaryModal'));
        modal.show();
    }

    function recalcSalaryModal() {
        let advDeduct = parseFloat($('#salAdvDeduct').val()) || 0;
        let otherDeduct = parseFloat($('#salOtherDeduct').val()) || 0;
        let bonus = parseFloat($('#salBonus').val()) || 0;
        let net = Math.max(0, currentGross - advDeduct - otherDeduct + bonus);
        $('#salNetPayable').text('₹' + net.toFixed(0));
    }
</script>
}
