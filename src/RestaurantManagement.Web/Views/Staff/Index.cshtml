@model StaffViewModel
@{
    ViewData["Title"] = "Staff & Attendance";
}

<!-- Breadcrumb & Top Bar -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 animated-fade-in">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 fs-6">
                <li class="breadcrumb-item">
                    <a href="/Dashboard" class="text-decoration-none fw-semibold text-success" data-bs-toggle="tooltip" title="Return to Dashboard">
                        <i class="fa-solid fa-chart-pie me-1"></i> Dashboard
                    </a>
                </li>
                <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">
                    <i class="fa-solid fa-user-group text-primary me-1"></i> Staff & Attendance
                </li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-user-group text-primary me-2"></i>Staff & Attendance Management
        </h2>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a href="/Dashboard" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm" data-bs-toggle="tooltip" title="Back to Dashboard">
            <i class="fa-solid fa-arrow-left me-1"></i> Dashboard
        </a>
        <form asp-action="MarkAllPresent" method="post" class="d-inline" onsubmit="return confirm('Mark all unmarked active staff members as Present for today?');">
            <button type="submit" class="btn btn-success rounded-pill px-3 shadow-sm fw-bold">
                <i class="fa-solid fa-bolt me-1"></i> Mark All Present
            </button>
        </form>
        <button class="btn btn-outline-success rounded-pill px-3 shadow-sm fw-bold" data-bs-toggle="modal" data-bs-target="#markAttendanceModal">
            <i class="fa-solid fa-clock me-1"></i> Custom Check-In
        </button>
        <button class="btn btn-primary rounded-pill px-3 shadow-sm fw-bold" data-bs-toggle="modal" data-bs-target="#addEmployeeModal">
            <i class="fa-solid fa-user-plus me-1"></i> Add Employee
        </button>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- KPI Cards -->
<div class="row g-3 mb-4 animated-fade-in">
    <div class="col-xl-3 col-sm-6">
        <div class="metric-card-clean metric-card-sales-border">
            <div class="d-flex justify-content-between align-items-center">
                <span class="metric-label metric-label-bold">TOTAL REGISTERED</span>
                <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle fw-bold">Active</span>
            </div>
            <div class="metric-value-bold mt-1">@Model.TotalStaffCount</div>
            <div class="metric-desc-bold mt-1">All restaurant personnel</div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="metric-card-clean metric-card-orders-border">
            <div class="d-flex justify-content-between align-items-center">
                <span class="metric-label metric-label-bold">ON DUTY TODAY</span>
                <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle fw-bold">Present</span>
            </div>
            <div class="metric-value-bold mt-1">@Model.PresentStaffCount</div>
            <div class="metric-desc-bold mt-1">Checked in & working</div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="metric-card-clean metric-card-tables-border">
            <div class="d-flex justify-content-between align-items-center">
                <span class="metric-label metric-label-bold">ON LEAVE / OFF</span>
                <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle fw-bold">Leave</span>
            </div>
            <div class="metric-value-bold mt-1">@Model.OnLeaveCount</div>
            <div class="metric-desc-bold mt-1">Approved time-off</div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="metric-card-clean metric-card-completed-border">
            <div class="d-flex justify-content-between align-items-center">
                <span class="metric-label metric-label-bold">TOTAL ROLES</span>
                <span class="badge rounded-pill bg-purple-subtle text-purple border fw-bold" style="background:#f3e8ff; color:#7e22ce;">Roles</span>
            </div>
            <div class="metric-value-bold mt-1">@Model.Employees.Select(e => e.Role).Distinct().Count()</div>
            <div class="metric-desc-bold mt-1">Managers, Chefs, Waiters, Staff</div>
        </div>
    </div>
</div>

<!-- Navigation Tabs -->
<div class="glass-card mb-4 animated-fade-in p-0 overflow-hidden">
    <div class="masters-nav-tabs">
        <a href="/Staff?tab=attendance" class="masters-nav-tab-btn @(Model.ActiveTab == "attendance" ? "active" : "")">
            <i class="fa-solid fa-calendar-check me-1"></i> Today's Attendance (@Model.Attendances.Count())
        </a>
        <a href="/Staff?tab=leaves" class="masters-nav-tab-btn @(Model.ActiveTab == "leaves" ? "active" : "")">
            <i class="fa-solid fa-plane-departure me-1"></i> Leave Management (@Model.LeaveRequests.Count())
        </a>
        <a href="/Staff?tab=staff" class="masters-nav-tab-btn @(Model.ActiveTab == "staff" ? "active" : "")">
            <i class="fa-solid fa-users me-1"></i> Staff Directory (@Model.Employees.Count())
        </a>
    </div>

    <div class="p-4">
        @if (Model.ActiveTab == "attendance")
        {
            var activeEmployees = Model.Employees.Where(e => e.IsActive).OrderBy(e => e.Name).ToList();
            var attMap = Model.Attendances.ToDictionary(a => a.EmployeeId);
            int presentCount = activeEmployees.Count(e => attMap.TryGetValue(e.Id, out var a) && (a.Status == "Present" || a.Status == "Late"));
            int unmarkedCount = activeEmployees.Count(e => !attMap.ContainsKey(e.Id));
            int leaveCount = activeEmployees.Count(e => attMap.TryGetValue(e.Id, out var a) && (a.Status == "Leave" || a.Status == "Half day"));
            int checkedOutCount = activeEmployees.Count(e => attMap.TryGetValue(e.Id, out var a) && a.Status == "Checked Out");

            <!-- Attendance Controls & Stats Header -->
            <div class="row g-3 align-items-center mb-3">
                <div class="col-md-6">
                    <h5 class="fw-bold text-dark mb-1">
                        <i class="fa-solid fa-clipboard-user text-success me-2"></i>Daily Attendance Register
                    </h5>
                    <div class="text-muted small">
                        <span><i class="fa-regular fa-calendar me-1"></i>@DateTime.Now.ToString("dddd, dd MMMM yyyy")</span>
                        <span class="mx-2">&bull;</span>
                        <span>Shift Grace: 10 mins (IST)</span>
                    </div>
                </div>
                <div class="col-md-6 d-flex justify-content-md-end gap-2">
                    <div class="input-group input-group-sm" style="max-width: 260px;">
                        <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                        <input type="text" id="attSearch" class="form-control border-start-0" placeholder="Search staff name or role..." onkeyup="filterAttendanceTable()" />
                    </div>
                </div>
            </div>

            <!-- Quick Filter Badges -->
            <div class="d-flex flex-wrap gap-2 mb-3 pb-2 border-bottom">
                <button type="button" class="btn btn-sm btn-dark rounded-pill px-3 py-1 att-filter-btn active" onclick="filterByStatus('all', this)">
                    All Active (@activeEmployees.Count)
                </button>
                <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 att-filter-btn" onclick="filterByStatus('present', this)">
                    <i class="fa-solid fa-circle-check me-1"></i> Present (@presentCount)
                </button>
                <button type="button" class="btn btn-sm btn-outline-warning rounded-pill px-3 py-1 att-filter-btn" onclick="filterByStatus('unmarked', this)">
                    <i class="fa-solid fa-clock me-1"></i> Not Marked (@unmarkedCount)
                </button>
                <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-3 py-1 att-filter-btn" onclick="filterByStatus('leave', this)">
                    <i class="fa-solid fa-calendar-xmark me-1"></i> Leave / Half Day (@leaveCount)
                </button>
                @if (checkedOutCount > 0)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 att-filter-btn" onclick="filterByStatus('checkedout', this)">
                        <i class="fa-solid fa-right-from-bracket me-1"></i> Checked Out (@checkedOutCount)
                    </button>
                }
            </div>

            <!-- Attendance Data Table -->
            <div class="table-responsive">
                <table class="table app-datagrid align-middle mb-0" id="attendanceTable">
                    <thead>
                        <tr>
                            <th>Staff Member</th>
                            <th>Role & Shift</th>
                            <th>Today's Status</th>
                            <th>Check-In</th>
                            <th>Check-Out</th>
                            <th class="text-end">Quick Action / Change</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!activeEmployees.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-users-slash fs-2 mb-2 text-secondary opacity-50"></i>
                                    <p class="mb-0 fw-semibold">No active staff registered.</p>
                                    <span class="small">Click "Add Employee" to register staff.</span>
                                </td>
                            </tr>
                        }
                        @foreach (var emp in activeEmployees)
                        {
                            bool hasAtt = attMap.TryGetValue(emp.Id, out var att);
                            string currentStatus = hasAtt ? (att!.Status ?? "Present") : "Not Marked";
                            string filterCategory = hasAtt 
                                ? (att!.Status == "Present" || att!.Status == "Late" ? "present" : (att!.Status == "Checked Out" ? "checkedout" : "leave"))
                                : "unmarked";

                            string statusBadge = currentStatus switch {
                                "Present" => "background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0;",
                                "Late" => "background: #fef3c7; color: #b45309; border: 1px solid #fde68a;",
                                "Checked Out" => "background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0;",
                                "Leave" => "background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca;",
                                "Half day" => "background: #f3e8ff; color: #7e22ce; border: 1px solid #e9d5ff;",
                                _ => "background: #fffbeb; color: #d97706; border: 1px solid #fde68a;"
                            };

                            <tr class="attendance-row" data-status="@filterCategory" data-name="@emp.Name.ToLower()" data-role="@emp.Role.ToString().ToLower()">
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" style="width: 38px; height: 38px; font-size: 0.85rem; background: linear-gradient(135deg, #059669, #10b981);">
                                            @(emp.Name.Length > 0 ? emp.Name.Substring(0, 1).ToUpper() : "S")
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@emp.Name</div>
                                            <div class="small text-muted"><i class="fa-solid fa-phone me-1"></i>@(emp.Phone ?? "—")</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border rounded-pill px-3 py-1 fw-semibold">@emp.Role</span>
                                    <span class="small text-secondary ms-1">(@emp.Shift)</span>
                                </td>
                                <td>
                                    <span class="badge rounded-pill px-3 py-1 fw-bold" style="@statusBadge font-size: 0.78rem;">
                                        @if (currentStatus == "Present") { <i class="fa-solid fa-circle-check me-1"></i> }
                                        else if (currentStatus == "Late") { <i class="fa-solid fa-triangle-exclamation me-1"></i> }
                                        else if (currentStatus == "Not Marked") { <i class="fa-solid fa-hourglass-start me-1"></i> }
                                        else if (currentStatus == "Checked Out") { <i class="fa-solid fa-arrow-right-from-bracket me-1"></i> }
                                        @currentStatus
                                    </span>
                                </td>
                                <td class="fw-semibold text-dark small">
                                    @(hasAtt && att!.CheckInTime != default ? att.CheckInTime.ToLocalTime().ToString("hh:mm tt") : "—")
                                </td>
                                <td class="fw-semibold text-secondary small">
                                    @(hasAtt && att!.CheckOutTime.HasValue ? att.CheckOutTime.Value.ToLocalTime().ToString("hh:mm tt") : "—")
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        @if (!hasAtt || currentStatus == "Not Marked")
                                        {
                                            <form asp-action="QuickMark" method="post" class="d-inline">
                                                <input type="hidden" name="employeeId" value="@emp.Id" />
                                                <input type="hidden" name="status" value="Present" />
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-2 py-1 fw-semibold" title="Mark Present">
                                                    <i class="fa-solid fa-check"></i> Present
                                                </button>
                                            </form>
                                            <form asp-action="QuickMark" method="post" class="d-inline">
                                                <input type="hidden" name="employeeId" value="@emp.Id" />
                                                <input type="hidden" name="status" value="Late" />
                                                <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill px-2 py-1" title="Mark Late">
                                                    Late
                                                </button>
                                            </form>
                                            <form asp-action="QuickMark" method="post" class="d-inline">
                                                <input type="hidden" name="employeeId" value="@emp.Id" />
                                                <input type="hidden" name="status" value="Leave" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1" title="Mark Leave">
                                                    Leave
                                                </button>
                                            </form>
                                        }
                                        else if (currentStatus == "Checked Out")
                                        {
                                            <span class="badge bg-light text-muted border rounded-pill px-3 py-1">Shift Ended</span>
                                            <form asp-action="QuickMark" method="post" class="d-inline">
                                                <input type="hidden" name="employeeId" value="@emp.Id" />
                                                <input type="hidden" name="status" value="Present" />
                                                <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-2 py-1" title="Reopen Shift">
                                                    Reopen
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <!-- Currently Active on shift -->
                                            <form asp-action="CheckOut" method="post" class="d-inline">
                                                <input type="hidden" name="employeeId" value="@emp.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1 fw-semibold" title="Clock out employee">
                                                    <i class="fa-solid fa-right-from-bracket me-1"></i> Clock Out
                                                </button>
                                            </form>
                                            <div class="dropdown d-inline">
                                                <button class="btn btn-sm btn-light border rounded-pill px-2 py-1 dropdown-toggle" type="button" data-bs-toggle="dropdown" title="Change status">
                                                    Edit
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                    <li>
                                                        <form asp-action="QuickMark" method="post">
                                                            <input type="hidden" name="employeeId" value="@emp.Id" />
                                                            <input type="hidden" name="status" value="Present" />
                                                            <button type="submit" class="dropdown-item small text-success"><i class="fa-solid fa-check me-2"></i> Present</button>
                                                        </form>
                                                    </li>
                                                    <li>
                                                        <form asp-action="QuickMark" method="post">
                                                            <input type="hidden" name="employeeId" value="@emp.Id" />
                                                            <input type="hidden" name="status" value="Late" />
                                                            <button type="submit" class="dropdown-item small text-warning"><i class="fa-solid fa-clock me-2"></i> Late</button>
                                                        </form>
                                                    </li>
                                                    <li>
                                                        <form asp-action="QuickMark" method="post">
                                                            <input type="hidden" name="employeeId" value="@emp.Id" />
                                                            <input type="hidden" name="status" value="Half day" />
                                                            <button type="submit" class="dropdown-item small text-purple"><i class="fa-solid fa-adjust me-2"></i> Half Day</button>
                                                        </form>
                                                    </li>
                                                    <li>
                                                        <form asp-action="QuickMark" method="post">
                                                            <input type="hidden" name="employeeId" value="@emp.Id" />
                                                            <input type="hidden" name="status" value="Leave" />
                                                            <button type="submit" class="dropdown-item small text-danger"><i class="fa-solid fa-calendar-xmark me-2"></i> Leave</button>
                                                        </form>
                                                    </li>
                                                </ul>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (Model.ActiveTab == "leaves")
        {
            <!-- Leave Management Section -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <div>
                    <h5 class="fw-bold text-dark mb-1"><i class="fa-solid fa-plane-departure text-warning me-2"></i>Staff Leave & Time-Off Management</h5>
                    <div class="text-muted small">Submit, approve, or reject staff leaves. Approved leaves synchronize with attendance and payroll calculations.</div>
                </div>
                <div>
                    <button class="btn btn-warning rounded-pill px-4 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#applyLeaveModal">
                        <i class="fa-solid fa-plus me-1"></i> Apply Leave
                    </button>
                </div>
            </div>

            <!-- Leave Stats Row -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded-4 border">
                        <div class="text-secondary small fw-bold text-uppercase">Total Requests</div>
                        <div class="fs-4 fw-bold text-dark mt-1">@Model.LeaveRequests.Count()</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded-4 border">
                        <div class="text-secondary small fw-bold text-uppercase">Pending Approval</div>
                        <div class="fs-4 fw-bold text-warning-emphasis mt-1">@Model.LeaveRequests.Count(l => l.Status == "Pending")</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded-4 border">
                        <div class="text-secondary small fw-bold text-uppercase">Approved</div>
                        <div class="fs-4 fw-bold text-success mt-1">@Model.LeaveRequests.Count(l => l.Status == "Approved")</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded-4 border">
                        <div class="text-secondary small fw-bold text-uppercase">Rejected</div>
                        <div class="fs-4 fw-bold text-danger mt-1">@Model.LeaveRequests.Count(l => l.Status == "Rejected")</div>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table app-datagrid align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Leave Period</th>
                            <th>Duration</th>
                            <th>Leave Type</th>
                            <th>Reason</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.LeaveRequests.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-calendar-check fs-2 mb-2 text-secondary opacity-50"></i>
                                    <p class="mb-0 fw-semibold">No leave applications found.</p>
                                    <span class="small">Click "Apply Leave" to record a leave application.</span>
                                </td>
                            </tr>
                        }
                        @foreach (var l in Model.LeaveRequests.OrderByDescending(r => r.CreatedAt))
                        {
                            int duration = Math.Max(1, (int)(l.EndDate.Date - l.StartDate.Date).TotalDays + 1);
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@l.EmployeeName</div>
                                    <div class="small text-muted">@l.Role</div>
                                </td>
                                <td>
                                    <div class="small fw-semibold text-dark">@l.StartDate.ToString("dd MMM yyyy") &rarr; @l.EndDate.ToString("dd MMM yyyy")</div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-dark border rounded-pill px-2 py-1">@duration day@(duration > 1 ? "s" : "")</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-primary border rounded-pill px-3 py-1">@l.LeaveType</span>
                                </td>
                                <td class="small text-muted" style="max-width: 250px;">
                                    <div>@l.Reason</div>
                                    @if (!string.IsNullOrEmpty(l.RejectionReason))
                                    {
                                        <div class="text-danger small fst-italic mt-1">&bull; Rejection: @l.RejectionReason</div>
                                    }
                                </td>
                                <td>
                                    @if (l.Status == "Pending")
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1">Pending</span>
                                    }
                                    else if (l.Status == "Approved")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                            <i class="fa-solid fa-check me-1"></i>Approved (@l.ApprovedBy)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">Rejected</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (l.Status == "Pending")
                                    {
                                        <div class="d-inline-flex gap-1">
                                            <form asp-action="ApproveLeave" method="post" class="d-inline" onsubmit="return confirm('Approve leave for @l.EmployeeName?');">
                                                <input type="hidden" name="id" value="@l.Id" />
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 py-1">
                                                    <i class="fa-solid fa-check me-1"></i>Approve
                                                </button>
                                            </form>
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1" onclick="openRejectModal(@l.Id, '@l.EmployeeName')">
                                                <i class="fa-solid fa-xmark me-1"></i>Reject
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="small text-muted">&mdash;</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <!-- Staff Directory Section -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0"><i class="fa-solid fa-address-book text-primary me-2"></i>Active Restaurant Staff Members</h5>
                <button class="btn btn-sm btn-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#addEmployeeModal">
                    <i class="fa-solid fa-plus me-1"></i> Add Employee
                </button>
            </div>

            <div class="table-responsive">
                <table class="table app-datagrid align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Employee Name</th>
                            <th>Role</th>
                            <th>Shift</th>
                            <th>Mobile</th>
                            <th>Email</th>
                            <th>Monthly Base</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in Model.Employees)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@emp.Name</div>
                                    <div class="small text-muted">EMP-@emp.Id.ToString("D4")</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border rounded-pill px-3 py-1">@emp.Role</span>
                                </td>
                                <td class="small fw-semibold text-secondary">@emp.Shift</td>
                                <td class="small text-dark fw-bold">@emp.Phone</td>
                                <td class="small text-secondary">@(string.IsNullOrEmpty(emp.Email) ? "—" : emp.Email)</td>
                                <td class="fw-bold text-dark">₹@emp.BaseSalary.ToString("N0")</td>
                                <td>
                                    @if (emp.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-3 py-1">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a href="/Accounts?tab=ledger&employeeId=@emp.Id" class="btn btn-sm btn-outline-success rounded-pill px-2 me-1" title="View Ledger & Advances">
                                        <i class="fa-solid fa-receipt me-1"></i>Ledger
                                    </a>
                                    <form asp-action="DeleteEmployee" method="post" class="d-inline" onsubmit="return confirm('Remove employee @emp.Name?');">
                                        <input type="hidden" name="id" value="@emp.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle p-1" style="width: 32px; height: 32px;" title="Delete Employee">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal: Mark Attendance -->
<div class="modal fade" id="markAttendanceModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="CheckIn" method="post" class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-clock text-success me-2"></i>Mark Attendance / Check-In</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label text-dark fw-bold small">Select Employee</label>
                    <select name="employeeId" class="form-select" required>
                        @foreach (var emp in Model.Employees.Where(e => e.IsActive))
                        {
                            <option value="@emp.Id">@emp.Name (@emp.Role - @emp.Shift)</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label text-dark fw-bold small">Status</label>
                    <select name="status" class="form-select">
                        <option value="Present">Present (On Duty)</option>
                        <option value="Late">Late Check-In</option>
                        <option value="Half day">Half Day</option>
                        <option value="Leave">On Leave</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">Record Attendance</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Add Employee -->
<div class="modal fade" id="addEmployeeModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="CreateEmployee" method="post" class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-user-plus text-primary me-2"></i>Add Staff Member</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label text-dark fw-bold small">Full Name <span class="text-danger">*</span></label>
                    <input type="text" name="Name" class="form-control" placeholder="e.g. Ramesh Rathore" required minlength="2" maxlength="50" />
                </div>
                <div class="mb-3">
                    <label class="form-label text-dark fw-bold small">Role <span class="text-danger">*</span></label>
                    <select name="Role" class="form-select" required>
                        <option value="Waiter">Waiter / Captain</option>
                        <option value="Cook">Chef / Cook</option>
                        <option value="Cashier">Cashier</option>
                        <option value="Manager">Manager</option>
                        <option value="Housekeeping">Housekeeping</option>
                        <option value="KitchenStaff">Kitchen Staff</option>
                    </select>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label text-dark fw-bold small">Mobile (10 Digits) <span class="text-danger">*</span></label>
                        <input type="tel" name="Phone" class="form-control" placeholder="9876500000" pattern="[6-9][0-9]{9}" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label text-dark fw-bold small">Shift</label>
                        <select name="Shift" class="form-select">
                            <option value="Morning">Morning</option>
                            <option value="Evening">Evening</option>
                            <option value="General">General / Full Day</option>
                        </select>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label text-dark fw-bold small">Email Address</label>
                    <input type="email" name="Email" class="form-control" placeholder="name@giranagarden.com" />
                </div>
                <div class="mb-3">
                    <label class="form-label text-dark fw-bold small">Monthly Base Salary (₹)</label>
                    <input type="number" step="100" name="BaseSalary" class="form-control" placeholder="e.g. 18000" />
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Register Employee</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Apply Leave -->
<div class="modal fade" id="applyLeaveModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="ApplyLeave" method="post" class="modal-content rounded-4 border-0 shadow-lg text-start">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-plane-departure text-warning me-2"></i>Apply Staff Leave</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label text-dark fw-bold small">Staff Member</label>
                    <select name="EmployeeId" class="form-select" required>
                        <option value="">-- Select Employee --</option>
                        @foreach (var emp in Model.Employees.Where(e => e.IsActive))
                        {
                            <option value="@emp.Id">@emp.Name (@emp.Role)</option>
                        }
                    </select>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label text-dark fw-bold small">From Date</label>
                        <input type="date" name="StartDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label text-dark fw-bold small">To Date</label>
                        <input type="date" name="EndDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label text-dark fw-bold small">Leave Type</label>
                    <select name="LeaveType" class="form-select">
                        <option value="Casual Leave">Casual Leave (CL)</option>
                        <option value="Sick Leave">Sick Leave (SL)</option>
                        <option value="Paid Leave">Paid Privilege Leave (PL)</option>
                        <option value="Unpaid Leave">Unpaid Absence (LWP)</option>
                        <option value="Half Day Leave">Half Day Leave</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label text-dark fw-bold small">Reason for Leave</label>
                    <textarea name="Reason" class="form-control" rows="2" placeholder="e.g. Family function / Medical reason" required></textarea>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold">Submit Application</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Reject Leave -->
<div class="modal fade" id="rejectLeaveModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="RejectLeave" method="post" class="modal-content rounded-4 border-0 shadow-lg text-start">
            <input type="hidden" name="id" id="rejectLeaveId" />
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-danger"><i class="fa-solid fa-ban text-danger me-2"></i>Reject Leave Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="p-3 bg-light rounded-4 mb-3 border">
                    <div class="small text-muted">Rejecting leave application for:</div>
                    <div class="fw-bold text-dark fs-6" id="rejectLeaveEmpName">Employee</div>
                </div>
                <div class="mb-3">
                    <label class="form-label text-dark fw-bold small">Reason for Rejection</label>
                    <textarea name="reason" class="form-control" rows="3" placeholder="e.g. Critical banquet shift / Insufficient staffing" required></textarea>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Confirm Rejection</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function openRejectModal(id, empName) {
        $('#rejectLeaveId').val(id);
        $('#rejectLeaveEmpName').text(empName);
        var modal = new bootstrap.Modal(document.getElementById('rejectLeaveModal'));
        modal.show();
    }
    let currentStatusFilter = 'all';

    function filterByStatus(status, btn) {
        currentStatusFilter = status;
        $('.att-filter-btn').removeClass('active btn-dark btn-success btn-warning btn-info btn-secondary')
                           .addClass('btn-outline-dark');
        $(btn).removeClass('btn-outline-dark').addClass('active btn-dark');
        applyAttendanceFilters();
    }

    function filterAttendanceTable() {
        applyAttendanceFilters();
    }

    function applyAttendanceFilters() {
        let q = ($('#attSearch').val() || '').toLowerCase().trim();
        $('.attendance-row').each(function() {
            let rowStatus = $(this).data('status');
            let rowName = $(this).data('name') || '';
            let rowRole = $(this).data('role') || '';

            let matchesStatus = (currentStatusFilter === 'all') || (rowStatus === currentStatusFilter);
            let matchesSearch = !q || rowName.includes(q) || rowRole.includes(q);

            $(this).toggle(matchesStatus && matchesSearch);
        });
    }
</script>
}
