<!DOCTYPE html>
<html lang="en">
@{
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    string displayName = isAuthenticated 
        ? (User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name ?? "Staff")
        : "Guest";
    string displayRole = isAuthenticated
        ? (User.FindFirst("RoleName")?.Value ?? User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Staff")
        : "Guest";

    bool isAdmin = User.IsInRole("Admin");
    bool isManager = User.IsInRole("Manager");
    bool isCashier = User.IsInRole("Cashier");
    bool isWaiter = User.IsInRole("Waiter");
    bool isKitchen = User.IsInRole("KitchenStaff") || User.IsInRole("Cook");
    bool isInventory = User.IsInRole("InventoryStaff");

    // Role-based navigation permissions
    bool canViewTables = isAdmin || isManager || isWaiter || isCashier;
    bool canTakeOrders = isAdmin || isManager || isWaiter || isCashier;
    bool canViewOrders = isAdmin || isManager || isWaiter || isCashier || isKitchen;
    bool canViewKitchen = isAdmin || isManager || isKitchen;
    bool canViewBilling = isAdmin || isManager || isCashier;
    bool canViewMenu = isAdmin || isManager || isWaiter || isCashier;
    bool canViewMasters = isAdmin || isManager;
    bool canViewInventory = isAdmin || isManager || isInventory;
    bool canViewStaff = isAdmin || isManager;
    bool canViewAccounts = isAdmin || isManager || isCashier;
    bool canViewReports = isAdmin || isManager || isCashier;
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Girana Garden Restaurant Management System</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <!-- Google Fonts: Outfit & Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="app-layout layout-collapsed" id="appLayout">
        <!-- Collapsible Vertical Sidebar Tabs -->
        <aside class="app-sidebar sidebar-collapsed" id="appSidebar">
            <!-- Sidebar Header / Brand -->
            <div class="sidebar-header">
                <a class="sidebar-brand" href="/" title="Girana Garden">
                    <div class="brand-logo-img" style="border-radius: 50% !important; background: #059669 !important; font-weight: 800; font-size: 1.25rem;">
                        G
                    </div>
                    <span class="brand-text luxury-brand-title">Girana Garden</span>
                </a>
                <button class="sidebar-toggle-btn" id="sidebarToggle" title="Expand Sidebar">
                    <i class="fa-solid fa-angles-right" id="toggleIcon"></i>
                </button>
            </div>

            <!-- Sidebar Vertical Navigation Tabs Based on Role -->
            <nav class="sidebar-nav">
                <div class="nav flex-column">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" href="/Dashboard" data-title="Dashboard" data-bs-toggle="tooltip" data-bs-placement="right" title="Dashboard">
                        <i class="fa-solid fa-chart-pie nav-icon" style="color: #10b981;"></i>
                        <span class="nav-text">Dashboard</span>
                    </a>

                    @if (canViewTables)
                    {
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tables" ? "active" : "")" href="/Tables" data-title="Tables & Floor" data-bs-toggle="tooltip" data-bs-placement="right" title="Tables & Floor">
                            <i class="fa-solid fa-chair nav-icon" style="color: #f59e0b;"></i>
                            <span class="nav-text">Tables & Floor</span>
                        </a>
                    }

                    @if (canTakeOrders)
                    {
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" && ViewContext.RouteData.Values["action"]?.ToString() == "POS" ? "active" : "")" href="/Orders/POS" data-title="New POS Order" data-bs-toggle="tooltip" data-bs-placement="right" title="New POS Order">
                            <i class="fa-solid fa-cash-register nav-icon" style="color: #6366f1;"></i>
                            <span class="nav-text">New POS Order</span>
                        </a>
                    }

                    @if (canViewOrders)
                    {
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" href="/Orders" data-title="All Orders" data-bs-toggle="tooltip" data-bs-placement="right" title="All Orders">
                            <i class="fa-solid fa-receipt nav-icon" style="color: #0284c7;"></i>
                            <span class="nav-text">All Orders</span>
                        </a>
                    }

                    @if (canViewKitchen)
                    {
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Kitchen" ? "active" : "")" href="/Kitchen" data-title="Kitchen KDS" data-bs-toggle="tooltip" data-bs-placement="right" title="Kitchen (KDS)">
                            <i class="fa-solid fa-kitchen-set nav-icon" style="color: #ef4444;"></i>
                            <span class="nav-text">Kitchen (KDS)</span>
                        </a>
                    }

                    @if (canViewBilling)
                    {
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Billing" ? "active" : "")" href="/Billing" data-title="Billing & Payments" data-bs-toggle="tooltip" data-bs-placement="right" title="Billing & Payments">
                            <i class="fa-solid fa-file-invoice-dollar nav-icon" style="color: #8b5cf6;"></i>
                            <span class="nav-text">Billing & Payments</span>
                        </a>
                    }

                    @if (canViewMenu)
                    {
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Menu" ? "active" : "")" href="/Menu" data-title="Menu Items" data-bs-toggle="tooltip" data-bs-placement="right" title="Menu Items">
                            <i class="fa-solid fa-bowl-food nav-icon" style="color: #0d9488;"></i>
                            <span class="nav-text">Menu Items</span>
                        </a>
                    }

                    @if (canViewMasters)
                    {
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Masters" ? "active" : "")" href="/Masters" data-title="Masters" data-bs-toggle="tooltip" data-bs-placement="right" title="Masters">
                            <i class="fa-solid fa-layer-group nav-icon" style="color: #ec4899;"></i>
                            <span class="nav-text">Masters</span>
                        </a>
                    }

                    @if (canViewInventory)
                    {
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Inventory" ? "active" : "")" href="/Inventory" data-title="Stock & Inventory" data-bs-toggle="tooltip" data-bs-placement="right" title="Stock & Inventory">
                            <i class="fa-solid fa-boxes-stacked nav-icon" style="color: #64748b;"></i>
                            <span class="nav-text">Stock</span>
                        </a>
                    }

                    @if (canViewStaff)
                    {
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Staff" ? "active" : "")" href="/Staff" data-title="Staff & Attendance" data-bs-toggle="tooltip" data-bs-placement="right" title="Staff & Attendance">
                            <i class="fa-solid fa-user-group nav-icon" style="color: #6366f1;"></i>
                            <span class="nav-text">Staff & Attendance</span>
                        </a>
                    }

                    @if (canViewAccounts)
                    {
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Accounts" ? "active" : "")" href="/Accounts" data-title="Accounts & Payroll" data-bs-toggle="tooltip" data-bs-placement="right" title="Accounts & Payroll">
                            <i class="fa-solid fa-file-invoice-dollar nav-icon" style="color: #059669;"></i>
                            <span class="nav-text">Accounts & Ledger</span>
                        </a>
                    }

                    @if (canViewReports)
                    {
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" href="/Reports" data-title="Reports & Analytics" data-bs-toggle="tooltip" data-bs-placement="right" title="Reports & Analytics">
                            <i class="fa-solid fa-chart-line nav-icon" style="color: #d97706;"></i>
                            <span class="nav-text">Reports</span>
                        </a>
                    }

                    <div class="sidebar-divider my-2 border-top border-light-subtle"></div>

                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" ? "active" : "")" href="/Account/Login?switchUser=true" data-title="Switch User" data-bs-toggle="tooltip" data-bs-placement="right" title="Switch User / Terminal">
                        <i class="fa-solid fa-arrows-rotate nav-icon" style="color: #059669;"></i>
                        <span class="nav-text">Switch User</span>
                    </a>

                    <a class="nav-link text-danger" href="/Account/Logout" onclick="window.location.href='/Account/Logout';" data-title="Sign Out" data-bs-toggle="tooltip" data-bs-placement="right" title="Sign Out">
                        <i class="fa-solid fa-right-from-bracket nav-icon text-danger"></i>
                        <span class="nav-text text-danger fw-semibold">Sign Out</span>
                    </a>
                </div>
            </nav>
        </aside>

        <!-- Main Content Area -->
        <div class="app-main">
            @if (ViewContext.RouteData.Values["controller"]?.ToString() != "Dashboard")
            {
                <!-- Top Header Navbar -->
                <header class="top-header sticky-top">
                    <div class="d-flex align-items-center justify-content-between w-100">
                        <div class="d-flex align-items-center gap-3">
                            <button class="btn btn-outline-secondary btn-sm rounded-circle d-md-none" id="mobileSidebarToggle">
                                <i class="fa-solid fa-bars"></i>
                            </button>
                            <a href="/" class="text-decoration-none d-flex align-items-center gap-2">
                                <i class="fa-solid fa-utensils text-success fs-4"></i>
                                <span class="luxury-brand-title">Girana Garden</span>
                            </a>
                        </div>
                        
                        <div class="d-flex align-items-center gap-3">
                            <!-- Live Date & Time Clock with Thin Border -->
                            <div class="live-clock-badge d-none d-md-flex" title="Current Local Time" style="border: 1.5px solid #cbd5e1;">
                                <i class="fa-regular fa-clock text-success"></i>
                                <span id="liveClockText">Loading...</span>
                            </div>

                            <!-- User & Role Dropdown -->
                            <div class="dropdown">
                                <button class="btn role-dropdown-btn btn-sm dropdown-toggle rounded-pill px-3 shadow-sm d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" title="Active User: @displayName">
                                    <i class="fa-solid fa-user-shield text-success"></i>
                                    <span>Role: <strong class="text-dark">@displayRole</strong></span>
                                </button>
                                <ul class="dropdown-menu role-dropdown-menu dropdown-menu-end shadow-lg" style="min-width: 210px; border-radius: 12px; border: 1.5px solid #cbd5e1;">
                                    <li class="px-3 py-2 border-bottom bg-light rounded-top">
                                        <div class="fw-bold text-dark small">@displayName</div>
                                        <div class="text-muted small" style="font-size: 0.72rem;">@displayRole &bull; Girana RMS</div>
                                    </li>
                                    <li><a class="dropdown-item @(displayRole == "Administrator" || displayRole == "Admin" ? "active" : "")" href="#"><i class="fa-solid fa-user-gear text-danger me-2"></i> Admin</a></li>
                                    <li><a class="dropdown-item @(displayRole.Contains("Manager") ? "active" : "")" href="#"><i class="fa-solid fa-briefcase text-success me-2"></i> Manager</a></li>
                                    <li><a class="dropdown-item @(displayRole.Contains("Cashier") ? "active" : "")" href="#"><i class="fa-solid fa-cash-register text-primary me-2"></i> Cashier</a></li>
                                    <li><a class="dropdown-item @(displayRole.Contains("Waiter") ? "active" : "")" href="#"><i class="fa-solid fa-tray text-warning me-2"></i> Waiter</a></li>
                                    <li><a class="dropdown-item @(displayRole.Contains("Kitchen") ? "active" : "")" href="#"><i class="fa-solid fa-kitchen-set text-info me-2"></i> Kitchen Staff</a></li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <a class="dropdown-item small" href="/Account/Login?switchUser=true">
                                            <i class="fa-solid fa-arrows-rotate text-secondary me-2"></i> Switch User / Terminal
                                        </a>
                                    </li>
                                    @if (isAuthenticated)
                                    {
                                        <li>
                                            <a class="dropdown-item small text-danger fw-semibold logout-link" href="/Account/Logout" onclick="window.location.href='/Account/Logout';">
                                                <i class="fa-solid fa-right-from-bracket me-2"></i> Sign Out
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <a class="dropdown-item small text-success fw-semibold" href="/Account/Login">
                                                <i class="fa-solid fa-right-to-bracket me-2"></i> Sign In
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                </header>
            }

            <!-- Main Body Container -->
            <main role="main" class="main-content py-4 px-4">
                @RenderBody()
            </main>

            <!-- Global Footer -->
            <footer class="app-footer text-center text-secondary py-3 border-top mt-auto" style="font-size: 0.85rem; background: #ffffff;">
                <div>Girana Garden Restaurant Management System &bull; Clean Architecture .NET 10 MVC + Web API</div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Live Clock Script
            function updateClock() {
                const now = new Date();
                const clockElem = document.getElementById('liveClockText');
                if (clockElem) {
                    const dateStr = now.toLocaleDateString('en-US', { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric' });
                    const timeStr = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true });
                    clockElem.textContent = `${dateStr}  |  ${timeStr}`;
                }
            }
            setInterval(updateClock, 1000);
            updateClock();

            // Collapsible Sidebar Script
            const sidebar = document.getElementById('appSidebar');
            const layout = document.getElementById('appLayout');
            const toggleBtn = document.getElementById('sidebarToggle');
            const toggleIcon = document.getElementById('toggleIcon');
            const mobileToggle = document.getElementById('mobileSidebarToggle');

            let isCollapsed = true;

            function updateSidebarState() {
                if (isCollapsed) {
                    sidebar.classList.add('sidebar-collapsed');
                    layout.classList.add('layout-collapsed');
                    if (toggleIcon) toggleIcon.className = 'fa-solid fa-angles-right';
                    if (toggleBtn) toggleBtn.setAttribute('title', 'Expand Sidebar');
                } else {
                    sidebar.classList.remove('sidebar-collapsed');
                    layout.classList.remove('layout-collapsed');
                    if (toggleIcon) toggleIcon.className = 'fa-solid fa-angles-left';
                    if (toggleBtn) toggleBtn.setAttribute('title', 'Collapse Sidebar');
                }
            }

            if (toggleBtn) {
                toggleBtn.addEventListener('click', function () {
                    isCollapsed = !isCollapsed;
                    updateSidebarState();
                });
            }

            if (mobileToggle) {
                mobileToggle.addEventListener('click', function () {
                    sidebar.classList.toggle('mobile-open');
                });
            }

            updateSidebarState();

            // Initialize all Bootstrap 5 tooltips across the application
            function initTooltips() {
                const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                tooltipTriggerList.map(function (tooltipTriggerEl) {
                    return new bootstrap.Tooltip(tooltipTriggerEl, { trigger: 'hover' });
                });
            }
            initTooltips();

            // Interactive Role Switcher
            document.addEventListener('click', function (e) {
                const item = e.target.closest('.role-dropdown-menu .dropdown-item');
                if (!item) return;

                const href = item.getAttribute('href');
                // Allow direct navigation for real URLs (e.g. /Account/Logout, /Account/Login)
                if (href && href !== '#' && !href.startsWith('javascript:')) {
                    return;
                }

                e.preventDefault();
                const dropdown = item.closest('.dropdown');
                if (dropdown) {
                    dropdown.querySelectorAll('.dropdown-item').forEach(function (el) {
                        el.classList.remove('active');
                        const icon = el.querySelector('i');
                        if (icon) {
                            icon.classList.remove('text-white');
                        }
                    });
                    item.classList.add('active');
                    const activeIcon = item.querySelector('i');
                    if (activeIcon) {
                        activeIcon.classList.add('text-white');
                    }
                    const roleBtnLabel = dropdown.querySelector('.role-dropdown-btn strong');
                    if (roleBtnLabel) {
                        roleBtnLabel.textContent = item.textContent.trim();
                    }
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
