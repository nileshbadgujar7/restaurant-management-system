@inject RestaurantManagement.Application.Interfaces.IUnitOfWork UnitOfWork
@{
    var appSettings = (await UnitOfWork.RestaurantSettings.GetAllAsync()).FirstOrDefault() ?? new RestaurantManagement.Domain.Entities.RestaurantSetting();
    string currentLang = Context.Request.Cookies["GiranaRMS.Language"] ?? "en";
    bool isMarathi = currentLang == "mr";
    string effectiveBrandName = (isMarathi && !string.IsNullOrWhiteSpace(appSettings.RestaurantNameMarathi))
        ? appSettings.RestaurantNameMarathi
        : appSettings.RestaurantName;
}
<!DOCTYPE html>
<html lang="@(isMarathi ? "mr" : "en")">
@{
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    string displayName = isAuthenticated 
        ? (User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name ?? "Staff")
        : "Guest";
    string displayRole = isAuthenticated
        ? (User.FindFirst("RoleName")?.Value ?? User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Staff")
        : "Guest";

    bool isAdmin = User.IsInRole("Admin");
    bool isManager = User.IsInRole("Manager");
    bool isCashier = User.IsInRole("Cashier");
    bool isWaiter = User.IsInRole("Waiter");
    bool isKitchen = User.IsInRole("KitchenStaff") || User.IsInRole("Cook");
    bool isInventory = User.IsInRole("InventoryStaff");

    // Role-based navigation permissions
    bool canViewTables = isAdmin || isManager || isWaiter || isCashier;
    bool canTakeOrders = isAdmin || isManager || isWaiter || isCashier;
    bool canViewOrders = isAdmin || isManager || isWaiter || isCashier || isKitchen;
    bool canViewKitchen = isAdmin || isManager || isKitchen;
    bool canViewBilling = isAdmin || isManager || isCashier;
    bool canViewMenu = isAdmin || isManager || isWaiter || isCashier;
    bool canViewMasters = isAdmin || isManager;
    bool canViewInventory = isAdmin || isManager || isInventory;
    bool canViewStaff = isAdmin || isManager;
    bool canViewAccounts = isAdmin || isManager || isCashier;
    bool canViewReports = isAdmin || isManager || isCashier;
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @effectiveBrandName</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <!-- Google Fonts: Outfit & Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <script>
        // Synchronous check to avoid layout flicker
        (function() {
            try {
                var saved = localStorage.getItem('girana_sidebar_collapsed');
                if (saved === '1' || (saved === null && window.innerWidth < 992)) {
                    document.documentElement.classList.add('init-collapsed');
                }
            } catch(e) {}
        })();
    </script>
    <div class="app-layout" id="appLayout">
        <!-- Collapsible Vertical Sidebar Tabs -->
        <aside class="app-sidebar" id="appSidebar">
            <!-- Sidebar Header / Brand -->
            <div class="sidebar-header">
                <a class="sidebar-brand" href="/" title="@effectiveBrandName">
                    @if (!string.IsNullOrEmpty(appSettings.LogoUrl))
                    {
                        <img src="@appSettings.LogoUrl" alt="Logo" class="brand-logo-img me-2" style="max-height: 38px; max-width: 44px; object-fit: contain; border-radius: 8px;" onerror="this.style.display='none'; document.getElementById('sidebarFallbackCrest').style.display='inline-flex';" />
                        <div class="brand-logo-img" id="sidebarFallbackCrest" style="display: none; border-radius: 50% !important; background: #059669 !important; font-weight: 800; font-size: 1.25rem;">
                            @(string.IsNullOrEmpty(effectiveBrandName) ? "G" : effectiveBrandName.Substring(0, 1).ToUpper())
                        </div>
                    }
                    else
                    {
                        <div class="brand-logo-img" style="border-radius: 50% !important; background: #059669 !important; font-weight: 800; font-size: 1.25rem;">
                            @(string.IsNullOrEmpty(effectiveBrandName) ? "G" : effectiveBrandName.Substring(0, 1).ToUpper())
                        </div>
                    }
                    <span class="brand-text luxury-brand-title">@effectiveBrandName</span>
                </a>
                <button class="sidebar-toggle-btn" id="sidebarToggle" title="Toggle Sidebar">
                    <i class="fa-solid fa-bars-staggered" id="toggleIcon"></i>
                </button>
            </div>

            <!-- Sidebar Vertical Navigation Tabs: Strict 1-10 Order (Section 4) -->
            <nav class="sidebar-nav">
                <div class="nav flex-column">
                    <!-- 1. Dashboard -->
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" href="/Dashboard" data-title="@(isMarathi ? "डॅशबोर्ड" : "Dashboard")" data-bs-toggle="tooltip" data-bs-placement="right" title="@(isMarathi ? "डॅशबोर्ड" : "Dashboard")">
                        <i class="fa-solid fa-chart-pie nav-icon" style="color: #10b981;"></i>
                        <span class="nav-text">@(isMarathi ? "डॅशबोर्ड" : "Dashboard")</span>
                    </a>

                    <!-- 2. Tables & Floors -->
                    @if (canViewTables)
                    {
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tables" ? "active" : "")" href="/Tables" data-title="@(isMarathi ? "टेबल्स आणि मजले" : "Tables & Floors")" data-bs-toggle="tooltip" data-bs-placement="right" title="@(isMarathi ? "टेबल्स आणि मजले" : "Tables & Floors")">
                            <i class="fa-solid fa-chair nav-icon" style="color: #f59e0b;"></i>
                            <span class="nav-text">@(isMarathi ? "टेबल्स आणि मजले" : "Tables & Floors")</span>
                        </a>
                    }

                    <!-- 3. Orders -->
                    @if (canViewOrders)
                    {
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active" : "")" href="/Orders" data-title="@(isMarathi ? "ऑर्डर्स" : "Orders")" data-bs-toggle="tooltip" data-bs-placement="right" title="@(isMarathi ? "ऑर्डर्स" : "Orders")">
                            <i class="fa-solid fa-receipt nav-icon" style="color: #0284c7;"></i>
                            <span class="nav-text">@(isMarathi ? "ऑर्डर्स" : "Orders")</span>
                        </a>
                    }

                    <!-- 4. Kitchen (KDS) -->
                    @if (canViewKitchen)
                    {
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Kitchen" ? "active" : "")" href="/Kitchen" data-title="@(isMarathi ? "किचन (केडीएस)" : "Kitchen (KDS)")" data-bs-toggle="tooltip" data-bs-placement="right" title="@(isMarathi ? "किचन (केडीएस)" : "Kitchen (KDS)")">
                            <i class="fa-solid fa-kitchen-set nav-icon" style="color: #ef4444;"></i>
                            <span class="nav-text">@(isMarathi ? "किचन (केडीएस)" : "Kitchen (KDS)")</span>
                        </a>
                    }

                    <!-- 5. Billing & Payments -->
                    @if (canViewBilling)
                    {
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Billing" ? "active" : "")" href="/Billing" data-title="@(isMarathi ? "बिलिंग आणि पेमेंट्स" : "Billing & Payments")" data-bs-toggle="tooltip" data-bs-placement="right" title="@(isMarathi ? "बिलिंग आणि पेमेंट्स" : "Billing & Payments")">
                            <i class="fa-solid fa-file-invoice-dollar nav-icon" style="color: #8b5cf6;"></i>
                            <span class="nav-text">@(isMarathi ? "बिलिंग आणि पेमेंट्स" : "Billing & Payments")</span>
                        </a>
                    }

                    <!-- 6. Stock & Inventory -->
                    @if (canViewInventory)
                    {
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Inventory" ? "active" : "")" href="/Inventory" data-title="@(isMarathi ? "स्टॉक आणि इन्व्हेंटरी" : "Stock & Inventory")" data-bs-toggle="tooltip" data-bs-placement="right" title="@(isMarathi ? "स्टॉक आणि इन्व्हेंटरी" : "Stock & Inventory")">
                            <i class="fa-solid fa-boxes-stacked nav-icon" style="color: #64748b;"></i>
                            <span class="nav-text">@(isMarathi ? "स्टॉक आणि इन्व्हेंटरी" : "Stock & Inventory")</span>
                        </a>
                    }

                    <!-- 7. Staff & Roles -->
                    @if (canViewStaff)
                    {
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Staff" ? "active" : "")" href="/Staff" data-title="@(isMarathi ? "कर्मचारी आणि भूमिका" : "Staff & Roles")" data-bs-toggle="tooltip" data-bs-placement="right" title="@(isMarathi ? "कर्मचारी आणि भूमिका" : "Staff & Roles")">
                            <i class="fa-solid fa-user-group nav-icon" style="color: #6366f1;"></i>
                            <span class="nav-text">@(isMarathi ? "कर्मचारी आणि भूमिका" : "Staff & Roles")</span>
                        </a>
                    }

                    <!-- 8. Accounts & Payroll -->
                    @if (canViewAccounts)
                    {
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Accounts" ? "active" : "")" href="/Accounts" data-title="@(isMarathi ? "खाती आणि पगार" : "Accounts & Payroll")" data-bs-toggle="tooltip" data-bs-placement="right" title="@(isMarathi ? "खाती आणि पगार" : "Accounts & Payroll")">
                            <i class="fa-solid fa-wallet nav-icon" style="color: #059669;"></i>
                            <span class="nav-text">@(isMarathi ? "खाती आणि पगार" : "Accounts & Payroll")</span>
                        </a>
                    }

                    <!-- 9. Reports -->
                    @if (canViewReports)
                    {
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" href="/Reports" data-title="@(isMarathi ? "अहवाल (रिपोर्ट्स)" : "Reports")" data-bs-toggle="tooltip" data-bs-placement="right" title="@(isMarathi ? "अहवाल (रिपोर्ट्स)" : "Reports")">
                            <i class="fa-solid fa-chart-line nav-icon" style="color: #d97706;"></i>
                            <span class="nav-text">@(isMarathi ? "अहवाल (रिपोर्ट्स)" : "Reports")</span>
                        </a>
                    }

                    <!-- 10. Masters -->
                    @if (canViewMasters)
                    {
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Masters" ? "active" : "")" href="/Masters" data-title="@(isMarathi ? "मास्टर्स" : "Masters")" data-bs-toggle="tooltip" data-bs-placement="right" title="@(isMarathi ? "मास्टर्स" : "Masters")">
                            <i class="fa-solid fa-layer-group nav-icon" style="color: #ec4899;"></i>
                            <span class="nav-text">@(isMarathi ? "मास्टर्स" : "Masters")</span>
                        </a>
                    }
                </div>
            </nav>
        </aside>

        <!-- Main Content Area -->
        <div class="app-main">
            @if (ViewContext.RouteData.Values["controller"]?.ToString() != "Dashboard")
            {
                <!-- Top Header Navbar -->
                <header class="top-header sticky-top">
                    <div class="d-flex align-items-center justify-content-between w-100">
                        <div class="d-flex align-items-center gap-3">
                            <button class="btn btn-outline-secondary btn-sm rounded-circle d-md-none" id="mobileSidebarToggle">
                                <i class="fa-solid fa-bars"></i>
                            </button>
                            <a href="/" class="text-decoration-none d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(appSettings.LogoUrl))
                                {
                                    <img src="@appSettings.LogoUrl" alt="Logo" style="max-height: 32px; max-width: 36px; object-fit: contain; border-radius: 6px;" onerror="this.style.display='none'" />
                                }
                                else
                                {
                                    <i class="fa-solid fa-utensils text-success fs-4"></i>
                                }
                                <span class="luxury-brand-title">@effectiveBrandName</span>
                            </a>
                        </div>
                        
                        <div class="d-flex align-items-center gap-2 gap-md-3">
                            <!-- In-App Language Switcher -->
                            <div class="btn-group btn-group-sm rounded-pill border bg-white p-1 shadow-sm" role="group">
                                <button type="button" class="btn btn-sm rounded-pill py-0 px-2 fw-bold @(!isMarathi ? "btn-success text-white shadow-sm" : "btn-outline-secondary border-0")" onclick="changeAppLang('en')">EN</button>
                                <button type="button" class="btn btn-sm rounded-pill py-0 px-2 fw-bold @(isMarathi ? "btn-success text-white shadow-sm" : "btn-outline-secondary border-0")" onclick="changeAppLang('mr')">मराठी</button>
                            </div>

                            <!-- Live Date & Time Clock with Thin Border -->
                            <div class="live-clock-badge d-none d-md-flex" title="Current Local Time" style="border: 1.5px solid #cbd5e1;">
                                <i class="fa-regular fa-clock text-success"></i>
                                <span id="liveClockText">Loading...</span>
                            </div>

                            <!-- User & Role Dropdown -->
                            <div class="dropdown">
                                <button class="btn role-dropdown-btn btn-sm dropdown-toggle rounded-pill px-3 shadow-sm d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" title="Active User: @displayName">
                                    <i class="fa-solid fa-user-shield text-success"></i>
                                    <span>@(isMarathi ? "भूमिका: " : "Role: ")<strong class="text-dark">@displayRole</strong></span>
                                </button>
                                <ul class="dropdown-menu role-dropdown-menu dropdown-menu-end shadow-lg" style="min-width: 210px; border-radius: 12px; border: 1.5px solid #cbd5e1;">
                                    <li class="px-3 py-2 border-bottom bg-light rounded-top">
                                        <div class="fw-bold text-dark small">@displayName</div>
                                        <div class="text-muted small" style="font-size: 0.72rem;">@displayRole &bull; @effectiveBrandName</div>
                                    </li>
                                    <li><a class="dropdown-item @(displayRole == "Administrator" || displayRole == "Admin" ? "active" : "")" href="#"><i class="fa-solid fa-user-gear text-danger me-2"></i> Admin</a></li>
                                    <li><a class="dropdown-item @(displayRole.Contains("Manager") ? "active" : "")" href="#"><i class="fa-solid fa-briefcase text-success me-2"></i> Manager</a></li>
                                    <li><a class="dropdown-item @(displayRole.Contains("Cashier") ? "active" : "")" href="#"><i class="fa-solid fa-cash-register text-primary me-2"></i> Cashier</a></li>
                                    <li><a class="dropdown-item @(displayRole.Contains("Waiter") ? "active" : "")" href="#"><i class="fa-solid fa-tray text-warning me-2"></i> Waiter</a></li>
                                    <li><a class="dropdown-item @(displayRole.Contains("Kitchen") ? "active" : "")" href="#"><i class="fa-solid fa-kitchen-set text-info me-2"></i> Kitchen Staff</a></li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <a class="dropdown-item small" href="/Account/Login?switchUser=true">
                                            <i class="fa-solid fa-arrows-rotate text-secondary me-2"></i> @(isMarathi ? "वापरकर्ता बदला" : "Switch User / Terminal")
                                        </a>
                                    </li>
                                    @if (isAuthenticated)
                                    {
                                        <li>
                                            <a class="dropdown-item small text-danger fw-semibold logout-link" href="/Account/Logout" onclick="window.location.href='/Account/Logout';">
                                                <i class="fa-solid fa-right-from-bracket me-2"></i> @(isMarathi ? "साइन आउट करा" : "Sign Out")
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <a class="dropdown-item small text-success fw-semibold" href="/Account/Login">
                                                <i class="fa-solid fa-right-to-bracket me-2"></i> @(isMarathi ? "साइन इन करा" : "Sign In")
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                </header>
            }

            <!-- Main Body Container -->
            <main role="main" class="main-content py-4 px-4">
                @RenderBody()
            </main>

            <!-- Global Footer -->
            <footer class="app-footer text-center text-secondary py-3 border-top mt-auto" style="font-size: 0.85rem; background: #ffffff;">
                <div>Girana Garden Restaurant Management System &bull; Clean Architecture .NET 10 MVC + Web API</div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function changeAppLang(lang) {
            document.cookie = `GiranaRMS.Language=${lang};path=/;max-age=31536000;SameSite=Lax`;
            try { localStorage.setItem('girana_rms_lang', lang); } catch (e) { }
            window.location.reload();
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Live Clock Script
            function updateClock() {
                const now = new Date();
                const clockElem = document.getElementById('liveClockText');
                if (clockElem) {
                    const dateStr = now.toLocaleDateString('en-US', { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric' });
                    const timeStr = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true });
                    clockElem.textContent = `${dateStr}  |  ${timeStr}`;
                }
            }
            setInterval(updateClock, 1000);
            updateClock();

            // Collapsible Sidebar Script with User Preference Persistence (Section 2)
            const sidebar = document.getElementById('appSidebar');
            const layout = document.getElementById('appLayout');
            const toggleBtn = document.getElementById('sidebarToggle');
            const toggleIcon = document.getElementById('toggleIcon');
            const mobileToggle = document.getElementById('mobileSidebarToggle');

            // Default to expanded on desktop unless explicitly set to collapsed in localStorage
            var savedPref = localStorage.getItem('girana_sidebar_collapsed');
            var isDesktop = window.innerWidth >= 992;
            var isCollapsed = savedPref !== null ? (savedPref === '1') : !isDesktop;

            function applySidebarState(collapsed) {
                if (collapsed) {
                    sidebar.classList.add('sidebar-collapsed');
                    layout.classList.add('layout-collapsed');
                    if (toggleBtn) toggleBtn.setAttribute('title', 'Expand Sidebar');
                } else {
                    sidebar.classList.remove('sidebar-collapsed');
                    layout.classList.remove('layout-collapsed');
                    if (toggleBtn) toggleBtn.setAttribute('title', 'Collapse Sidebar');
                }
                if (toggleIcon) {
                    toggleIcon.className = 'fa-solid fa-bars-staggered';
                }
            }

            if (toggleBtn) {
                toggleBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    isCollapsed = !isCollapsed;
                    localStorage.setItem('girana_sidebar_collapsed', isCollapsed ? '1' : '0');
                    applySidebarState(isCollapsed);
                });
            }

            if (mobileToggle) {
                mobileToggle.addEventListener('click', function (e) {
                    e.preventDefault();
                    sidebar.classList.toggle('mobile-open');
                });
            }

            // Apply immediately on load
            applySidebarState(isCollapsed);

            // Initialize all Bootstrap 5 tooltips across the application
            function initTooltips() {
                const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                tooltipTriggerList.map(function (tooltipTriggerEl) {
                    return new bootstrap.Tooltip(tooltipTriggerEl, { trigger: 'hover' });
                });
            }
            initTooltips();

            // Interactive Role Switcher
            document.addEventListener('click', function (e) {
                const item = e.target.closest('.role-dropdown-menu .dropdown-item');
                if (!item) return;

                const href = item.getAttribute('href');
                // Allow direct navigation for real URLs (e.g. /Account/Logout, /Account/Login)
                if (href && href !== '#' && !href.startsWith('javascript:')) {
                    return;
                }

                e.preventDefault();
                const dropdown = item.closest('.dropdown');
                if (dropdown) {
                    dropdown.querySelectorAll('.dropdown-item').forEach(function (el) {
                        el.classList.remove('active');
                        const icon = el.querySelector('i');
                        if (icon) {
                            icon.classList.remove('text-white');
                        }
                    });
                    item.classList.add('active');
                    const activeIcon = item.querySelector('i');
                    if (activeIcon) {
                        activeIcon.classList.add('text-white');
                    }
                    const roleBtnLabel = dropdown.querySelector('.role-dropdown-btn strong');
                    if (roleBtnLabel) {
                        roleBtnLabel.textContent = item.textContent.trim();
                    }
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
