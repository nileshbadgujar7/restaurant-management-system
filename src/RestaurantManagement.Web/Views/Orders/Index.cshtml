@model IEnumerable<OrderDto>
@{
    var isMarathi = Context.Request.Cookies["GiranaRMS.Language"] == "mr";
    ViewData["Title"] = isMarathi ? "ऑर्डर्स इतिहास" : "Orders History";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 animated-fade-in">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 fs-6">
                <li class="breadcrumb-item">
                    <a href="/Dashboard" class="text-decoration-none fw-semibold text-success">
                        <i class="fa-solid fa-chart-pie me-1" data-bs-toggle="tooltip" title="Dashboard"></i> @(isMarathi ? "डॅशबोर्ड" : "Dashboard")
                    </a>
                </li>
                <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">
                    <i class="fa-solid fa-receipt text-primary me-1"></i> @(isMarathi ? "ऑर्डर्स इतिहास" : "Orders History")
                </li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-receipt text-primary me-2"></i>@(isMarathi ? "ऑर्डर्स इतिहास" : "Orders History")
        </h2>
    </div>
    <div class="d-flex gap-2">
        <a href="/Dashboard" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm" data-bs-toggle="tooltip" title="Back to Dashboard">
            <i class="fa-solid fa-arrow-left me-1"></i> @(isMarathi ? "डॅशबोर्डवर परत" : "Back to Dashboard")
        </a>
        <a href="/Orders/POS" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> @(isMarathi ? "नवीन POS ऑर्डर" : "New POS Order")
        </a>
    </div>
</div>

<div class="glass-card p-4 animated-fade-in">
    <div class="table-responsive">
        <table class="table app-datagrid align-middle">
            <thead>
                <tr>
                    <th>@(isMarathi ? "ऑर्डर क्र." : "Order #")</th>
                    <th>@(isMarathi ? "प्रकार" : "Type")</th>
                    <th>@(isMarathi ? "टेबल / ग्राहक" : "Table / Customer")</th>
                    <th>@(isMarathi ? "दिनांक व वेळ" : "Date & Time")</th>
                    <th>@(isMarathi ? "स्थिती" : "Status")</th>
                    <th>@(isMarathi ? "रक्कम" : "Amount")</th>
                    <th class="text-end">@(isMarathi ? "कृती" : "Actions")</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-receipt fs-2 d-block mb-2 text-secondary opacity-50"></i>
                            <p class="small mb-0 text-muted">@(isMarathi ? "कोणतीही ऑर्डर सापडली नाही. नवीन ऑर्डर तयार करण्यासाठी 'नवीन POS ऑर्डर' वर क्लिक करा." : "No orders found. Click \"New POS Order\" to create one.")</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var order in Model)
                    {
                        string statusBadge = order.Status switch {
                            OrderStatus.Pending => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
                            OrderStatus.Confirmed => "bg-info-subtle text-info-emphasis border border-info-subtle",
                            OrderStatus.Preparing => "bg-primary-subtle text-primary border border-primary-subtle",
                            OrderStatus.Ready => "bg-success-subtle text-success border border-success-subtle",
                            OrderStatus.Completed => "bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle",
                            _ => "bg-danger-subtle text-danger border border-danger-subtle"
                        };

                        <tr>
                            <td class="fw-bold text-dark">@order.OrderNumber</td>
                            <td><span class="badge bg-light text-dark border rounded-pill px-3 py-1">@order.OrderTypeName</span></td>
                            <td>
                                <div class="fw-semibold text-dark">@(order.TableNumber != null ? $"Table: {order.TableNumber}" : order.CustomerName)</div>
                                <div class="small text-secondary">@order.CustomerPhone</div>
                            </td>
                            <td class="small text-secondary">@order.CreatedAt.ToString("g")</td>
                            <td><span class="badge @statusBadge px-3 py-1 rounded-pill">@order.StatusName</span></td>
                            <td class="fw-bold text-dark fs-6">₹@order.GrandTotal.ToString("N0")</td>
                            <td class="text-end">
                                <a href="/Orders/POS?orderId=@order.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="fa-solid fa-pen-to-square me-1"></i> @(isMarathi ? "तपशील / आयटम" : "Details / Items")
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
