@{
    ViewData["Title"] = "POS - Order Management";
    var categories = ViewBag.Categories as IEnumerable<CategoryDto> ?? new List<CategoryDto>();
    var menuItems = ViewBag.MenuItems as IEnumerable<MenuItemDto> ?? new List<MenuItemDto>();
    var tables = ViewBag.Tables as IEnumerable<TableDto> ?? new List<TableDto>();
    var waiters = ViewBag.Waiters as IEnumerable<EmployeeDto> ?? new List<EmployeeDto>();
    var selectedTable = ViewBag.SelectedTable as TableDto;
    int? selectedTableId = ViewBag.SelectedTableId as int?;
    var activeOrder = ViewBag.ActiveOrder as OrderDto;
    var activeDraft = ViewBag.ActiveDraft as OrderDto;
    var setting = ViewBag.Setting as RestaurantSetting ?? new RestaurantSetting();
    string returnUrl = (ViewBag.ReturnUrl as string) ?? "/Dashboard";
    string returnTitle = returnUrl.Contains("Table", StringComparison.OrdinalIgnoreCase) ? "Tables & Floor" : "Dashboard";

    var currentMode = setting.KitchenMode;
    int orderId = activeOrder?.Id ?? activeDraft?.Id ?? 0;
    bool isDraft = activeOrder == null;
    string orderNumber = activeOrder?.OrderNumber ?? (activeDraft != null ? activeDraft.OrderNumber : "NEW ORDER");
    int initialCovers = activeOrder?.Covers ?? activeDraft?.Covers ?? (selectedTable != null ? Math.Min(selectedTable.Capacity, 2) : 2);
    int tableCapacity = selectedTable?.Capacity ?? 6;
    string defaultWaiter = activeOrder?.WaiterName ?? activeDraft?.DraftUserName ?? selectedTable?.WaiterName ?? waiters.FirstOrDefault()?.Name ?? "Staff";
    int defaultWaiterId = activeOrder?.WaiterId ?? selectedTable?.WaiterId ?? waiters.FirstOrDefault()?.Id ?? 0;

    var jsonOptions = new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase,
        PropertyNameCaseInsensitive = true
    };
    string initialOrderJson = (activeOrder ?? activeDraft) != null 
        ? System.Text.Json.JsonSerializer.Serialize(activeOrder ?? activeDraft, jsonOptions)
        : "null";
}

<style>
    .pos-screen {
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    }
    .panel-container {
        height: calc(100vh - 170px);
        min-height: 600px;
    }
    .menu-panel {
        height: 100%;
        overflow-y: auto;
        border-radius: 1rem;
        background: #ffffff;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    }
    .order-panel {
        height: 100%;
        display: flex;
        flex-direction: column;
        border-radius: 1rem;
        background: #ffffff;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    }
    .order-scroll-area {
        flex: 1;
        overflow-y: auto;
        padding: 0.75rem;
    }
    .sticky-order-footer {
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
        border-bottom-left-radius: 1rem;
        border-bottom-right-radius: 1rem;
        padding: 0.75rem 1rem;
    }
    .menu-item-row {
        cursor: pointer;
        transition: all 0.15s ease;
        border-radius: 0.5rem;
    }
    .menu-item-row:hover {
        background-color: #f1f5f9;
        transform: translateY(-1px);
    }
    .status-chip {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.25rem 0.5rem;
        border-radius: 9999px;
    }
    .note-chip {
        cursor: pointer;
        font-size: 0.7rem;
        padding: 0.15rem 0.45rem;
        border-radius: 9999px;
        background: #f1f5f9;
        border: 1px solid #cbd5e1;
        color: #334155;
        transition: background 0.15s;
    }
    .note-chip:hover {
        background: #e2e8f0;
    }
    .undo-toast {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        z-index: 1090;
        min-width: 300px;
    }
    .veg-indicator {
        width: 14px;
        height: 14px;
        border: 2px solid #16a34a;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 3px;
        margin-right: 6px;
    }
    .veg-dot {
        width: 6px;
        height: 6px;
        background: #16a34a;
        border-radius: 50%;
    }
    .nonveg-indicator {
        width: 14px;
        height: 14px;
        border: 2px solid #dc2626;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 3px;
        margin-right: 6px;
    }
    .nonveg-dot {
        width: 6px;
        height: 6px;
        background: #dc2626;
        border-radius: 50%;
    }
</style>

<div class="pos-screen">
    <!-- 3.1 HEADER: Order number, table, covers, waiter, running timer, mode badge -->
    <div class="glass-card p-2 px-3 mb-2 d-flex flex-wrap align-items-center justify-content-between gap-2 shadow-sm rounded-4">
        <div class="d-flex align-items-center gap-3">
            <a href="@returnUrl" class="btn btn-sm btn-outline-secondary rounded-circle" title="Back to @returnTitle">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h5 class="fw-bold mb-0 text-dark" id="displayOrderNumber">
                        <i class="fa-solid fa-receipt text-primary me-1"></i>@orderNumber
                    </h5>
                    <span class="badge @(isDraft ? "bg-secondary" : "bg-primary") rounded-pill px-2 py-1" id="orderStatusBadge">
                        @(isDraft ? "DRAFT" : activeOrder?.Status.ToString().ToUpper())
                    </span>
                </div>
                <div class="small text-muted d-flex align-items-center gap-2 mt-1">
                    <span>
                        <i class="fa-solid fa-chair text-warning me-1"></i>
                        <strong>@(selectedTable != null ? $"Table {selectedTable.TableNumber} · {selectedTable.FloorName}" : "Quick Counter")</strong>
                    </span>
                    &bull;
                    <span>
                        <i class="fa-solid fa-users text-info me-1"></i>Covers: 
                        <input type="number" id="coversInput" value="@initialCovers" min="1" max="@tableCapacity" class="form-control form-control-sm d-inline-block py-0 px-1 text-center" style="width: 48px; height: 24px;" onchange="onCoversChange()" />
                    </span>
                    &bull;
                    <span>
                        <i class="fa-solid fa-user-tie text-secondary me-1"></i>
                        <input type="text" id="waiterInput" value="@defaultWaiter" list="waiterDataList" class="form-control form-control-sm d-inline-block py-0 px-1" style="width: 110px; height: 24px;" />
                        <datalist id="waiterDataList">
                            @foreach (var w in waiters)
                            {
                                <option value="@w.Name">@w.Name</option>
                            }
                        </datalist>
                    </span>
                    &bull;
                    <span id="runningTimer" class="badge bg-light text-dark border">
                        <i class="fa-regular fa-clock me-1"></i><span id="elapsedMinutes">0</span> min
                    </span>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <!-- Whole Order Note Field (FR-OM-08) -->
            <div class="input-group input-group-sm" style="max-width: 280px;">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-pen-nib"></i></span>
                <input type="text" id="orderNoteInput" class="form-control border-start-0" placeholder="Order note (max 250 chars)..." maxlength="250" value="@(activeOrder?.OrderNote ?? activeDraft?.OrderNote ?? "")" onchange="autoSaveDraft()" />
            </div>

            <!-- Quick Action Dropdown -->
            <div class="dropdown">
                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 dropdown-toggle shadow-sm" type="button" data-bs-toggle="dropdown">
                    <i class="fa-solid fa-ellipsis-vertical me-1"></i> More
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow">
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="openTransferMergeModal()"><i class="fa-solid fa-arrow-right-arrow-left me-2 text-primary"></i>Move / Merge Table</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="showEstimateSlip()"><i class="fa-solid fa-calculator me-2 text-info"></i>View Estimate Slip (OM-A22)</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="showCounterKOTSlip()"><i class="fa-solid fa-receipt me-2 text-success"></i>Counter KOT Slip (OM-A21)</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" href="javascript:void(0)" onclick="promptCancelOrder()"><i class="fa-solid fa-ban me-2"></i>Cancel Entire Order</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- MAIN TWO-PANEL CONTENT -->
    <div class="row g-2 panel-container">
        
        <!-- LEFT PANEL: Category Tabs, Search, Veg/Nonveg, Menu Catalog -->
        <div class="col-lg-7">
            <div class="menu-panel p-3">
                <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-2 pb-2 border-bottom">
                    <!-- Search Box -->
                    <div class="input-group input-group-sm" style="max-width: 260px;">
                        <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                        <input type="text" id="catalogSearch" class="form-control border-start-0" placeholder="Search dish..." onkeyup="filterMenuCatalog()" />
                    </div>

                    <!-- Veg / Non-Veg Filters -->
                    <div class="btn-group btn-group-sm" role="group">
                        <button class="btn btn-outline-secondary active veg-pill px-2" onclick="filterVeg('all', this)">All</button>
                        <button class="btn btn-outline-success veg-pill px-2" onclick="filterVeg('veg', this)">
                            <span class="veg-indicator"><span class="veg-dot"></span></span> Veg
                        </button>
                        <button class="btn btn-outline-danger veg-pill px-2" onclick="filterVeg('nonveg', this)">
                            <span class="nonveg-indicator"><span class="nonveg-dot"></span></span> Non-Veg
                        </button>
                    </div>
                </div>

                <!-- Category Tabs (Horizontal Pills) -->
                <div class="d-flex gap-1 overflow-auto pb-2 mb-2" style="white-space: nowrap;">
                    <button class="btn btn-sm btn-primary rounded-pill px-3 cat-btn active" onclick="filterCategory(0, this)">
                        All (@menuItems.Count())
                    </button>
                    @foreach (var cat in categories)
                    {
                        <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 cat-btn" onclick="filterCategory(@cat.Id, this)">
                            @cat.Name (@cat.ItemCount)
                        </button>
                    }
                </div>

                <!-- Menu Items List -->
                <div class="list-group list-group-flush" id="menuCatalogList" style="max-height: calc(100% - 95px); overflow-y: auto;">
                    @foreach (var item in menuItems)
                    {
                        var hasVariants = item.Variants != null && item.Variants.Any();
                        var hasAddOns = item.AddOns != null && item.AddOns.Any();
                        var hasChoices = hasVariants || hasAddOns;

                        <div class="list-group-item list-group-item-action menu-item-row p-2 d-flex align-items-center justify-content-between border-bottom"
                             data-cat="@item.CategoryId" data-veg="@(item.IsVeg ? "veg" : "nonveg")" data-name="@item.Name.ToLower()"
                             onclick="onMenuItemClicked(@item.Id, '@item.Name', @item.Price, @(hasChoices.ToString().ToLower()), @(item.IsAvailable.ToString().ToLower()))">
                            
                            <div class="d-flex align-items-center" style="min-width: 0; flex: 1;">
                                @if (item.IsVeg)
                                {
                                    <span class="veg-indicator"><span class="veg-dot"></span></span>
                                }
                                else
                                {
                                    <span class="nonveg-indicator"><span class="nonveg-dot"></span></span>
                                }
                                <div class="ms-1" style="min-width: 0;">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-bold text-dark text-truncate">@item.Name</span>
                                        <span class="badge bg-light text-secondary border small">@item.CategoryName</span>
                                        @if (!item.IsAvailable)
                                        {
                                            <span class="badge bg-danger rounded-pill small">Sold Out</span>
                                        }
                                        @if (hasChoices)
                                        {
                                            <span class="badge bg-info-subtle text-info border small"><i class="fa-solid fa-sliders me-1"></i>Options</span>
                                        }
                                    </div>
                                    <div class="small text-muted text-truncate" style="font-size: 0.75rem;">@item.Description</div>
                                </div>
                            </div>

                            <div class="text-end ms-2">
                                <span class="fw-bold text-success fs-6">₹@item.Price.ToString("N0")</span>
                                @if (item.IsAvailable)
                                {
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-2 py-0 ms-2" title="Add to Section B">
                                        <i class="fa-solid fa-plus"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT PANEL: Section A (Sent to Kitchen) & Section B (New Items) + Sticky Footer -->
        <div class="col-lg-5">
            <div class="order-panel">
                <div class="order-scroll-area">
                    
                    <!-- SECTION A: SENT TO KITCHEN (LOCKED ROWS WITH ⋯ MENU) -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold text-secondary text-uppercase small" style="letter-spacing: 0.5px;">
                                <i class="fa-solid fa-fire text-danger me-1"></i>Section A: Sent to Kitchen
                            </span>
                            <span class="badge bg-secondary-subtle text-secondary rounded-pill small" id="sectionACount">0 Sent</span>
                        </div>
                        <div id="sectionAList" class="border rounded-3 p-1 bg-light">
                            <!-- Populated dynamically via JS -->
                            <div class="text-center py-3 text-muted small" id="sectionAEmpty">
                                <i class="fa-solid fa-utensils mb-1"></i><br />No items sent to kitchen yet.
                            </div>
                        </div>
                    </div>

                    <!-- SECTION B: NEW ITEMS (NOT SENT - EDITABLE ROWS, STEPPERS, NOTES, REMOVE) -->
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold text-primary text-uppercase small" style="letter-spacing: 0.5px;">
                                <i class="fa-solid fa-plus-circle text-primary me-1"></i>Section B: New Items (Not Sent)
                            </span>
                            <span class="badge bg-primary-subtle text-primary rounded-pill small" id="sectionBCount">0 Items</span>
                        </div>
                        <div id="sectionBList">
                            <!-- Populated dynamically via JS -->
                            <div class="text-center py-4 text-muted small border rounded-3 bg-light" id="sectionBEmpty">
                                <i class="fa-solid fa-cart-shopping fs-4 text-secondary opacity-50 mb-1"></i><br />
                                Tap any dish on the left to add here.<br />
                                <span class="text-secondary small">Customise with note chips or steppers before sending.</span>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- 3.1 STICKY FOOTER: Totals, Send KOT, Bill -->
                <div class="sticky-order-footer">
                    <div class="row g-1 mb-2 small text-secondary">
                        <div class="col-6 d-flex justify-content-between">
                            <span>Subtotal:</span>
                            <strong class="text-dark" id="displaySubtotal">₹0.00</strong>
                        </div>
                        <div class="col-6 d-flex justify-content-between">
                            <span>CGST (2.5%):</span>
                            <strong class="text-dark" id="displayCGST">₹0.00</strong>
                        </div>
                        <div class="col-6 d-flex justify-content-between">
                            <span>SGST (2.5%):</span>
                            <strong class="text-dark" id="displaySGST">₹0.00</strong>
                        </div>
                        <div class="col-6 d-flex justify-content-between">
                            <span>Round-off:</span>
                            <strong class="text-dark" id="displayRoundOff">₹0.00</strong>
                        </div>
                        <div class="col-12 border-top pt-1 mt-1 d-flex justify-content-between align-items-center fs-5 fw-bold text-dark">
                            <span>Grand Total:</span>
                            <span class="text-success" id="displayGrandTotal">₹0.00</span>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="autoSaveDraft(true)" title="Save draft without sending KOT">
                            <i class="fa-solid fa-bookmark me-1"></i> Hold Draft
                        </button>
                        
                        <!-- Send KOT / Update KOT Button -->
                        <button class="btn btn-warning flex-grow-1 rounded-pill fw-bold text-dark shadow-sm d-flex align-items-center justify-content-center gap-2" id="sendKotBtn" onclick="onSendKOTClicked()">
                            <i class="fa-solid fa-paper-plane text-danger"></i>
                            <span id="sendKotBtnText">Send KOT</span>
                        </button>


                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 5-SECOND UNDO TOAST (FR-OM-04) -->
<div class="undo-toast" id="undoToastContainer" style="display: none;">
    <div class="alert alert-dark shadow-lg d-flex justify-content-between align-items-center mb-0 rounded-4 py-2 px-3 border border-secondary">
        <div>
            <i class="fa-solid fa-rotate-left text-warning me-2"></i>
            <span id="undoToastText">Item removed.</span>
        </div>
        <button class="btn btn-warning btn-sm rounded-pill px-3 py-1 fw-bold text-dark ms-3" onclick="undoRemoveItem()">
            Undo
        </button>
    </div>
</div>

<!-- MODAL 1: INLINE CUSTOMIZATION (VARIANTS & ADD-ONS) (FR-OM-02) -->
<div class="modal fade" id="customiseItemModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="customiseModalTitle">Customise Dish</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="custMenuItemId" />
                <input type="hidden" id="custBasePrice" />

                <!-- Variant Selection -->
                <div id="variantSection" class="mb-3" style="display: none;">
                    <label class="form-label fw-bold small text-secondary">Choose Variant:</label>
                    <div id="variantOptions" class="d-flex flex-wrap gap-2"></div>
                </div>

                <!-- Add-Ons Selection -->
                <div id="addOnSection" class="mb-3" style="display: none;">
                    <label class="form-label fw-bold small text-secondary">Optional Add-ons:</label>
                    <div id="addOnOptions" class="d-flex flex-wrap gap-2"></div>
                </div>

                <!-- Course Tag (FR-OM-09) -->
                <div class="mb-3">
                    <label class="form-label fw-bold small text-secondary">Serve Course:</label>
                    <div class="btn-group btn-group-sm w-100" role="group">
                        <input type="radio" class="btn-check" name="custCourse" id="courseStarter" value="Starter">
                        <label class="btn btn-outline-secondary" for="courseStarter">Starter First</label>

                        <input type="radio" class="btn-check" name="custCourse" id="courseMain" value="Main" checked>
                        <label class="btn btn-outline-secondary" for="courseMain">With Main</label>

                        <input type="radio" class="btn-check" name="custCourse" id="courseDessert" value="Dessert">
                        <label class="btn btn-outline-secondary" for="courseDessert">Dessert Later</label>
                    </div>
                </div>

                <!-- Special Note & Shortcuts (FR-OM-07) -->
                <div class="mb-3">
                    <label class="form-label fw-bold small text-secondary">Quick Note Shortcuts:</label>
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        <span class="note-chip" onclick="appendCustNote('Less spicy')">Less spicy</span>
                        <span class="note-chip" onclick="appendCustNote('No onion')">No onion</span>
                        <span class="note-chip" onclick="appendCustNote('Extra spicy')">Extra spicy</span>
                        <span class="note-chip" onclick="appendCustNote('Jain')">Jain</span>
                        <span class="note-chip" onclick="appendCustNote('Pack separately')">Pack separately</span>
                    </div>
                    <input type="text" id="custSpecialNote" class="form-control form-control-sm" placeholder="Custom note (e.g. less butter)..." maxlength="100" />
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" onclick="confirmCustomisedItem()">
                    Add to Order &bull; <span id="custComputedPrice">₹0</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL 2: REDUCE / CANCEL SENT ITEM (FR-OM-05, OM-B03/B04/B05) -->
<div class="modal fade" id="reduceItemModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i>Reduce / Cancel Sent Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="reduceOrderItemId" />
                <p class="text-dark small mb-3">Item: <strong id="reduceItemName"></strong> &bull; Current Qty: <strong id="reduceItemCurrentQty"></strong></p>

                <div class="mb-3">
                    <label class="form-label fw-bold small">Reduce by Quantity:</label>
                    <input type="number" id="reduceQtyInput" class="form-control" value="1" min="1" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold small">Reason for cancellation / reduction (mandatory):</label>
                    <input type="text" id="reduceReasonInput" class="form-control" placeholder="e.g. Customer changed mind, delayed service..." />
                </div>

                <!-- Mode 3 "I have informed the kitchen" confirmation (FR-OM-05, OM-D05) -->
                <div class="form-check p-3 bg-light rounded-3 border mb-3" id="informedKitchenCheckGroup">
                    <input class="form-check-input ms-0 me-2" type="checkbox" id="informedKitchenCheckbox" />
                    <label class="form-check-label fw-bold small text-dark" for="informedKitchenCheckbox">
                        I have informed the kitchen (Rule FR-OM-05)
                    </label>
                    <div class="small text-muted mt-1">Required because no automatic kitchen screen acknowledges this cancellation.</div>
                </div>

                <!-- Manager PIN Input -->
                <div class="mb-2" id="managerPinGroup">
                    <label class="form-label fw-bold small text-danger">Manager PIN (if required):</label>
                    <input type="password" id="reduceManagerPin" class="form-control" placeholder="Enter PIN (default 1234)" />
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger rounded-pill px-4 fw-bold" onclick="submitReduceItem()">Confirm Reduction</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL 3: NOTE CHANGE ON SENT ITEM (OM-B09, OM-B10) -->
<div class="modal fade" id="changeNoteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark">Change Note on Sent Dish</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="changeNoteItemId" />
                <p class="small text-muted mb-2">A "NOTE CHANGE" slip will be sent to the kitchen.</p>
                <label class="form-label fw-bold small">New Special Instruction (max 100 chars):</label>
                <input type="text" id="changeNoteInput" class="form-control" maxlength="100" placeholder="e.g. Make it extra spicy..." />
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" onclick="submitChangeNote()">Update Note</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: EDIT ITEM / KOT -->
<div class="modal fade" id="editItemModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-pen-to-square text-primary me-2"></i>Edit Item / KOT</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editOrderItemId" />
                <div class="mb-3">
                    <label class="form-label fw-bold small text-secondary">Item Name</label>
                    <input type="text" id="editItemNameDisplay" class="form-control bg-light" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small text-secondary">Quantity</label>
                    <input type="number" id="editItemQtyInput" class="form-control" min="1" max="99" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small text-secondary">Special Instructions / Notes</label>
                    <input type="text" id="editItemInstructionsInput" class="form-control" maxlength="250" placeholder="e.g. Less spicy, Extra sauce..." />
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" onclick="saveEditedItem()" id="saveEditedItemBtn">Save Changes</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // System Context
    const CURRENT_KITCHEN_MODE = @((int)currentMode); // 1 = FullKDS, 2 = PrinterOnly, 3 = NoDevice
    const TRACK_READY_STATUS = @(setting.TrackReadyStatus.ToString().ToLower());
    let currentOrderId = @orderId;
    let selectedTableId = @(selectedTableId.HasValue ? selectedTableId.Value.ToString() : "null");
    let initialOrderData = @Html.Raw(initialOrderJson);

    // Section A (Sent to Kitchen items) and Section B (New unsent items)
    let sectionAItems = [];
    let sectionBItems = [];
    let lastRemovedItem = null;
    let undoTimeout = null;

    $(document).ready(function() {
        initOrderState();
        startTimer();
    });

    function initOrderState() {
        let rawItems = [];
        if (initialOrderData) {
            rawItems = initialOrderData.items || initialOrderData.Items || [];
        }

        rawItems.forEach(item => {
            let itemId = item.id ?? item.Id ?? 0;
            let menuItemId = item.menuItemId ?? item.MenuItemId;
            let name = item.itemName ?? item.ItemName ?? item.name ?? '';
            let price = item.unitPrice ?? item.UnitPrice ?? item.price ?? 0;
            let qty = item.quantity ?? item.Quantity ?? 1;
            let variantName = item.selectedVariantName ?? item.SelectedVariantName ?? '';
            let note = item.specialInstructions ?? item.SpecialInstructions ?? '';
            let course = item.course ?? item.Course ?? 'Main';
            let status = item.status ?? item.Status ?? 1;
            let kotNo = item.kotNumber ?? item.KOTNumber ?? '';
            if (!kotNo && initialOrderData && (initialOrderData.kots || initialOrderData.KOTs)) {
                let kList = initialOrderData.kots || initialOrderData.KOTs;
                if (kList.length > 0) kotNo = kList[0].kotNumber || kList[0].KOTNumber;
            }
            let sentAt = item.sentAt ?? item.SentAt;

            // OrderItemStatus: 1=Pending (Section B), 2=Sent, 3=Preparing, 4=Ready, 5=Served (Section A), 6=Cancelled
            if (status === 1 || status === 'Pending') {
                sectionBItems.push({
                    id: itemId,
                    menuItemId: menuItemId,
                    name: name,
                    price: price,
                    quantity: qty,
                    variantName: variantName,
                    note: note,
                    course: course,
                    addOns: item.addOns || item.AddOns || []
                });
            } else if (status !== 6 && status !== 'Cancelled') {
                sectionAItems.push({
                    id: itemId,
                    menuItemId: menuItemId,
                    itemName: name,
                    unitPrice: price,
                    quantity: qty,
                    totalPrice: item.totalPrice ?? item.TotalPrice ?? (price * qty),
                    selectedVariantName: variantName,
                    specialInstructions: note,
                    status: (typeof status === 'number') ? status : (status === 'Sent' ? 2 : (status === 'Preparing' ? 3 : (status === 'Ready' ? 4 : (status === 'Served' ? 5 : 2)))),
                    kotNumber: kotNo,
                    sentAt: sentAt
                });
            }
        });

        renderSectionA();
        renderSectionB();
        updateFooterTotals();
    }

    // -------------------------------------------------------------
    // SECTION A: SENT TO KITCHEN RENDERING
    // -------------------------------------------------------------
    function renderSectionA() {
        let container = $('#sectionAList');
        let countBadge = $('#sectionACount');
        let rawTableNo = '@(selectedTable != null ? selectedTable.TableNumber : (activeOrder?.TableNumber ?? ""))';
        let cleanTable = rawTableNo.replace('Table', '').trim();
        let tableDisplay = cleanTable ? `Table ${cleanTable}` : 'No Table';

        countBadge.text(sectionAItems.length + ' Sent');

        if (sectionAItems.length === 0) {
            $('#sendKotBtnText').text('Send KOT');
            container.html(`
                <div class="text-center py-3 text-muted small" id="sectionAEmpty">
                    <i class="fa-solid fa-utensils mb-1"></i><br />No items sent to kitchen yet.
                </div>
            `);
            return;
        }

        $('#sendKotBtnText').text('Update KOT (Add to Order)');

        let firstKot = sectionAItems.find(i => i.kotNumber && i.kotNumber.trim() !== '')?.kotNumber || 'KOT Issued';

        let html = `
            <div class="px-2 py-1 mb-2 rounded-2 border d-flex justify-content-between align-items-center shadow-xs" style="background:#f0fdf4 !important; border-color:#bbf7d0 !important;">
                <span class="small fw-bold text-dark"><i class="fa-solid fa-chair text-success me-1"></i>${tableDisplay}</span>
                <span class="badge bg-success text-white rounded-pill"><i class="fa-solid fa-receipt me-1"></i>${firstKot}</span>
            </div>
        `;

        sectionAItems.forEach(item => {
            let statusText = getStatusText(item.status);
            let statusColor = getStatusColor(item.status);
            let timeStr = item.sentAt ? new Date(item.sentAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '';

            html += `
                <div class="p-2 mb-1 bg-white rounded-2 border d-flex justify-content-between align-items-center shadow-xs">
                    <div style="flex: 1; min-width: 0;">
                        <div class="d-flex align-items-center gap-1 flex-wrap">
                            <span class="badge bg-secondary-subtle text-dark border small fw-bold">${item.quantity}x</span>
                            <span class="fw-bold text-dark small text-truncate">${item.itemName} ${item.selectedVariantName ? '(' + item.selectedVariantName + ')' : ''}</span>
                            ${item.kotNumber ? `<span class="badge bg-light text-secondary border py-0" style="font-size:0.65rem;"><i class="fa-solid fa-receipt me-1"></i>${item.kotNumber}</span>` : ''}
                        </div>
                        <div class="small text-muted" style="font-size: 0.7rem;">
                            <span class="badge ${statusColor} status-chip py-0">${statusText}</span>
                            ${timeStr ? `&bull; ${timeStr}` : ''}
                            ${item.specialInstructions ? `&bull; <span class="text-info">${item.specialInstructions}</span>` : ''}
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2 ms-2">
                        <span class="fw-bold text-dark small">₹${(item.totalPrice || (item.unitPrice * item.quantity)).toFixed(2)}</span>
                        
                        <!-- Allowed Actions "⋯" Dropdown (Section 3.3) -->
                        <div class="dropdown">
                            <button class="btn btn-sm btn-link text-secondary p-0" type="button" data-bs-toggle="dropdown" title="Edit Item / KOT Actions">
                                <i class="fa-solid fa-ellipsis-vertical fs-6"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li><a class="dropdown-item small" href="javascript:void(0)" onclick="openEditItemModal(${item.id}, '${item.itemName.replace(/'/g, "\\'")}', ${item.quantity}, '${(item.specialInstructions || '').replace(/'/g, "\\'")}')"><i class="fa-solid fa-pen-to-square text-primary me-2"></i>Edit Item / KOT</a></li>
                                <li><a class="dropdown-item small" href="javascript:void(0)" onclick="repeatSentItem(${item.menuItemId}, '${item.itemName.replace(/'/g, "\\'")}', ${item.unitPrice})"><i class="fa-solid fa-plus text-success me-2"></i>Repeat One More</a></li>
                                <li><a class="dropdown-item small text-danger" href="javascript:void(0)" onclick="openReduceModal(${item.id}, '${item.itemName.replace(/'/g, "\\'")}', ${item.quantity}, ${item.status})"><i class="fa-solid fa-minus me-2"></i>Reduce / Cancel</a></li>
                                <li><a class="dropdown-item small text-info" href="javascript:void(0)" onclick="openChangeNoteModal(${item.id}, '${(item.specialInstructions || '').replace(/'/g, "\\'")}')"><i class="fa-solid fa-comment-pen me-2"></i>Change Note</a></li>
                                ${item.status !== 5 ? `<li><a class="dropdown-item small text-success" href="javascript:void(0)" onclick="markItemStatus(${item.id}, 5)"><i class="fa-solid fa-check-double me-2"></i>Mark Served</a></li>` : ''}
                            </ul>
                        </div>
                    </div>
                </div>
            `;
        });
        container.html(html);
    }

    function getStatusText(status) {
        switch(status) {
            case 2:
            case "Sent": return "Sent";
            case 3:
            case "Preparing": return "Preparing";
            case 4:
            case "Ready": return "Ready";
            case 5:
            case "Served": return "Served";
            case 6:
            case "Cancelled": return "Cancelled";
            default: return "Pending";
        }
    }

    function getStatusColor(status) {
        switch(status) {
            case 2:
            case "Sent": return "bg-primary-subtle text-primary border border-primary-subtle";
            case 3:
            case "Preparing": return "bg-warning-subtle text-warning border border-warning-subtle";
            case 4:
            case "Ready": return "bg-info-subtle text-info border border-info-subtle";
            case 5:
            case "Served": return "bg-success-subtle text-success border border-success-subtle";
            case 6:
            case "Cancelled": return "bg-danger-subtle text-danger border border-danger-subtle";
            default: return "bg-secondary-subtle text-secondary";
        }
    }

    // -------------------------------------------------------------
    // SECTION B: NEW ITEMS RENDERING
    // -------------------------------------------------------------
    function renderSectionB() {
        let container = $('#sectionBList');
        let countBadge = $('#sectionBCount');
        countBadge.text(sectionBItems.length + ' Items');

        if (sectionBItems.length === 0) {
            container.html(`
                <div class="text-center py-4 text-muted small border rounded-3 bg-light" id="sectionBEmpty">
                    <i class="fa-solid fa-cart-shopping fs-4 text-secondary opacity-50 mb-1"></i><br />
                    Tap any dish on the left to add here.<br />
                    <span class="text-secondary small">Customise with note chips or steppers before sending.</span>
                </div>
            `);
            $('#sendKotBtn').prop('disabled', true);
            return;
        }

        $('#sendKotBtn').prop('disabled', false);

        let html = '';
        sectionBItems.forEach((item, index) => {
            html += `
                <div class="p-2 mb-2 bg-white rounded-3 border shadow-xs">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <div style="flex: 1; min-width: 0;">
                            <span class="fw-bold text-dark small">${item.name}</span>
                            ${item.variantName ? `<span class="badge bg-light text-secondary border small ms-1">${item.variantName}</span>` : ''}
                            <span class="badge bg-secondary-subtle text-secondary small ms-1">${item.course}</span>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <!-- Stepper (FR-OM-03) -->
                            <button class="btn btn-outline-secondary btn-sm px-2 py-0 rounded-circle" onclick="updateSectionBQty(${index}, -1)">-</button>
                            <span class="fw-bold px-1 small">${item.quantity}</span>
                            <button class="btn btn-outline-secondary btn-sm px-2 py-0 rounded-circle" onclick="updateSectionBQty(${index}, 1)">+</button>
                            <button class="btn btn-link text-danger p-0 ms-2" onclick="removeSectionBItem(${index})" title="Remove item">
                                <i class="fa-solid fa-trash-can small"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Note Shortcuts (FR-OM-07) -->
                    <div class="d-flex flex-wrap gap-1 align-items-center mt-1">
                        <span class="note-chip" onclick="setSectionBNote(${index}, 'Less spicy')">Less spicy</span>
                        <span class="note-chip" onclick="setSectionBNote(${index}, 'No onion')">No onion</span>
                        <span class="note-chip" onclick="setSectionBNote(${index}, 'Extra spicy')">Extra spicy</span>
                        <span class="note-chip" onclick="setSectionBNote(${index}, 'Jain')">Jain</span>
                        <input type="text" class="form-control form-control-sm py-0 px-1 border-0 bg-light" style="width: 140px; font-size: 0.725rem;" 
                               placeholder="Add note..." maxlength="100" value="${item.note || ''}" onchange="updateSectionBNoteText(${index}, this.value)" />
                    </div>
                </div>
            `;
        });
        container.html(html);
    }

    function updateSectionBQty(index, delta) {
        sectionBItems[index].quantity += delta;
        if (sectionBItems[index].quantity <= 0) {
            removeSectionBItem(index);
            return;
        }
        renderSectionB();
        updateFooterTotals();
        autoSaveDraft();
    }

    function removeSectionBItem(index) {
        lastRemovedItem = { item: sectionBItems[index], index: index };
        sectionBItems.splice(index, 1);
        renderSectionB();
        updateFooterTotals();
        autoSaveDraft();

        // Show 5-second Undo Toast (FR-OM-04)
        $('#undoToastText').text(`"${lastRemovedItem.item.name}" removed.`);
        $('#undoToastContainer').fadeIn();
        if (undoTimeout) clearTimeout(undoTimeout);
        undoTimeout = setTimeout(() => {
            $('#undoToastContainer').fadeOut();
            lastRemovedItem = null;
        }, 5000);
    }

    function undoRemoveItem() {
        if (lastRemovedItem) {
            sectionBItems.splice(lastRemovedItem.index, 0, lastRemovedItem.item);
            $('#undoToastContainer').fadeOut();
            lastRemovedItem = null;
            renderSectionB();
            updateFooterTotals();
            autoSaveDraft();
        }
    }

    function setSectionBNote(index, note) {
        sectionBItems[index].note = note;
        renderSectionB();
        autoSaveDraft();
    }

    function updateSectionBNoteText(index, text) {
        sectionBItems[index].note = text;
        autoSaveDraft();
    }

    function repeatSentItem(menuItemId, name, price) {
        // FR-OM-06: Repeat adds item again to Section B in one tap
        sectionBItems.push({
            id: 0,
            menuItemId: menuItemId,
            name: name,
            price: price,
            quantity: 1,
            variantName: '',
            note: '',
            course: 'Main',
            addOns: []
        });
        renderSectionB();
        updateFooterTotals();
        autoSaveDraft();
    }

    // -------------------------------------------------------------
    // INLINE MENU CLICK HANDLER (FR-OM-02)
    // -------------------------------------------------------------
    function onMenuItemClicked(id, name, price, hasChoices, isAvailable) {
        if (!isAvailable) {
            alert(`"${name}" is currently sold out (OM-A12).`);
            return;
        }

        if (hasChoices) {
            // Open inline customization modal sheet
            $('#custMenuItemId').val(id);
            $('#custBasePrice').val(price);
            $('#customiseModalTitle').text(`Customise: ${name}`);
            $('#custSpecialNote').val('');
            $('#custComputedPrice').text(`₹${price}`);
            
            // Fetch item details for variants & add-ons
            $.get(`/Masters/GetMenuItemDetails?id=${id}`, function(res) {
                if (res && res.variants && res.variants.length > 0) {
                    let vHtml = '';
                    res.variants.forEach((v, idx) => {
                        vHtml += `
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="custVariantRadio" id="var_${v.id}" value="${v.variantName}" data-price="${v.price}" ${idx === 0 ? 'checked' : ''} onchange="updateCustComputedPrice()">
                                <label class="form-check-label small" for="var_${v.id}">${v.variantName} (₹${v.price})</label>
                            </div>
                        `;
                    });
                    $('#variantOptions').html(vHtml);
                    $('#variantSection').show();
                } else {
                    $('#variantSection').hide();
                }
                $('#customiseItemModal').modal('show');
            }).fail(function() {
                // Direct fallback if extra details endpoint not present
                addDirectToSectionB(id, name, price);
            });
        } else {
            // Immediate add to Section B (FR-OM-02)
            addDirectToSectionB(id, name, price);
        }
    }

    function addDirectToSectionB(id, name, price) {
        let existing = sectionBItems.find(i => i.menuItemId === id && !i.variantName);
        if (existing) {
            existing.quantity += 1;
        } else {
            sectionBItems.push({
                id: 0,
                menuItemId: id,
                name: name,
                price: price,
                quantity: 1,
                variantName: '',
                note: '',
                course: 'Main',
                addOns: []
            });
        }
        renderSectionB();
        updateFooterTotals();
        autoSaveDraft();
    }

    function confirmCustomisedItem() {
        let id = parseInt($('#custMenuItemId').val());
        let basePrice = parseFloat($('#custBasePrice').val());
        let variantRadio = $('input[name="custVariantRadio"]:checked');
        let variantName = variantRadio.length ? variantRadio.val() : '';
        let price = variantRadio.length ? parseFloat(variantRadio.data('price')) : basePrice;
        let course = $('input[name="custCourse"]:checked').val() || 'Main';
        let note = $('#custSpecialNote').val();
        let itemName = $('#customiseModalTitle').text().replace('Customise: ', '');

        sectionBItems.push({
            id: 0,
            menuItemId: id,
            name: itemName,
            price: price,
            quantity: 1,
            variantName: variantName,
            note: note,
            course: course,
            addOns: []
        });

        $('#customiseItemModal').modal('hide');
        renderSectionB();
        updateFooterTotals();
        autoSaveDraft();
    }

    function appendCustNote(chip) {
        let cur = $('#custSpecialNote').val();
        $('#custSpecialNote').val(cur ? cur + ', ' + chip : chip);
    }

    // -------------------------------------------------------------
    // TOTALS CALCULATION
    // -------------------------------------------------------------
    function updateFooterTotals() {
        let subtotal = 0;
        sectionAItems.forEach(i => subtotal += (i.totalPrice || (i.unitPrice * i.quantity)));
        sectionBItems.forEach(i => subtotal += (i.price * i.quantity));

        // 5% GST (2.5% CGST + 2.5% SGST)
        let totalTax = Math.round(subtotal * 0.05 * 100) / 100;
        let cgst = Math.round(subtotal * 0.025 * 100) / 100;
        let sgst = Math.round((totalTax - cgst) * 100) / 100;

        let gross = subtotal + totalTax;
        let grandTotal = Math.round(gross);
        let roundOff = Math.round((grandTotal - gross) * 100) / 100;

        $('#displaySubtotal').text('₹' + subtotal.toFixed(2));
        $('#displayCGST').text('₹' + cgst.toFixed(2));
        $('#displaySGST').text('₹' + sgst.toFixed(2));
        $('#displayRoundOff').text((roundOff >= 0 ? '+' : '') + '₹' + roundOff.toFixed(2));
        $('#displayGrandTotal').text('₹' + grandTotal.toFixed(2));
        $('#modalBillGrandTotal').text('₹' + grandTotal.toFixed(2));
    }

    // -------------------------------------------------------------
    // DRAFT AUTO-SAVE (FR-OM-10)
    // -------------------------------------------------------------
    function autoSaveDraft(isManualHold = false) {
        if (!selectedTableId && !currentOrderId) return;

        // If this order is ALREADY an active confirmed order, do not create duplicate drafts in DB!
        let isConfirmedOrder = currentOrderId > 0 && !@(isDraft.ToString().ToLower());
        if (isConfirmedOrder) {
            if (isManualHold) {
                alert("New items held in Section B. Click 'Update KOT' when ready to send to kitchen.");
            }
            return;
        }

        let mappedItems = sectionBItems.map(i => ({
            menuItemId: i.menuItemId,
            quantity: i.quantity,
            selectedVariantName: i.variantName,
            specialInstructions: i.note,
            course: i.course
        }));

        let payload = {
            orderId: currentOrderId > 0 ? currentOrderId : null,
            tableId: selectedTableId ? parseInt(selectedTableId) : null,
            covers: parseInt($('#coversInput').val()) || 2,
            orderNote: $('#orderNoteInput').val(),
            userName: $('#waiterInput').val(),
            items: mappedItems
        };

        $.ajax({
            url: '/Orders/SaveDraft',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function(res) {
                if (res.success && res.draftId) {
                    currentOrderId = res.draftId;
                    if (isManualHold) {
                        alert("Order saved as Draft. Table remains Available until Send KOT.");
                    }
                }
            }
        });
    }

    // -------------------------------------------------------------
    // SEND KOT / UPDATE KOT (FR-ORD-11, OM-B01)
    // -------------------------------------------------------------
    function onSendKOTClicked() {
        // Validation: table must be selected for dine-in orders
        if (!selectedTableId && !currentOrderId) {
            alert('Please select a table before sending KOT. Go back and select a table from the dashboard.');
            return;
        }

        if (sectionBItems.length === 0) {
            alert('Section B is empty. Please add at least one item before sending KOT (FR-ORD-11, OM-A16).');
            return;
        }

        let covers = parseInt($('#coversInput').val()) || 1;
        if (covers < 1) {
            alert('Covers must be at least 1.');
            $('#coversInput').val(1);
            covers = 1;
        }
        let tableCap = @tableCapacity;
        if (covers > tableCap) {
            alert(`Covers (${covers}) cannot exceed table capacity (${tableCap}) (OM-A10).`);
            return;
        }

        let waiterName = $('#waiterInput').val().trim();
        if (!waiterName) {
            alert('Waiter name is required before sending KOT.');
            return;
        }

        let mappedItems = sectionBItems.map(i => ({
            menuItemId: i.menuItemId,
            quantity: i.quantity,
            selectedVariantName: i.variantName,
            specialInstructions: i.note,
            course: i.course
        }));

        let payload = {
            orderId: currentOrderId > 0 ? currentOrderId : 0,
            tableId: selectedTableId ? parseInt(selectedTableId) : null,
            covers: covers,
            orderNote: $('#orderNoteInput').val(),
            waiterName: $('#waiterInput').val(),
            newItems: mappedItems,
            items: mappedItems
        };

        $('#sendKotBtn').prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin"></i> Sending...');

        $.ajax({
            url: '/Orders/SendKOT',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function(res) {
                if (res.success) {
                    let targetOrderId = res.orderId || (res.order ? res.order.id : currentOrderId);
                    alert(`KOT generated successfully: ${res.kotNumber}`);
                    if (selectedTableId) {
                        window.location.href = `/Orders/POS?tableId=${selectedTableId}&orderId=${targetOrderId}&returnUrl=@returnUrl`;
                    } else {
                        window.location.href = `/Orders/POS?orderId=${targetOrderId}&returnUrl=@returnUrl`;
                    }
                } else {
                    alert(res.message || "Failed to send KOT");
                    $('#sendKotBtn').prop('disabled', false).html('<i class="fa-solid fa-paper-plane text-danger"></i> Send KOT');
                }
            },
            error: function() {
                alert("Network or server error while sending KOT.");
                $('#sendKotBtn').prop('disabled', false).html('<i class="fa-solid fa-paper-plane text-danger"></i> Send KOT');
            }
        });
    }

    // -------------------------------------------------------------
    // REDUCE / CANCEL ITEM MODAL & ACTIONS
    // -------------------------------------------------------------
    function openReduceModal(itemId, itemName, currentQty, status) {
        $('#reduceOrderItemId').val(itemId);
        $('#reduceItemName').text(itemName);
        $('#reduceItemCurrentQty').text(currentQty);
        $('#reduceQtyInput').val(1).attr('max', currentQty);
        $('#reduceReasonInput').val('');
        $('#informedKitchenCheckbox').prop('checked', false);
        $('#reduceManagerPin').val('');
        $('#informedKitchenCheckGroup').hide();

        // Show Manager PIN if Preparing, Ready, or Served
        if (status >= 2) {
            $('#managerPinGroup').show();
        } else {
            $('#managerPinGroup').show();
        }

        $('#reduceItemModal').modal('show');
    }

    function submitReduceItem() {
        let itemId = parseInt($('#reduceOrderItemId').val());
        let qty = parseInt($('#reduceQtyInput').val());
        let reason = $('#reduceReasonInput').val();
        let pin = $('#reduceManagerPin').val();

        if (!reason || reason.trim().length === 0) {
            alert("A reason is mandatory for item reduction or cancellation.");
            return;
        }

        let payload = {
            orderId: currentOrderId,
            orderItemId: itemId,
            reduceByQuantity: qty,
            reason: reason,
            informedKitchen: informed,
            managerPin: pin
        };

        $.ajax({
            url: '/Orders/ReduceItem',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function(res) {
                if (res.success) {
                    $('#reduceItemModal').modal('hide');
                    alert("Item reduced. Cancel slip printed.");
                    window.location.reload();
                } else {
                    alert(res.message || "Reduction rejected.");
                }
            }
        });
    }

    // -------------------------------------------------------------
    // NOTE CHANGE ON SENT ITEM (OM-B09)
    // -------------------------------------------------------------
    function openChangeNoteModal(itemId, currentNote) {
        $('#changeNoteItemId').val(itemId);
        $('#changeNoteInput').val(currentNote);
        $('#changeNoteModal').modal('show');
    }

    function submitChangeNote() {
        let itemId = parseInt($('#changeNoteItemId').val());
        let newNote = $('#changeNoteInput').val();

        $.ajax({
            url: '/Orders/ChangeItemNote',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                orderId: currentOrderId,
                orderItemId: itemId,
                newNote: newNote
            }),
            success: function(res) {
                if (res.success) {
                    $('#changeNoteModal').modal('hide');
                    alert("Note changed. NOTE CHANGE slip generated.");
                    window.location.reload();
                } else {
                    alert(res.message || "Failed to change note.");
                }
            }
        });
    }

    // -------------------------------------------------------------
    // EDIT ITEM / KOT (QUANTITY & SPECIAL INSTRUCTIONS)
    // -------------------------------------------------------------
    function openEditItemModal(itemId, itemName, currentQty, currentNote) {
        $('#editOrderItemId').val(itemId);
        $('#editItemNameDisplay').val(itemName);
        $('#editItemQtyInput').val(currentQty);
        $('#editItemInstructionsInput').val(currentNote);
        $('#editItemModal').modal('show');
    }

    function saveEditedItem() {
        let itemId = parseInt($('#editOrderItemId').val());
        let qty = parseInt($('#editItemQtyInput').val());
        let note = $('#editItemInstructionsInput').val();

        if (!qty || qty < 1) {
            alert("Quantity must be at least 1.");
            return;
        }

        $('#saveEditedItemBtn').prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Saving...');

        $.ajax({
            url: '/Orders/UpdateOrderItem',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                orderItemId: itemId,
                quantity: qty,
                specialInstructions: note
            }),
            success: function(res) {
                if (res.success) {
                    $('#editItemModal').modal('hide');
                    let item = sectionAItems.find(i => i.id === itemId);
                    if (item) {
                        item.quantity = qty;
                        item.specialInstructions = note;
                        item.totalPrice = item.unitPrice * qty;
                    }
                    renderSectionA();
                    updateFooterTotals();
                    alert("KOT Item updated successfully!");
                } else {
                    alert(res.message || "Failed to update item.");
                }
                $('#saveEditedItemBtn').prop('disabled', false).html('Save Changes');
            },
            error: function() {
                alert("Network error while updating item.");
                $('#saveEditedItemBtn').prop('disabled', false).html('Save Changes');
            }
        });
    }

    function markItemStatus(itemId, newStatus) {
        $.ajax({
            url: '/Orders/UpdateItemStatus',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                orderId: currentOrderId,
                orderItemId: itemId,
                status: newStatus
            }),
            success: function(res) {
                if (res.success) {
                    window.location.reload();
                } else {
                    alert(res.message);
                }
            }
        });
    }

    function showEstimateSlip() {
        alert("Estimate Slip (OM-A22):\nTable: @(selectedTable?.TableNumber ?? "NA")\nSubtotal: " + $('#displaySubtotal').text() + "\nTax: " + $('#displayCGST').text() + " + " + $('#displaySGST').text() + "\nPayable: " + $('#displayGrandTotal').text() + "\n* Unofficial Estimate Slip *");
    }

    function showCounterKOTSlip() {
        let text = "KOT SLIP (Counter Copy)\nTable: @(selectedTable?.TableNumber ?? "NA")\nItems:\n";
        sectionAItems.forEach(i => text += `${i.quantity}x ${i.itemName}\n`);
        alert(text);
    }

    function filterMenuCatalog() {
        let q = $('#catalogSearch').val().toLowerCase();
        $('.menu-item-row').each(function() {
            let name = $(this).data('name') || '';
            $(this).toggle(name.includes(q));
        });
    }

    function filterVeg(type, btn) {
        $('.veg-pill').removeClass('active');
        $(btn).addClass('active');
        $('.menu-item-row').each(function() {
            let v = $(this).data('veg');
            if (type === 'all') $(this).show();
            else $(this).toggle(v === type);
        });
    }

    function filterCategory(catId, btn) {
        $('.cat-btn').removeClass('active btn-primary').addClass('btn-outline-secondary');
        $(btn).removeClass('btn-outline-secondary').addClass('active btn-primary');
        $('.menu-item-row').each(function() {
            let c = parseInt($(this).data('cat'));
            if (catId === 0) $(this).show();
            else $(this).toggle(c === catId);
        });
    }

    function onCoversChange() {
        let covers = parseInt($('#coversInput').val());
        let cap = @tableCapacity;
        if (covers > cap) {
            alert(`Covers (${covers}) cannot exceed table capacity (${cap}) (OM-A10).`);
            $('#coversInput').val(cap);
        }
        autoSaveDraft();
    }

    function startTimer() {
        let minutes = 0;
        setInterval(() => {
            minutes++;
            $('#elapsedMinutes').text(minutes);
        }, 60000);
    }
</script>
}
