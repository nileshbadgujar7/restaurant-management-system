@model InventoryViewModel
@{
    ViewData["Title"] = "Stock & Inventory Management";
    string activeTab = Model.ActiveTab;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 animated-fade-in">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 fs-6">
                <li class="breadcrumb-item">
                    <a href="/Dashboard" class="text-decoration-none fw-semibold text-success">
                        <i class="fa-solid fa-chart-pie me-1"></i> Dashboard
                    </a>
                </li>
                <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">
                    <i class="fa-solid fa-boxes-stacked text-info me-1"></i> Stock & Inventory
                </li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-boxes-stacked text-info me-2"></i>Stock & Inventory Management
        </h2>
        <div class="text-muted small mt-1">
            Raw materials, purchase receipts (Stock In), kitchen consumption & wastage (Stock Out), live ledger
        </div>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-success rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#quickStockInModal">
            <i class="fa-solid fa-arrow-down me-1"></i> Stock In (Purchase)
        </button>
        <button class="btn btn-outline-danger rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#quickStockOutModal">
            <i class="fa-solid fa-arrow-up me-1"></i> Stock Out (Usage/Wastage)
        </button>
        <button class="btn btn-outline-dark rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#createItemModal">
            <i class="fa-solid fa-plus me-1"></i> New Item
        </button>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Inventory KPI Cards -->
<div class="row g-3 mb-4 animated-fade-in">
    <div class="col-xl-3 col-md-6 col-12">
        <div class="glass-card p-3 p-xl-4 h-100 border-start border-4 border-success">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Total Stock Asset Value</div>
                    <div class="fs-3 fw-bold text-success mt-1">₹@Model.TotalInventoryValue.ToString("N0")</div>
                    <div class="small text-muted mt-1">Current Stock Valuation</div>
                </div>
                <div class="p-3 bg-success-subtle text-success rounded-circle">
                    <i class="fa-solid fa-vault fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12">
        <div class="glass-card p-3 p-xl-4 h-100 border-start border-4 border-info">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Total Inventory Items</div>
                    <div class="fs-3 fw-bold text-info mt-1">@Model.TotalItemsCount</div>
                    <div class="small text-muted mt-1">Managed Raw Ingredients</div>
                </div>
                <div class="p-3 bg-info-subtle text-info rounded-circle">
                    <i class="fa-solid fa-cubes fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12">
        <div class="glass-card p-3 p-xl-4 h-100 border-start border-4 border-warning">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Low Stock Reorders</div>
                    <div class="fs-3 fw-bold text-warning mt-1">@Model.LowStockCount</div>
                    <div class="small text-muted mt-1">@Model.CriticalStockCount at critical alert</div>
                </div>
                <div class="p-3 bg-warning-subtle text-warning rounded-circle">
                    <i class="fa-solid fa-triangle-exclamation fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12">
        <div class="glass-card p-3 p-xl-4 h-100 border-start border-4 border-primary">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Stock Transactions Today</div>
                    <div class="fs-3 fw-bold text-primary mt-1">@Model.MovementsTodayCount</div>
                    <div class="small text-muted mt-1">In, Out & Auto deductions</div>
                </div>
                <div class="p-3 bg-primary-subtle text-primary rounded-circle">
                    <i class="fa-solid fa-clock-rotate-left fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Tabs -->
<div class="glass-card p-4 animated-fade-in shadow-sm">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 border-bottom pb-3 mb-4">
        <ul class="nav nav-pills gap-2" id="inventoryTabs" role="tablist">
            <li class="nav-item">
                <a class="nav-link rounded-pill px-4 fw-bold @(activeTab == "stock" ? "active bg-info text-white shadow-sm" : "text-dark bg-light")" 
                   href="/Inventory?tab=stock">
                    <i class="fa-solid fa-boxes-stacked me-2"></i> Current Stock Balances
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link rounded-pill px-4 fw-bold @(activeTab == "history" ? "active bg-info text-white shadow-sm" : "text-dark bg-light")" 
                   href="/Inventory?tab=history">
                    <i class="fa-solid fa-list-check me-2"></i> Stock Movement Ledger
                </a>
            </li>
        </ul>

        @if (activeTab == "stock")
        {
            <div class="d-flex align-items-center gap-2">
                <input type="text" id="inventorySearch" class="form-control form-control-sm rounded-pill" placeholder="🔍 Search ingredient or category..." style="width: 250px;" onkeyup="filterInventoryTable()" />
            </div>
        }
    </div>

    <!-- Tab 1: Current Stock List -->
    @if (activeTab == "stock")
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="inventoryTable">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th>Ingredient Item</th>
                        <th>Category</th>
                        <th>Current Stock</th>
                        <th>Min Reorder Level</th>
                        <th>Est. Cost Rate</th>
                        <th>Total Asset Value</th>
                        <th>Stock Health</th>
                        <th class="text-end">Quick Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        decimal itemValue = item.CurrentStock * item.UnitCost;
                        <tr class="inv-row" data-name="@item.Name.ToLower()" data-category="@item.Category.ToLower()">
                            <td>
                                <div class="fw-bold text-dark fs-6">@item.Name</div>
                                <div class="small text-muted">ID: #@item.Id</div>
                            </td>
                            <td>
                                <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill px-3 py-1">
                                    @item.Category
                                </span>
                            </td>
                            <td class="fw-bold fs-6 @(item.IsLowStock ? "text-danger" : "text-success")">
                                @item.CurrentStock @item.Unit
                            </td>
                            <td class="small text-secondary">
                                @item.MinimumStock @item.Unit
                            </td>
                            <td class="text-dark small">
                                ₹@item.UnitCost.ToString("N0") / @item.Unit
                            </td>
                            <td class="fw-semibold text-dark">
                                ₹@itemValue.ToString("N0")
                            </td>
                            <td>
                                @if (item.CurrentStock <= (item.MinimumStock / 2m))
                                {
                                    <span class="badge bg-danger px-3 py-1 rounded-pill"><i class="fa-solid fa-circle-exclamation me-1"></i> Critical</span>
                                }
                                else if (item.IsLowStock)
                                {
                                    <span class="badge bg-warning text-dark px-3 py-1 rounded-pill"><i class="fa-solid fa-triangle-exclamation me-1"></i> Low Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1"><i class="fa-solid fa-circle-check me-1"></i> Optimal</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-success rounded-pill px-2 me-1" 
                                        onclick="openSingleStockIn('@item.Id', '@item.Name', '@item.Unit')" title="Stock In / Purchase">
                                    <i class="fa-solid fa-plus me-1"></i> In
                                </button>
                                <button class="btn btn-sm btn-outline-danger rounded-pill px-2" 
                                        onclick="openSingleStockOut('@item.Id', '@item.Name', '@item.Unit', '@item.CurrentStock')" title="Stock Out / Usage">
                                    <i class="fa-solid fa-minus me-1"></i> Out
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- Tab 2: Stock Movement Ledger -->
    @if (activeTab == "history")
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th>Date & Time</th>
                        <th>Ingredient</th>
                        <th>Type</th>
                        <th class="text-center">Quantity</th>
                        <th>Reason / Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.MovementLogs.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-receipt fs-2 d-block mb-2 text-secondary opacity-50"></i>
                                <p class="small mb-0">No stock movements recorded yet.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in Model.MovementLogs)
                        {
                            string badgeClass = log.TransactionType switch
                            {
                                "IN" => "bg-success-subtle text-success border border-success-subtle",
                                "OUT" => "bg-danger-subtle text-danger border border-danger-subtle",
                                "WASTAGE" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
                                "RECIPE_DEDUCTION" => "bg-info-subtle text-info border border-info-subtle",
                                _ => "bg-secondary-subtle text-dark"
                            };
                            <tr>
                                <td class="small fw-semibold text-secondary">@log.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                                <td>
                                    <div class="fw-bold text-dark">@log.ItemName</div>
                                    <div class="small text-muted">@log.Category</div>
                                </td>
                                <td><span class="badge rounded-pill @badgeClass" style="font-size:0.75rem;">@log.TransactionType</span></td>
                                <td class="text-center fw-bold @(log.TransactionType == "IN" ? "text-success" : "text-danger")">
                                    @(log.TransactionType == "IN" ? "+" : "-")@log.Quantity @log.Unit
                                </td>
                                <td class="text-dark small">@log.Notes</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal 1: Quick Stock In (Purchase / Receive) -->
<div class="modal fade" id="quickStockInModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="StockIn" method="post" class="modal-content rounded-4 border-0 shadow-lg text-start">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-arrow-down text-success me-2"></i>Stock In (Receive / Purchase)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold small">Select Ingredient Item</label>
                    <select name="inventoryItemId" id="stockInItemSelect" class="form-select" required>
                        @foreach (var item in Model.Items)
                        {
                            <option value="@item.Id">@item.Name (@item.Category) - Current: @item.CurrentStock @item.Unit</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Quantity to Add</label>
                    <input type="number" step="0.01" min="0.01" name="quantity" class="form-control" placeholder="e.g. 10.5" required />
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-bold small">Supplier / Vendor</label>
                        <input type="text" name="supplier" class="form-control" placeholder="e.g. Metro Cash & Carry" />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-bold small">Invoice # / Challan</label>
                        <input type="text" name="invoiceNo" class="form-control" placeholder="e.g. INV-8821" />
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label fw-bold small">Notes</label>
                    <input type="text" name="notes" class="form-control" placeholder="e.g. Fresh vegetable delivery" />
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-success rounded-pill px-4">Add to Stock</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal 2: Quick Stock Out (Usage / Wastage) -->
<div class="modal fade" id="quickStockOutModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="StockOut" method="post" class="modal-content rounded-4 border-0 shadow-lg text-start">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-arrow-up text-danger me-2"></i>Stock Out (Usage / Wastage)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold small">Select Ingredient Item</label>
                    <select name="inventoryItemId" id="stockOutItemSelect" class="form-select" required>
                        @foreach (var item in Model.Items)
                        {
                            <option value="@item.Id">@item.Name (@item.Category) - Current: @item.CurrentStock @item.Unit</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Quantity to Deduct</label>
                    <input type="number" step="0.01" min="0.01" name="quantity" class="form-control" placeholder="e.g. 5" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Reason</label>
                    <select name="reason" class="form-select" required>
                        <option value="Kitchen Consumption">Kitchen Consumption / Prep</option>
                        <option value="Wastage">Wastage / Scrap</option>
                        <option value="Spoilage">Spoilage / Rotten</option>
                        <option value="Damaged">Damaged / Broken</option>
                        <option value="Expired">Expired Stock</option>
                        <option value="Inventory Adjustment">Physical Audit Adjustment</option>
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label fw-bold small">Notes / Explanation</label>
                    <input type="text" name="notes" class="form-control" placeholder="e.g. Discarded due to milk curdling" />
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger rounded-pill px-4">Deduct from Stock</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal 3: New Inventory Item -->
<div class="modal fade" id="createItemModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="CreateItem" method="post" class="modal-content rounded-4 border-0 shadow-lg text-start">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-plus text-primary me-2"></i>Add New Inventory Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold small">Item Name</label>
                    <input type="text" name="Name" class="form-control" placeholder="e.g. Amul Butter" required />
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-bold small">Category</label>
                        <select name="Category" class="form-select">
                            <option value="Dairy">Dairy</option>
                            <option value="Vegetables">Vegetables</option>
                            <option value="Grocery">Grocery</option>
                            <option value="Spices">Spices & Condiments</option>
                            <option value="Meat & Poultry">Meat & Poultry</option>
                            <option value="Beverages">Beverages / Syrups</option>
                            <option value="Packaging">Packaging & Disposables</option>
                            <option value="Cleaning">Cleaning & Hygiene</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-bold small">Measurement Unit</label>
                        <select name="Unit" class="form-select">
                            <option value="KG">KG (Kilogram)</option>
                            <option value="L">L (Litre)</option>
                            <option value="Pcs">Pcs (Pieces)</option>
                            <option value="Gm">Gm (Grams)</option>
                            <option value="Ml">Ml (Millilitres)</option>
                            <option value="Boxes">Boxes</option>
                            <option value="Packets">Packets</option>
                        </select>
                    </div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-bold small">Opening Stock</label>
                        <input type="number" step="0.01" min="0" name="CurrentStock" class="form-control" value="0" />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-bold small">Minimum Alert Level</label>
                        <input type="number" step="0.01" min="0" name="MinimumStock" class="form-control" value="10" required />
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label fw-bold small">Unit Purchase Cost (₹)</label>
                    <input type="number" step="0.5" min="0" name="UnitCost" class="form-control" placeholder="e.g. 240" required />
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary rounded-pill px-4">Save Ingredient</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function openSingleStockIn(itemId, itemName, unit) {
        $('#stockInItemSelect').val(itemId);
        var modal = new bootstrap.Modal(document.getElementById('quickStockInModal'));
        modal.show();
    }

    function openSingleStockOut(itemId, itemName, unit, curStock) {
        $('#stockOutItemSelect').val(itemId);
        var modal = new bootstrap.Modal(document.getElementById('quickStockOutModal'));
        modal.show();
    }

    function filterInventoryTable() {
        let q = ($('#inventorySearch').val() || '').toLowerCase().trim();
        $('.inv-row').each(function() {
            let name = $(this).data('name') || '';
            let cat = $(this).data('category') || '';
            if (name.includes(q) || cat.includes(q)) {
                $(this).show();
            } else {
                $(this).hide();
            }
        });
    }
</script>
}
