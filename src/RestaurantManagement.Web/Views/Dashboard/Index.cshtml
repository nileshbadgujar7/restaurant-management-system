<!-- Row 5: Sales Overview Area Chart (8 cols) & Inventory Alerts (4 cols) -->
<div class="row g-4 mb-4 anim-section anim-delay-5">
    <!-- Left Column: Sales Overview Area Trend -->
    <div class="col-lg-8">
        <div class="dashboard-widget-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark">@(isMarathi ? "विक्री आढावा" : "Sales Overview")</h5>
                <span class="badge rounded-pill bg-light text-muted border" style="font-size: 0.7rem;">@(isMarathi ? "मागील ७ दिवस" : "Last 7 days")</span>
            </div>

            <div style="height: 220px; width: 100%;">
                <canvas id="salesOverviewAreaChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Right Column: Inventory Alerts -->
    <div class="col-lg-4">
        <div class="dashboard-widget-card h-100">
            <h5 class="fw-bold mb-3 text-dark">@(isMarathi ? "साठा सूचना (Alerts)" : "Inventory Alerts")</h5>

            <div class="d-flex flex-column gap-3 mt-1">
                @if (Model.LowStockAlerts != null && Model.LowStockAlerts.Any())
                {
                    @foreach (var alert in Model.LowStockAlerts)
                    {
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold text-dark small">@alert.ItemName</span>
                                <span class="text-muted small"> : @alert.CurrentStock @alert.Unit</span>
                            </div>
                            <span class="badge rounded-pill" style="@(alert.AlertLevel == "Critical" ? "background: #fee2e2; color: #dc2626;" : "background: #fef3c7; color: #b45309;") font-size: 0.7rem; font-weight: 600;">
                                @alert.AlertLevel
                            </span>
