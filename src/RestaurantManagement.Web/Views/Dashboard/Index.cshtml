                </a>
                <a href="/Reports" class="btn text-white quick-action-btn-styled" style="background-color: #1d4ed8;">
                    <i class="fa-solid fa-square-poll-vertical"></i> @(isMarathi ? "सर्व अहवाल पहा" : "View Reports")
                </a>
                <button onclick="openParcelModal()" class="btn text-white quick-action-btn-styled" style="background-color: #0f766e;">
