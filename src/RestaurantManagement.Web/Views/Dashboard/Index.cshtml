                    <i class="fa-solid fa-plus"></i> @(isMarathi ? "नवीन मेनू आयटम" : "Add Menu Item")
                </a>
                <a href="/Masters?tab=employee&openAdd=true&returnUrl=/Dashboard" class="btn text-white quick-action-btn-styled" style="background-color: #6d28d9;">
