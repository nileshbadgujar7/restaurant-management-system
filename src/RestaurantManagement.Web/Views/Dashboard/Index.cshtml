<!-- Parcel Order Modal -->
<div class="modal fade" id="parcelModal" tabindex="-1" aria-labelledby="parcelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 shadow-lg border-0">
            <div class="modal-header border-0 pb-0" style="background: linear-gradient(135deg,#0f766e,#14b8a6); border-radius: 1rem 1rem 0 0;">
                <h5 class="modal-title fw-bold text-white" id="parcelModalLabel">
                    <i class="fa-solid fa-box-open me-2"></i>New Parcel / Takeaway Order
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3">
                    <!-- Customer Details -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-secondary">Customer Name <span class="text-danger">*</span></label>
                        <input type="text" id="parcelCustomerName" class="form-control" placeholder="Enter customer name" maxlength="100" />
                        <div class="invalid-feedback" id="parcelCustomerNameError">Customer name is required.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-secondary">Phone Number <span class="text-danger">*</span></label>
                        <input type="tel" id="parcelCustomerPhone" class="form-control" placeholder="10-digit mobile number" maxlength="15" />
                        <div class="invalid-feedback" id="parcelCustomerPhoneError">Valid phone number is required.</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold small text-secondary">Order Note</label>
                        <input type="text" id="parcelOrderNote" class="form-control" placeholder="Special instructions (optional)" maxlength="250" />
                    </div>
                </div>

                <hr class="my-3" />

                <!-- Menu Items -->
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold small text-secondary text-uppercase" style="letter-spacing:0.5px;"><i class="fa-solid fa-utensils text-success me-1"></i>Add Items</span>
                    <span class="badge bg-primary-subtle text-primary rounded-pill small" id="parcelItemCount">0 Items</span>
                </div>
                <div class="input-group input-group-sm mb-2" style="max-width:300px;">
                    <span class="input-group-text bg-light"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" id="parcelMenuSearch" class="form-control" placeholder="Search dish..." onkeyup="filterParcelMenu()" />
                </div>
                <div class="border rounded-3 mb-3" style="max-height:220px; overflow-y:auto;" id="parcelMenuList">
                    <div class="text-center py-3 text-muted small"><i class="fa-solid fa-spinner fa-spin"></i> Loading menu...</div>
                </div>

                <!-- Selected Items -->
                <div id="parcelSelectedItems">
                    <div class="text-center py-3 text-muted small border rounded-3 bg-light" id="parcelEmptyItems">
                        <i class="fa-solid fa-cart-shopping fs-4 text-secondary opacity-50 mb-1"></i><br>
                        Tap any dish above to add it here.
                    </div>
                </div>

                <!-- Totals -->
                <div class="row g-1 mt-3 small text-secondary" id="parcelTotalsRow" style="display:none;">
                    <div class="col-6 d-flex justify-content-between"><span>Subtotal:</span><strong class="text-dark" id="parcelSubtotal">₹0.00</strong></div>
                    <div class="col-6 d-flex justify-content-between"><span>GST (5%):</span><strong class="text-dark" id="parcelTax">₹0.00</strong></div>
                    <div class="col-12 border-top pt-1 mt-1 d-flex justify-content-between align-items-center fs-5 fw-bold text-dark">
                        <span>Grand Total:</span><span class="text-success" id="parcelGrandTotal">₹0.00</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn text-white fw-bold rounded-pill px-4 shadow-sm" style="background:#0f766e;" onclick="submitParcelOrder()" id="parcelSubmitBtn">
                    <i class="fa-solid fa-paper-plane me-1"></i> Send KOT & Create Parcel
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // 1. Live Clock for Header
        function updateHeaderClock() {
            const now = new Date();
            const elem = document.getElementById('headerClockDate');
            if (elem) {
                const dateStr = now.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: '2-digit', year: 'numeric' });
                const timeStr = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });
                elem.textContent = `${dateStr} - ${timeStr}`;
            }
        }
        setInterval(updateHeaderClock, 1000);
        updateHeaderClock();

        // 2. Order Status Donut Chart
        const donutCtx = document.getElementById('orderStatusDonutChart');
        if (donutCtx) {
            const counts = [@Model.NewOrdersCount, @Model.PreparingOrdersCount, @Model.ReadyOrdersCount, @Model.ServedOrdersCount, @Model.CancelledOrdersCount];
            const hasOrders = counts.some(c => c > 0);
            new Chart(donutCtx, {
                type: 'doughnut',
                data: {
                    labels: ['New', 'Preparing', 'Ready', 'Served', 'Cancelled'],
                    datasets: [{
                        data: hasOrders ? counts : [0, 0, 0, 0, 0],
                        backgroundColor: ['#3b82f6', '#f59e0b', '#10b981', '#8b5cf6', '#ef4444'],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '72%',
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return ` ${context.label}: ${context.raw} orders`;
                                }
                            }
                        }
                    }
                }
            });
        }

        // 3. Employee Attendance Double Bar Chart
        const barCtx = document.getElementById('employeeAttendanceBarChart');
        if (barCtx) {
            const staffLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StaffRoleAttendance.Select(s => s.RoleName)));
            const staffPresent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StaffRoleAttendance.Select(s => s.PresentCount)));
            const staffTotal = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StaffRoleAttendance.Select(s => s.TotalCount)));

            new Chart(barCtx, {
                type: 'bar',
                data: {
                    labels: staffLabels.length ? staffLabels : ['Managers', 'Chefs / Cooks', 'Waiters', 'Housekeeping', 'Cashiers'],
                    datasets: [
                        {
                            label: 'On duty (present)',
                            data: staffPresent.length ? staffPresent : [1, 2, 2, 2, 1],
                            backgroundColor: '#10b981',
                            borderRadius: 3,
                            barThickness: 16,
                            maxBarThickness: 18,
                            barPercentage: 0.5,
                            categoryPercentage: 0.6
                        },
                        {
                            label: 'Total registered staff',
                            data: staffTotal.length ? staffTotal : [1, 2, 2, 2, 1],
                            backgroundColor: '#cbd5e1',
                            borderRadius: 3,
                            barThickness: 16,
                            maxBarThickness: 18,
                            barPercentage: 0.5,
                            categoryPercentage: 0.6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { font: { weight: '600', size: 11 } }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1, precision: 0 },
                            grid: { color: '#f1f5f9' }
                        }
                    }
                }
            });
        }

        // 4. Sales Overview Smooth Green Area Chart
        const areaCtx = document.getElementById('salesOverviewAreaChart');
        if (areaCtx) {
            const trendLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklySalesTrend.Select(w => w.Date.ToString("MMM dd"))));
            const trendData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklySalesTrend.Select(w => w.SalesAmount)));

            new Chart(areaCtx, {
                type: 'line',
                data: {
                    labels: trendLabels,
                    datasets: [{
                        label: 'Sales Revenue',
                        data: trendData,
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.14)',
                        fill: true,
                        tension: 0.35,
                        borderWidth: 2.5,
                        pointBackgroundColor: '#ffffff',
                        pointBorderColor: '#10b981',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return ' ₹' + Number(context.raw).toLocaleString();
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { font: { weight: '500', size: 11 } }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(val) {
                                    return val === 0 ? '₹0' : '₹' + Number(val).toLocaleString();
                                }
                            },
                            grid: { color: '#f1f5f9' }
                        }
                    }
                }
            });
        }
    });

    // =============================
    // PARCEL ORDER FUNCTIONALITY
    // =============================
    let parcelMenuItems = [];
    let parcelCart = [];

    function openParcelModal() {
        parcelCart = [];
        $('#parcelCustomerName').val('').removeClass('is-invalid is-valid');
        $('#parcelCustomerPhone').val('').removeClass('is-invalid is-valid');
        $('#parcelOrderNote').val('');
        renderParcelCart();
        loadParcelMenu();
        var modal = new bootstrap.Modal(document.getElementById('parcelModal'));
        modal.show();
    }

    function loadParcelMenu() {
        if (parcelMenuItems.length > 0) {
            renderParcelMenuList();
            return;
        }
        $.get('/Masters/GetMenuItems', function(res) {
            if (res && res.items) {
                parcelMenuItems = res.items.filter(i => i.isAvailable);
            } else if (Array.isArray(res)) {
                parcelMenuItems = res.filter(i => i.isAvailable);
            } else {
                parcelMenuItems = [];
            }
            renderParcelMenuList();
        }).fail(function() {
            $('#parcelMenuList').html('<div class="text-center py-3 text-muted small"><i class="fa-solid fa-triangle-exclamation text-warning me-1"></i>Could not load menu. Please try again.</div>');
        });
    }

    function filterParcelMenu() {
        let q = $('#parcelMenuSearch').val().toLowerCase();
        $('#parcelMenuList .parcel-menu-item').each(function() {
            let name = $(this).data('name') || '';
            $(this).toggle(name.includes(q));
        });
    }

    function renderParcelMenuList() {
        if (!parcelMenuItems.length) {
            $('#parcelMenuList').html('<div class="text-center py-3 text-muted small">No menu items available.</div>');
            return;
        }
        let html = '<div class="list-group list-group-flush">';
        parcelMenuItems.forEach(item => {
            html += `
                <div class="list-group-item list-group-item-action parcel-menu-item d-flex justify-content-between align-items-center py-2 px-3"
                     data-name="${(item.name||'').toLowerCase()}" style="cursor:pointer;" onclick="addToParcelCart(${item.id},'${(item.name||'').replace(/'/g,"\\'")}}',${item.price})">
                    <div>
                        <span class="fw-bold text-dark small">${item.name}</span>
                        <span class="badge bg-light text-secondary border ms-1 small">${item.categoryName||''}</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold text-success small">₹${item.price}</span>
                        <button class="btn btn-sm btn-outline-primary rounded-pill px-2 py-0" title="Add">
                            <i class="fa-solid fa-plus"></i>
                        </button>
                    </div>
                </div>`;
        });
        html += '</div>';
        $('#parcelMenuList').html(html);
    }

    function addToParcelCart(id, name, price) {
        let existing = parcelCart.find(i => i.id === id);
        if (existing) {
            existing.qty++;
        } else {
            parcelCart.push({ id: id, name: name, price: price, qty: 1, note: '' });
        }
        renderParcelCart();
    }

    function updateParcelQty(idx, delta) {
        parcelCart[idx].qty += delta;
        if (parcelCart[idx].qty <= 0) {
            parcelCart.splice(idx, 1);
        }
        renderParcelCart();
    }

    function renderParcelCart() {
        let container = $('#parcelSelectedItems');
        let countBadge = $('#parcelItemCount');
        countBadge.text(parcelCart.length + ' Items');

        if (!parcelCart.length) {
            container.html(`<div class="text-center py-3 text-muted small border rounded-3 bg-light" id="parcelEmptyItems">
                <i class="fa-solid fa-cart-shopping fs-4 text-secondary opacity-50 mb-1"></i><br>Tap any dish above to add it here.</div>`);
            $('#parcelTotalsRow').hide();
            return;
        }

        let html = '<div class="list-group list-group-flush border rounded-3">';
        parcelCart.forEach((item, idx) => {
            html += `
                <div class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                    <div style="flex:1; min-width:0;">
                        <span class="fw-bold text-dark small">${item.name}</span>
                        <input type="text" class="form-control form-control-sm mt-1 py-0 px-1 bg-light border-0" style="width:160px;font-size:0.72rem;"
                               placeholder="Add note (optional)" value="${item.note||''}" maxlength="100"
                               onchange="parcelCart[${idx}].note=this.value" />
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <button class="btn btn-outline-secondary btn-sm px-2 py-0 rounded-circle" onclick="updateParcelQty(${idx},-1)">-</button>
                        <span class="fw-bold px-1 small">${item.qty}</span>
                        <button class="btn btn-outline-secondary btn-sm px-2 py-0 rounded-circle" onclick="updateParcelQty(${idx},1)">+</button>
                        <span class="fw-bold text-success ms-2 small">₹${(item.price*item.qty).toFixed(0)}</span>
                        <button class="btn btn-link text-danger p-0 ms-1" onclick="parcelCart.splice(${idx},1);renderParcelCart()" title="Remove">
                            <i class="fa-solid fa-trash-can small"></i>
                        </button>
                    </div>
                </div>`;
        });
        html += '</div>';
        container.html(html);

        // Update totals
        let subtotal = parcelCart.reduce((s,i) => s + i.price * i.qty, 0);
        let tax = Math.round(subtotal * 0.05 * 100) / 100;
        let grand = Math.round(subtotal + tax);
        $('#parcelSubtotal').text('₹' + subtotal.toFixed(2));
        $('#parcelTax').text('₹' + tax.toFixed(2));
        $('#parcelGrandTotal').text('₹' + grand.toFixed(2));
        $('#parcelTotalsRow').show();
    }

    function submitParcelOrder() {
        // Validations
        let isValid = true;
        let name = $('#parcelCustomerName').val().trim();
        let phone = $('#parcelCustomerPhone').val().trim();

        if (!name) {
            $('#parcelCustomerName').addClass('is-invalid');
            isValid = false;
        } else {
            $('#parcelCustomerName').removeClass('is-invalid').addClass('is-valid');
        }

        if (!phone || !/^[6-9]\d{9}$/.test(phone)) {
            $('#parcelCustomerPhone').addClass('is-invalid');
            $('#parcelCustomerPhoneError').text('Enter a valid 10-digit Indian mobile number starting with 6-9.');
            isValid = false;
        } else {
            $('#parcelCustomerPhone').removeClass('is-invalid').addClass('is-valid');
        }

        if (!parcelCart.length) {
            alert('Please add at least one item to the parcel order.');
            return;
        }

        if (!isValid) return;

        let payload = {
            orderId: 0,
            tableId: null,
            covers: 1,
            orderNote: $('#parcelOrderNote').val(),
            waiterName: 'Staff',
            newItems: parcelCart.map(i => ({
                menuItemId: i.id,
                quantity: i.qty,
                specialInstructions: i.note || '',
                course: 'Main'
            })),
            items: parcelCart.map(i => ({
                menuItemId: i.id,
                quantity: i.qty,
                specialInstructions: i.note || '',
                course: 'Main'
            }))
        };

        // First create order as Takeaway
        let createPayload = {
            orderType: 2, // Takeaway
            customerName: name,
            customerPhone: phone,
            orderNote: $('#parcelOrderNote').val(),
            covers: 1,
            items: parcelCart.map(i => ({
                menuItemId: i.id,
                quantity: i.qty,
                specialInstructions: i.note || '',
                course: 'Main'
            }))
        };

        $('#parcelSubmitBtn').prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Creating Parcel Order...');

        let parcelPayload = {
            customerName: name,
            customerPhone: phone,
            orderNote: $('#parcelOrderNote').val() || '',
            items: parcelCart.map(i => ({
                menuItemId: i.id,
                quantity: i.qty,
                specialInstructions: i.note || '',
                selectedVariantName: '',
                course: 'Main'
            }))
        };

        $.ajax({
            url: '/Orders/CreateParcelOrder',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(parcelPayload),
            success: function(res) {
                $('#parcelSubmitBtn').prop('disabled', false).html('<i class="fa-solid fa-paper-plane me-1"></i> Send KOT & Create Parcel');
                if (res && res.success) {
                    var modalElem = document.getElementById('parcelModal');
                    if (modalElem) {
                        var modalInst = bootstrap.Modal.getInstance(modalElem);
                        if (modalInst) modalInst.hide();
                    }
                    
                    // Reset form & cart
                    parcelCart = [];
                    renderParcelCart();
                    $('#parcelCustomerName').val('').removeClass('is-valid is-invalid');
                    $('#parcelCustomerPhone').val('').removeClass('is-valid is-invalid');
                    $('#parcelOrderNote').val('');

                    // Show success notification
                    alert(`✅ Parcel order created successfully!\n\nOrder Number: ${res.orderNumber}\nKOT Number: ${res.kotNumber}\nCustomer: ${res.customerName}\nAmount: ₹${res.grandTotal}`);

                    // Instantly reload parcel table without full page refresh
                    loadParcelOrders();
                } else {
                    alert('Failed to create parcel order: ' + (res.message || 'Unknown error occurred.'));
                }
            },
            error: function(xhr) {
                $('#parcelSubmitBtn').prop('disabled', false).html('<i class="fa-solid fa-paper-plane me-1"></i> Send KOT & Create Parcel');
                let errMsg = 'Network or server error while placing parcel order.';
                try {
                    let json = JSON.parse(xhr.responseText);
                    if (json && json.message) errMsg = json.message;
                } catch(e) {}
                alert(errMsg);
            }
        });
    }

    // Load active parcel orders on dashboard
    function loadParcelOrders() {
        $.get('/Orders/GetParcelOrders', function(res) {
            if (res && res.success && res.orders && res.orders.length > 0) {
                let html = '<div class="table-responsive"><table class="table align-middle mb-0">';
                html += '<thead class="bg-light text-muted small text-uppercase"><tr><th>Order #</th><th>KOT #</th><th>Customer</th><th>Phone</th><th>Items Ordered</th><th>Amount</th><th>Status</th><th>Time</th><th class="text-end">Actions</th></tr></thead><tbody>';
                res.orders.forEach(o => {
                    let statusBadgeClass = 'bg-primary-subtle text-primary border border-primary-subtle';
                    if (o.status === 'Preparing') statusBadgeClass = 'bg-warning-subtle text-warning-emphasis border border-warning-subtle';
                    if (o.status === 'Ready') statusBadgeClass = 'bg-info-subtle text-info-emphasis border border-info-subtle';
                    
                    html += `<tr>
                        <td class="fw-bold text-dark"><span class="badge bg-light text-dark border">#${o.orderNumber}</span></td>
                        <td><span class="badge bg-secondary-subtle text-dark">${o.kotNumber}</span></td>
                        <td class="fw-bold text-dark">${o.customerName||'-'}</td>
                        <td class="text-muted small"><i class="fa-solid fa-phone me-1 opacity-75 text-secondary"></i>${o.customerPhone||'-'}</td>
                        <td class="small text-dark" style="max-width:240px; white-space:normal;">
                            <span class="fw-semibold text-teal" style="color:#0f766e;">${o.totalItems} items:</span> ${o.itemsSummary}
                        </td>
                        <td class="fw-bold text-success fs-6">₹${o.grandTotal.toFixed(0)}</td>
                        <td><span class="badge rounded-pill ${statusBadgeClass}" style="font-size:0.75rem;">${o.status}</span></td>
                        <td class="text-muted small">${new Date(o.createdAt).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}</td>
                        <td class="text-end">
                            <a href="/Billing?orderId=${o.id}" class="btn btn-sm btn-success rounded-pill px-3 shadow-sm me-1">
                                <i class="fa-solid fa-receipt me-1"></i> Bill
                            </a>
                            <a href="/Orders/POS?orderId=${o.id}" class="btn btn-sm btn-outline-secondary rounded-pill px-2" title="Edit Order in POS">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>
                        </td>
                    </tr>`;
                });
                html += '</tbody></table></div>';
                $('#parcelOrdersList').html(html);
            } else {
                $('#parcelOrdersList').html('<div class="text-center py-4 text-muted"><i class="fa-solid fa-box-open fs-2 d-block mb-2 text-secondary opacity-50"></i><p class="small mb-0">No active parcel orders. Click "New Parcel Order" to start one.</p></div>');
            }
        }).fail(function() {
            $('#parcelOrdersList').html('<div class="text-center py-3 text-muted small">Could not load parcel orders.</div>');
        });
    }

    loadParcelOrders();
    // Refresh parcel orders every 15 seconds
    setInterval(loadParcelOrders, 15000);

</script>
}
