    <!-- Right Column: Quick Actions Vertical Action Buttons -->
    <div class="col-lg-4">
        <div class="dashboard-widget-card h-100">
            <h5 class="fw-bold mb-3 text-dark">@(isMarathi ? "जलद कृती" : "Quick Actions")</h5>

            <div class="d-flex flex-column gap-2">
