@model BillDto
@{
    ViewData["Title"] = $"Invoice {Model.InvoiceNumber}";
    var setting = ViewBag.Settings as RestaurantManagement.Domain.Entities.RestaurantSetting ?? new RestaurantManagement.Domain.Entities.RestaurantSetting();
    var customers = ViewBag.Customers as IEnumerable<CustomerDto> ?? Enumerable.Empty<CustomerDto>();

    string cleanTableNo = (Model.TableNumber ?? "").Replace("Table", "").Trim();
    if (string.IsNullOrEmpty(cleanTableNo)) cleanTableNo = "Dine-in";
    else cleanTableNo = "Table " + cleanTableNo;

    var custPhone = Model.Order?.CustomerPhone ?? "";
    var custName = Model.Order?.CustomerName ?? "Guest";

    var totalPaid = Model.Payments?.Where(p => p.PaymentStatus == PaymentStatus.Paid).Sum(p => p.Amount) ?? 0m;
    var balanceDue = Math.Max(0m, Model.GrandTotal - totalPaid);
    bool isFullyPaid = Model.IsPaid && balanceDue <= 0.01m;
}

<style>
    /* Thermal Screen Preview & Sizing */
    .thermal-receipt-container {
        margin: 0 auto;
        font-family: 'Courier New', Courier, monospace;
        background: #ffffff;
        color: #000000;
        transition: width 0.2s ease;
    }
    .thermal-receipt-container.mode-80mm {
        width: 100%;
        max-width: 420px;
        font-size: 13px;
    }
    .thermal-receipt-container.mode-58mm {
        width: 100%;
        max-width: 320px;
        font-size: 11px;
    }
    .thermal-receipt-container.mode-58mm h3 {
        font-size: 14px !important;
    }
    .thermal-receipt-container.mode-58mm table {
        font-size: 10px !important;
    }

    @@media print {
        body {
            background: #ffffff !important;
            color: #000000 !important;
        }
        .app-sidebar, .top-header, .app-footer, .no-print, nav, .btn, .alert, .modal {
            display: none !important;
        }
        .main-content {
            padding: 0 !important;
            margin: 0 !important;
        }
        .thermal-receipt-container {
            margin: 0 auto !important;
            padding: 2mm !important;
            border: none !important;
            box-shadow: none !important;
            font-family: 'Courier New', Courier, monospace !important;
        }
        .thermal-receipt-container.mode-80mm {
            width: 80mm !important;
            max-width: 80mm !important;
            font-size: 12px !important;
        }
        .thermal-receipt-container.mode-58mm {
            width: 58mm !important;
            max-width: 58mm !important;
            font-size: 9.5px !important;
        }
        .thermal-receipt-container.mode-58mm h3 {
            font-size: 12px !important;
        }
        .thermal-receipt-container.mode-58mm table {
            font-size: 9px !important;
        }
    }
    .payment-mode-tile {
        background-color: #ffffff;
        border: 1.5px solid #e2e8f0;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        color: #1e293b;
        position: relative;
        cursor: pointer;
        padding: 12px 8px;
    }
    .payment-mode-tile:hover {
        background-color: #f8fafc;
        border-color: #94a3b8;
        transform: translateY(-1px);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }
    .payment-mode-tile.active {
        background-color: #ecfdf5 !important;
        border-color: #059669 !important;
        color: #065f46 !important;
        box-shadow: 0 0 0 2px rgba(5, 150, 105, 0.25) !important;
    }
    .payment-mode-tile .check-indicator {
        display: none;
        position: absolute;
        top: 4px;
        right: 6px;
        font-size: 11px;
        color: #059669;
    }
    .payment-mode-tile.active .check-indicator {
        display: inline-block !important;
    }
    .customer-search-item {
        cursor: pointer;
        transition: background 0.15s ease;
    }
    .customer-search-item:hover {
        background-color: #f1f5f9;
    }
</style>

<div class="row mb-4 align-items-center no-print">
    <div class="col-md-6">
        <a href="/Billing" class="btn btn-outline-secondary btn-sm rounded-pill mb-2"><i class="fa-solid fa-arrow-left me-1"></i> Back to Bills List</a>
        <h2 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-receipt text-warning me-2"></i>Tax Invoice &bull; @Model.InvoiceNumber</h2>
    </div>
    <div class="col-md-6 text-md-end mt-3 mt-md-0 d-flex flex-wrap gap-2 justify-content-md-end align-items-center">
        <!-- Thermal Sizing Switcher -->
        <div class="btn-group btn-group-sm rounded-pill border bg-white p-1 shadow-sm me-2" role="group">
            <button type="button" class="btn btn-outline-secondary rounded-pill active" id="btnToggle80" onclick="setReceiptWidth(80)">
                <i class="fa-solid fa-scroll me-1"></i> 80mm
            </button>
            <button type="button" class="btn btn-outline-secondary rounded-pill" id="btnToggle58" onclick="setReceiptWidth(58)">
                <i class="fa-solid fa-receipt me-1"></i> 58mm
            </button>
        </div>

        <button onclick="window.print()" class="btn btn-dark rounded-pill px-3 shadow-sm">
            <i class="fa-solid fa-print me-1"></i> Print Bill
        </button>

        <button class="btn btn-success rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#whatsappModal">
            <i class="fa-brands fa-whatsapp me-1"></i> WhatsApp
        </button>

        @if (!isFullyPaid)
        {
            <button class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#paymentModal">
                <i class="fa-solid fa-credit-card me-1"></i> Settle Bill @(balanceDue < Model.GrandTotal && balanceDue > 0 ? $"(Due ₹{balanceDue:N0})" : "")
            </button>
        }
        else
        {
            <span class="badge bg-success fs-6 px-3 py-2 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i> PAID</span>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3 no-print" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3 no-print" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Printable Tax Invoice Paper Box -->
<div class="row justify-content-center">
    <div class="col-12 d-flex justify-content-center">
        <div id="receiptBox" class="bg-white text-dark p-4 rounded-4 shadow-lg border thermal-receipt-container mode-80mm">
            <!-- Restaurant Header -->
            <div class="text-center border-bottom pb-3 mb-3">
                @if (!string.IsNullOrEmpty(setting.LogoUrl))
                {
                    <img src="@setting.LogoUrl" alt="Logo" style="max-height: 48px; object-fit: contain;" class="mb-2" onerror="this.style.display='none'" />
                }
                <h3 class="fw-bold mb-1">@setting.RestaurantName</h3>
                <div class="small text-muted">@setting.Address</div>
                @if (setting.IsGSTEnabled && !string.IsNullOrEmpty(setting.GSTIN))
                {
                    <div class="small text-muted"><strong>GSTIN:</strong> @setting.GSTIN</div>
                }
                <div class="small text-muted">Phone: @setting.Phone &bull; @setting.Email</div>
            </div>

            <!-- Bill Info Row -->
            <div class="d-flex justify-content-between small text-muted border-bottom pb-2 mb-3">
                <div>
                    <div><strong>Bill No:</strong> @Model.InvoiceNumber</div>
                    <div><strong>Table:</strong> @cleanTableNo</div>
                    <div><strong>Order:</strong> @Model.OrderNumber</div>
                </div>
                <div class="text-end">
                    <div><strong>Date:</strong> @Model.BillDate.ToString("dd-MMM-yyyy hh:mm tt")</div>
                    <div><strong>Customer:</strong> @custName</div>
                    @if (!string.IsNullOrEmpty(custPhone))
                    {
                        <div><strong>Phone:</strong> @custPhone</div>
                    }
                </div>
            </div>

            <!-- Items Table -->
            <table class="table table-sm align-middle mb-3">
                <thead>
                    <tr class="border-bottom border-dark text-dark fw-bold">
                        <th>Item</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Rate</th>
                        <th class="text-end">Amt</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Order?.Items != null)
                    {
                        foreach (var item in Model.Order.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@item.ItemName</div>
                                    @if (!string.IsNullOrEmpty(item.SelectedVariantName))
                                    {
                                        <div class="small text-muted ps-1">&bull; @item.SelectedVariantName</div>
                                    }
                                </td>
                                <td class="text-center fw-bold">@item.Quantity</td>
                                <td class="text-end text-muted">₹@item.UnitPrice.ToString("N2")</td>
                                <td class="text-end fw-bold text-dark">₹@item.TotalPrice.ToString("N2")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <!-- Calculation Summary -->
            <div class="border-top pt-2">
                <div class="d-flex justify-content-between mb-1 small">
                    <span>Taxable Subtotal:</span>
                    <span class="fw-bold">₹@Model.SubTotal.ToString("N2")</span>
                </div>
                @if (Model.DiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between mb-1 small text-danger">
                        <span>Discount Applied:</span>
                        <span>-₹@Model.DiscountAmount.ToString("N2")</span>
                    </div>
                }
                @if (Model.ServiceCharge > 0)
                {
                    <div class="d-flex justify-content-between mb-1 small text-muted">
                        <span>Service Charge:</span>
                        <span>₹@Model.ServiceCharge.ToString("N2")</span>
                    </div>
                }
                @if (setting.IsGSTEnabled)
                {
                    <div class="d-flex justify-content-between mb-1 small text-muted">
                        <span>CGST (@setting.CGSTPercentage%):</span>
                        <span>₹@Model.CGST.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1 small text-muted">
                        <span>SGST (@setting.SGSTPercentage%):</span>
                        <span>₹@Model.SGST.ToString("N2")</span>
                    </div>
                }
                <div class="d-flex justify-content-between fs-4 fw-bold border-top border-dark pt-2 mt-2">
                    <span>Grand Total:</span>
                    <span class="text-success">₹@Model.GrandTotal.ToString("N0")</span>
                </div>
                @if (Model.IsPaid && Model.Payments != null && Model.Payments.Any())
                {
                    <div class="border-top pt-2 mt-2 small text-muted">
                        @foreach (var p in Model.Payments)
                        {
                            <div class="d-flex justify-content-between">
                                <span>Paid via @p.PaymentMethodName:</span>
                                <span class="fw-bold text-dark">₹@p.Amount.ToString("N0")</span>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- UPI QR Code Box -->
            @if (setting.IsQRCodeEnabled && !Model.IsPaid)
            {
                <div class="text-center py-3 border-top mt-3" id="invoiceQrBox">
                    <div class="small text-muted mb-1">Scan to Pay via UPI</div>
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=110x110&data=upi://pay?pa=giranagarden@upi%26pn=GiranaGarden%26am=@Model.GrandTotal" alt="UPI QR Code" style="width: 100px; height: 100px;" class="img-fluid rounded border shadow-sm" />
                    <div class="small text-muted mt-1 fw-bold">UPI ID: giranagarden@upi</div>
                </div>
            }

            <!-- Footer Notes -->
            <div class="text-center text-muted small border-top pt-3 mt-3">
                <div>Thank you for dining with us!</div>
                <div class="fw-bold text-dark mt-1">Visit Again &bull; @setting.RestaurantName</div>
            </div>
        </div>
    </div>
</div>

<!-- Collect Payment Modal (On-screen Payment Modes & Udhari Customer Search) -->
<div class="modal fade" id="paymentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="CollectPayment" method="post" id="settlePaymentForm" class="modal-content rounded-4 border-0 shadow-lg text-dark">
            <input type="hidden" name="BillId" value="@Model.Id" />
            <input type="hidden" name="PaymentMethod" id="paymentMethodSelect" value="1" />
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-credit-card text-success me-2"></i>Settle Bill - ₹@((balanceDue > 0 ? balanceDue : Model.GrandTotal).ToString("N0"))</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Payment Mode On-Screen Tiles -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label text-dark fw-bold small mb-0">Select Payment Method</label>
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-bold" id="activePaymentLabel">
                            <i class="fa-solid fa-money-bill-wave me-1"></i> Cash
                        </span>
                    </div>

                    <div class="row g-2" id="paymentTilesGrid">
                        <div class="col-4">
                            <button type="button" class="btn w-100 rounded-3 text-center payment-mode-tile active" data-method="1" onclick="selectPaymentMethod('1', 'Cash', 'fa-money-bill-wave', 'text-success')">
                                <span class="check-indicator"><i class="fa-solid fa-circle-check"></i></span>
                                <i class="fa-solid fa-money-bill-wave fs-4 text-success d-block mb-1"></i>
                                <span class="small fw-bold d-block">Cash</span>
                            </button>
                        </div>
                        <div class="col-4">
                            <button type="button" class="btn w-100 rounded-3 text-center payment-mode-tile" data-method="2" onclick="selectPaymentMethod('2', 'UPI / QR', 'fa-qrcode', 'text-primary')">
                                <span class="check-indicator"><i class="fa-solid fa-circle-check"></i></span>
                                <i class="fa-solid fa-qrcode fs-4 text-primary d-block mb-1"></i>
                                <span class="small fw-bold d-block">UPI / QR</span>
                            </button>
                        </div>
                        <div class="col-4">
                            <button type="button" class="btn w-100 rounded-3 text-center payment-mode-tile" data-method="3" onclick="selectPaymentMethod('3', 'Credit Card', 'fa-credit-card', 'text-warning-emphasis')">
                                <span class="check-indicator"><i class="fa-solid fa-circle-check"></i></span>
                                <i class="fa-regular fa-credit-card fs-4 text-warning-emphasis d-block mb-1"></i>
                                <span class="small fw-bold d-block">Credit Card</span>
                            </button>
                        </div>
                        <div class="col-4">
                            <button type="button" class="btn w-100 rounded-3 text-center payment-mode-tile" data-method="4" onclick="selectPaymentMethod('4', 'Debit Card', 'fa-id-card', 'text-info')">
                                <span class="check-indicator"><i class="fa-solid fa-circle-check"></i></span>
                                <i class="fa-solid fa-id-card fs-4 text-info d-block mb-1"></i>
                                <span class="small fw-bold d-block">Debit Card</span>
                            </button>
                        </div>
                        <div class="col-4">
                            <button type="button" class="btn w-100 rounded-3 text-center payment-mode-tile" data-method="5" onclick="selectPaymentMethod('5', 'Wallet', 'fa-wallet', 'text-secondary')">
                                <span class="check-indicator"><i class="fa-solid fa-circle-check"></i></span>
                                <i class="fa-solid fa-wallet fs-4 text-secondary d-block mb-1"></i>
                                <span class="small fw-bold d-block">Wallet</span>
                            </button>
                        </div>
                        <div class="col-4">
                            <button type="button" class="btn w-100 rounded-3 text-center payment-mode-tile" data-method="6" onclick="selectPaymentMethod('6', 'Split Pay', 'fa-arrows-split-up-and-left', 'text-indigo')">
                                <span class="check-indicator"><i class="fa-solid fa-circle-check"></i></span>
                                <i class="fa-solid fa-arrows-split-up-and-left fs-4 d-block mb-1" style="color: #6366f1;"></i>
                                <span class="small fw-bold d-block">Split Pay</span>
                            </button>
                        </div>
                        <div class="col-12">
                            <button type="button" class="btn w-100 rounded-3 text-center payment-mode-tile" data-method="7" onclick="selectPaymentMethod('7', 'Customer Credit (Udhari)', 'fa-book-bookmark', 'text-danger')" style="border-style: dashed !important;">
                                <span class="check-indicator"><i class="fa-solid fa-circle-check"></i></span>
                                <div class="d-flex align-items-center justify-content-center gap-2 py-1">
                                    <i class="fa-solid fa-book-bookmark fs-5 text-danger"></i>
                                    <span class="fw-bold text-danger">Customer Credit (Udhari / खातीव)</span>
                                    <span class="badge bg-danger-subtle text-danger rounded-pill px-2">Ledger</span>
                                </div>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-dark fw-bold small">Total Payable Amount (₹)</label>
                    <input type="number" step="0.01" name="Amount" id="payableAmountInput" class="form-control fw-bold fs-5 text-dark bg-light" value="@(balanceDue > 0 ? balanceDue : Model.GrandTotal)" readonly />
                </div>

                <!-- Cash Tendered & Change Return Box -->
                <div id="cashCalculationBox" class="p-3 bg-light rounded-3 border mb-3">
                    <div class="mb-2">
                        <label class="form-label text-dark fw-bold small">Cash Tendered by Customer (₹)</label>
                        <input type="number" step="1" id="cashReceivedInput" class="form-control form-control-lg fw-bold text-success border-success" value="@(balanceDue > 0 ? balanceDue : Model.GrandTotal)" oninput="calculateChangeReturn()" placeholder="e.g. 1000" />
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <span class="fw-bold text-dark">Change to Return:</span>
                        <span class="fs-4 fw-bold text-primary" id="changeReturnDisplay">₹0.00</span>
                    </div>
                </div>

                <!-- Split Payment Box -->
                <div id="splitPaymentBox" class="p-3 bg-light rounded-3 border mb-3" style="display: none;">
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label text-dark fw-bold small">Cash Portion (₹)</label>
                            <input type="number" step="0.01" name="SplitCashAmount" id="splitCashInput" class="form-control fw-bold" value="@(Math.Round((balanceDue > 0 ? balanceDue : Model.GrandTotal) / 2, 2))" oninput="onSplitChange()" />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-dark fw-bold small">Online / UPI Portion (₹)</label>
                            <input type="number" step="0.01" name="SplitOnlineAmount" id="splitOnlineInput" class="form-control fw-bold" value="@((balanceDue > 0 ? balanceDue : Model.GrandTotal) - Math.Round((balanceDue > 0 ? balanceDue : Model.GrandTotal) / 2, 2))" oninput="onSplitChange()" />
                        </div>
                    </div>
                    <div class="small mt-2" id="splitHelperText">Sum: ₹@((balanceDue > 0 ? balanceDue : Model.GrandTotal).ToString("N2")) / ₹@((balanceDue > 0 ? balanceDue : Model.GrandTotal).ToString("N2"))</div>
                </div>

                <!-- Customer Credit / Udhari Box with Customer Search -->
                <div id="customerCreditBox" class="p-3 bg-light rounded-3 border mb-3" style="display: none;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label text-dark fw-bold small mb-0"><i class="fa-solid fa-magnifying-glass text-danger me-1"></i>Search Customer (Udhari Account)</label>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">Credit Account</span>
                    </div>

                    <!-- Hidden CustomerId input sent with form -->
                    <input type="hidden" name="CustomerId" id="creditCustomerIdInput" value="" />

                    <!-- Selected Customer Preview Card -->
                    <div id="selectedCustomerCard" class="p-3 mb-2 bg-white border border-success rounded-3 shadow-sm" style="display: none;">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-success-subtle text-success rounded-circle p-2 fs-6"><i class="fa-solid fa-user-check"></i></span>
                                <div>
                                    <div class="fw-bold text-dark fs-6" id="selectedCustomerName">Customer Name</div>
                                    <div class="small text-muted" id="selectedCustomerPhone">+91 00000 00000</div>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1" onclick="clearSelectedCustomer()" title="Change customer">
                                <i class="fa-solid fa-xmark me-1"></i> Change
                            </button>
                        </div>
                        <div class="row g-2 mt-2 pt-2 border-top small">
                            <div class="col-6">
                                <span class="text-muted d-block">Current Outstanding:</span>
                                <strong class="text-danger" id="selectedCustomerPrevBalance">₹0</strong>
                            </div>
                            <div class="col-6 text-end">
                                <span class="text-muted d-block">Total Due After Bill:</span>
                                <strong class="text-primary fs-6" id="selectedCustomerNewBalance">₹0</strong>
                            </div>
                        </div>
                    </div>

                    <!-- Customer Search Container -->
                    <div id="customerSearchContainer">
                        <div class="input-group mb-2">
                            <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                            <input type="text" id="customerSearchBox" class="form-control border-start-0" placeholder="Type customer name or mobile..." oninput="onCustomerSearchInput(this.value)" autocomplete="off" />
                            <button type="button" class="btn btn-outline-secondary" onclick="document.getElementById('customerSearchBox').value=''; onCustomerSearchInput('');"><i class="fa-solid fa-xmark"></i></button>
                        </div>

                        <!-- Dropdown list of matching customers -->
                        <div id="customerSearchResults" class="bg-white border rounded-3 mb-2 shadow-sm overflow-auto" style="max-height: 180px;">
                            <!-- Dynamically populated -->
                        </div>
                    </div>

                    <div class="form-check form-switch my-2">
                        <input class="form-check-input" type="checkbox" id="toggleNewCust" onchange="toggleNewCustomerInput(this.checked)">
                        <label class="form-check-label small fw-semibold text-secondary" for="toggleNewCust">+ Register New Customer for Udhari</label>
                    </div>

                    <div id="newCustomerFields" class="p-2 border rounded-3 bg-white" style="display: none;">
                        <div class="small text-muted mb-2">Enter new customer details to register & debit ledger:</div>
                        <input type="text" name="NewCustomerName" id="newCustNameInput" class="form-control form-control-sm mb-2" placeholder="Customer Full Name (Required)" />
                        <input type="tel" name="NewCustomerPhone" id="newCustPhoneInput" class="form-control form-control-sm" placeholder="10-digit Mobile Number" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-dark fw-bold small">Transaction / Reference ID (Optional)</label>
                    <input type="text" name="TransactionId" class="form-control" placeholder="UPI txn id / Card slip number..." />
                </div>

                <!-- UPI Mock QR Code -->
                <div class="text-center p-3 bg-light rounded border border-secondary-subtle my-3" id="modalUpiQrBox" style="display: none;">
                    <div class="small text-muted mb-2">Scan QR Code with GPay / PhonePe / Paytm</div>
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=140x140&data=upi://pay?pa=giranagarden@upi%26pn=GiranaGarden%26am=@Model.GrandTotal" alt="UPI QR Code" class="img-fluid rounded border shadow-sm" />
                    <div class="small text-primary mt-2 fw-bold">giranagarden@upi</div>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" id="confirmSettleBtn" class="btn btn-success rounded-pill px-4 fw-bold">
                    <i class="fa-solid fa-circle-check me-1"></i> Confirm Settlement & Settle Table
                </button>
            </div>
        </form>
    </div>
</div>

<!-- WhatsApp Share Modal -->
<div class="modal fade" id="whatsappModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 shadow-lg text-dark">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-success"><i class="fa-brands fa-whatsapp me-2"></i>Share Receipt via WhatsApp</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold small">Customer Mobile Number</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light">+91</span>
                        <input type="text" id="waMobileInput" class="form-control" value="@(custPhone.Replace("+91", "").Trim())" placeholder="9876543210" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Receipt Preview</label>
                    <textarea id="waPreviewText" class="form-control small bg-light font-monospace" rows="8" readonly></textarea>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Close</button>
                <button type="button" onclick="sendWhatsAppReceipt()" class="btn btn-success rounded-pill px-4 fw-bold">
                    <i class="fa-brands fa-whatsapp me-1"></i> Open in WhatsApp
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const grandTotal = @Model.GrandTotal;
    const restaurantName = "@(setting.RestaurantName.Replace("\"", "\\\""))";
    const invoiceNo = "@Model.InvoiceNumber";
    const billDate = "@Model.BillDate.ToString("dd-MMM-yyyy hh:mm tt")";
    const tableNo = "@cleanTableNo";
    const isPaid = @(Model.IsPaid ? "true" : "false");

    const allCustomers = [
        @foreach (var c in customers)
        {
            @:{ id: @c.Id, name: "@Html.Raw(c.Name.Replace("\"", "\\\""))", phone: "@(c.Phone ?? "")", balance: @c.OutstandingCredit },
        }
    ];

    function setReceiptWidth(width) {
        const box = document.getElementById('receiptBox');
        const b80 = document.getElementById('btnToggle80');
        const b58 = document.getElementById('btnToggle58');

        if (width === 58) {
            box.classList.remove('mode-80mm');
            box.classList.add('mode-58mm');
            b58.classList.add('active');
            b80.classList.remove('active');
        } else {
            box.classList.remove('mode-58mm');
            box.classList.add('mode-80mm');
            b80.classList.add('active');
            b58.classList.remove('active');
        }
    }

    function selectPaymentMethod(method, name, iconClass, colorClass) {
        document.getElementById('paymentMethodSelect').value = method;
        
        // Update active class on tiles
        document.querySelectorAll('#paymentTilesGrid .payment-mode-tile').forEach(tile => {
            if (tile.getAttribute('data-method') === method) {
                tile.classList.add('active');
            } else {
                tile.classList.remove('active');
            }
        });

        // Update badge label
        const badge = document.getElementById('activePaymentLabel');
        if (badge) {
            badge.innerHTML = `<i class="fa-solid ${iconClass} me-1"></i> ${name}`;
        }

        onPaymentMethodChange();
    }

    function onPaymentMethodChange() {
        const mode = document.getElementById('paymentMethodSelect').value;
        const cashBox = document.getElementById('cashCalculationBox');
        const upiBox = document.getElementById('modalUpiQrBox');
        const splitBox = document.getElementById('splitPaymentBox');
        const creditBox = document.getElementById('customerCreditBox');
        const settleBtn = document.getElementById('confirmSettleBtn');

        cashBox.style.display = "none";
        upiBox.style.display = "none";
        splitBox.style.display = "none";
        creditBox.style.display = "none";
        settleBtn.disabled = false;

        if (mode === "1") { // Cash
            cashBox.style.display = "block";
            calculateChangeReturn();
        } else if (mode === "2") { // UPI
            upiBox.style.display = "block";
        } else if (mode === "6") { // Split
            splitBox.style.display = "block";
            onSplitChange();
        } else if (mode === "7") { // Credit (Udhari)
            creditBox.style.display = "block";
            validateCreditCustomerSelection();
            if (!document.getElementById('creditCustomerIdInput').value && !document.getElementById('toggleNewCust').checked) {
                renderCustomerSearchResults('');
            }
        }
    }

    function onCustomerSearchInput(query) {
        renderCustomerSearchResults(query);
    }

    function renderCustomerSearchResults(query) {
        const listContainer = document.getElementById('customerSearchResults');
        if (!listContainer) return;
        const q = (query || '').toLowerCase().trim();
        const matches = allCustomers.filter(c => {
            if (!q) return true;
            return c.name.toLowerCase().includes(q) || (c.phone && c.phone.includes(q));
        });

        if (matches.length === 0) {
            listContainer.innerHTML = `
                <div class="p-3 text-center text-muted small">
                    <i class="fa-solid fa-user-xmark fs-5 mb-1 d-block text-secondary"></i>
                    No customers found matching "<strong>${query}</strong>".<br />
                    <button type="button" class="btn btn-sm btn-link text-success p-0 mt-1" onclick="document.getElementById('toggleNewCust').checked = true; toggleNewCustomerInput(true);">+ Click here to register a new customer</button>
                </div>
            `;
            listContainer.style.display = 'block';
            return;
        }

        let html = '';
        matches.slice(0, 15).forEach(c => {
            html += `
                <div class="p-2 border-bottom customer-search-item d-flex justify-content-between align-items-center" onclick="selectCustomer(${c.id}, '${c.name.replace(/'/g, "\\'")}', '${c.phone}', ${c.balance})">
                    <div>
                        <div class="fw-bold text-dark small">${c.name}</div>
                        <div class="text-muted" style="font-size: 0.78rem;"><i class="fa-solid fa-phone me-1"></i>${c.phone || 'No phone'}</div>
                    </div>
                    <div class="text-end">
                        <span class="badge ${c.balance > 0 ? 'bg-danger-subtle text-danger' : 'bg-success-subtle text-success'} rounded-pill" style="font-size: 0.75rem;">
                            Due: ₹${c.balance.toLocaleString('en-IN')}
                        </span>
                        <div class="text-primary small fw-semibold" style="font-size: 0.75rem;">Select <i class="fa-solid fa-chevron-right ms-1"></i></div>
                    </div>
                </div>
            `;
        });
        listContainer.innerHTML = html;
        listContainer.style.display = 'block';
    }

    function selectCustomer(id, name, phone, balance) {
        document.getElementById('creditCustomerIdInput').value = id;
        document.getElementById('selectedCustomerName').textContent = name;
        document.getElementById('selectedCustomerPhone').textContent = phone ? phone : 'No phone';
        document.getElementById('selectedCustomerPrevBalance').textContent = '₹' + balance.toLocaleString('en-IN');
        document.getElementById('selectedCustomerNewBalance').textContent = '₹' + (balance + grandTotal).toLocaleString('en-IN');

        document.getElementById('selectedCustomerCard').style.display = 'block';
        document.getElementById('customerSearchContainer').style.display = 'none';
        document.getElementById('toggleNewCust').checked = false;
        document.getElementById('newCustomerFields').style.display = 'none';

        validateCreditCustomerSelection();
    }

    function clearSelectedCustomer() {
        document.getElementById('creditCustomerIdInput').value = '';
        document.getElementById('selectedCustomerCard').style.display = 'none';
        document.getElementById('customerSearchContainer').style.display = 'block';
        document.getElementById('customerSearchBox').value = '';
        renderCustomerSearchResults('');
        validateCreditCustomerSelection();
    }

    function toggleNewCustomerInput(show) {
        document.getElementById('newCustomerFields').style.display = show ? 'block' : 'none';
        if (show) {
            document.getElementById('creditCustomerIdInput').value = '';
            document.getElementById('selectedCustomerCard').style.display = 'none';
            document.getElementById('customerSearchContainer').style.display = 'none';
        } else {
            document.getElementById('customerSearchContainer').style.display = 'block';
            renderCustomerSearchResults('');
        }
        validateCreditCustomerSelection();
    }

    function validateCreditCustomerSelection() {
        const mode = document.getElementById('paymentMethodSelect').value;
        const settleBtn = document.getElementById('confirmSettleBtn');
        if (mode !== "7") {
            return;
        }
        const hasCustomerId = !!document.getElementById('creditCustomerIdInput').value;
        const isNewCust = document.getElementById('toggleNewCust').checked;
        const newCustName = (document.getElementById('newCustNameInput')?.value || '').trim();

        if (hasCustomerId || (isNewCust && newCustName.length > 0)) {
            settleBtn.disabled = false;
        } else if (isNewCust) {
            settleBtn.disabled = newCustName.length === 0;
        } else {
            settleBtn.disabled = true;
        }
    }

    function calculateChangeReturn() {
        const payable = parseFloat(document.getElementById('payableAmountInput').value) || grandTotal;
        const received = parseFloat(document.getElementById('cashReceivedInput').value) || 0;
        const change = received - payable;
        const changeDisplay = document.getElementById('changeReturnDisplay');
        const settleBtn = document.getElementById('confirmSettleBtn');

        if (change >= 0) {
            changeDisplay.textContent = '₹' + change.toFixed(2);
            changeDisplay.className = 'fs-4 fw-bold text-success';
            settleBtn.disabled = false;
        } else {
            changeDisplay.textContent = 'Short ₹' + Math.abs(change).toFixed(2);
            changeDisplay.className = 'fs-4 fw-bold text-danger';
            settleBtn.disabled = true;
        }
    }

    function onSplitChange() {
        const payable = parseFloat(document.getElementById('payableAmountInput').value) || grandTotal;
        const cash = parseFloat(document.getElementById('splitCashInput').value) || 0;
        const online = parseFloat(document.getElementById('splitOnlineInput').value) || 0;
        const sum = cash + online;
        const helper = document.getElementById('splitHelperText');
        const settleBtn = document.getElementById('confirmSettleBtn');

        if (Math.abs(sum - payable) < 0.05) {
            helper.textContent = `Valid Split: ₹${cash.toFixed(2)} Cash + ₹${online.toFixed(2)} Online = ₹${sum.toFixed(2)}`;
            helper.className = 'small mt-2 text-success fw-bold';
            settleBtn.disabled = false;
        } else {
            const diff = payable - sum;
            helper.textContent = `Sum mismatch: ₹${sum.toFixed(2)} / ₹${payable.toFixed(2)} (Diff: ₹${diff.toFixed(2)})`;
            helper.className = 'small mt-2 text-danger fw-bold';
            settleBtn.disabled = true;
        }
    }

    // Build WhatsApp message
    function initWhatsAppPreview() {
        let msg = `*${restaurantName}*\n`;
        msg += `Tax Invoice: *${invoiceNo}*\n`;
        msg += `Date: ${billDate}\n`;
        msg += `Table: ${tableNo}\n`;
        msg += `--------------------------\n`;
        @if (Model.Order?.Items != null)
        {
            foreach (var item in Model.Order.Items)
            {
                @:msg += `${item.Quantity}x @(item.ItemName.Replace("\"", "\\\"")) - ₹@(item.TotalPrice.ToString("N0"))\n`;
            }
        }
        msg += `--------------------------\n`;
        msg += `Grand Total: *₹${grandTotal.toFixed(0)}*\n`;
        msg += `Status: ${isPaid ? "PAID" : "PENDING"}\n\n`;
        msg += `Thank you for visiting! Have a wonderful day!`;

        document.getElementById('waPreviewText').value = msg;
    }

    function sendWhatsAppReceipt() {
        let phone = document.getElementById('waMobileInput').value.replace(/[^0-9]/g, '');
        if (phone.length === 10) phone = '91' + phone;
        if (!phone) {
            alert('Please enter a valid phone number');
            return;
        }
        const text = encodeURIComponent(document.getElementById('waPreviewText').value);
        window.open(`https://api.whatsapp.com/send?phone=${phone}&text=${text}`, '_blank');
    }

    document.addEventListener('DOMContentLoaded', function () {
        document.getElementById('newCustNameInput')?.addEventListener('input', validateCreditCustomerSelection);
        
        document.getElementById('settlePaymentForm')?.addEventListener('submit', function(e) {
            const mode = document.getElementById('paymentMethodSelect').value;
            if (mode === "7") {
                const hasCustomerId = !!document.getElementById('creditCustomerIdInput').value;
                const isNewCust = document.getElementById('toggleNewCust').checked;
                const newCustName = (document.getElementById('newCustNameInput')?.value || '').trim();

                if (!hasCustomerId && !isNewCust) {
                    e.preventDefault();
                    alert('Please search and select a customer, or check "Register New Customer" to record Udhari.');
                    return false;
                }
                if (isNewCust && !newCustName) {
                    e.preventDefault();
                    alert('Please enter the customer name for registering the Udhari account.');
                    return false;
                }
            }
        });

        onPaymentMethodChange();
        initWhatsAppPreview();
    });
</script>
}