@model IEnumerable<BillDto>
@{
    ViewData["Title"] = "Billing & Invoices";
    var billsList = Model.OrderByDescending(b => b.BillDate).ToList();
    var customers = ViewBag.Customers as IEnumerable<CustomerDto> ?? Enumerable.Empty<CustomerDto>();
    int totalCount = billsList.Count;
    int paidCount = billsList.Count(b => b.IsPaid);
    int pendingCount = billsList.Count(b => !b.IsPaid);
    decimal totalBilled = billsList.Sum(b => b.GrandTotal);
    decimal totalPaid = billsList.Where(b => b.IsPaid).Sum(b => b.GrandTotal);
    decimal totalPending = billsList.Where(b => !b.IsPaid).Sum(b => b.GrandTotal);
}

<style>
    .payment-mode-tile {
        background-color: #ffffff;
        border: 1.5px solid #e2e8f0;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        color: #1e293b;
        position: relative;
        cursor: pointer;
        padding: 10px 6px;
    }
    .payment-mode-tile:hover {
        background-color: #f8fafc;
        border-color: #94a3b8;
        transform: translateY(-1px);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }
    .payment-mode-tile.active {
        background-color: #ecfdf5 !important;
        border-color: #059669 !important;
        color: #065f46 !important;
        box-shadow: 0 0 0 2px rgba(5, 150, 105, 0.25) !important;
    }
    .payment-mode-tile .check-indicator {
        display: none;
        position: absolute;
        top: 3px;
        right: 5px;
        font-size: 10px;
        color: #059669;
    }
    .payment-mode-tile.active .check-indicator {
        display: inline-block !important;
    }
    .customer-search-item {
        cursor: pointer;
        transition: background 0.15s ease;
    }
    .customer-search-item:hover {
        background-color: #f1f5f9;
    }
</style>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 animated-fade-in">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 fs-6">
                <li class="breadcrumb-item">
                    <a href="/Dashboard" class="text-decoration-none fw-semibold text-success">
                        <i class="fa-solid fa-chart-pie me-1"></i> Dashboard
                    </a>
                </li>
                <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">
                    <i class="fa-solid fa-file-invoice-dollar text-success me-1"></i> Billing & Invoices
                </li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-file-invoice-dollar text-success me-2"></i>Billing & Invoices
        </h2>
    </div>
    <div class="d-flex gap-2">
        <a href="/Dashboard" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm" data-bs-toggle="tooltip" title="Back to Dashboard">
            <i class="fa-solid fa-arrow-left me-1"></i> Dashboard
        </a>
        <a href="/Billing/Generate?orderId=0" class="btn btn-warning rounded-pill px-3 shadow-sm fw-bold text-dark" title="Generate Bill for Active Order">
            <i class="fa-solid fa-file-invoice me-1"></i> Bill Active Order
        </a>
        <a href="/Orders/POS" class="btn btn-success rounded-pill px-4 shadow-sm fw-bold">
            <i class="fa-solid fa-cash-register me-1"></i> New POS Order
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- KPI Cards -->
<div class="row g-3 mb-4 animated-fade-in">
    <div class="col-xl-3 col-sm-6">
        <div class="metric-card-clean metric-card-sales-border">
            <div class="d-flex justify-content-between align-items-center">
                <span class="metric-label metric-label-bold">TOTAL BILLED</span>
                <span class="badge rounded-pill bg-light text-muted border">Invoices: @totalCount</span>
            </div>
            <div class="metric-value-bold mt-1">₹@totalBilled.ToString("N0")</div>
            <div class="metric-desc-bold mt-1">Total revenue generated</div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="metric-card-clean metric-card-orders-border">
            <div class="d-flex justify-content-between align-items-center">
                <span class="metric-label metric-label-bold">SETTLED & PAID</span>
                <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle fw-bold">@paidCount Paid</span>
            </div>
            <div class="metric-value-bold mt-1 text-success">₹@totalPaid.ToString("N0")</div>
            <div class="metric-desc-bold mt-1">Cash, UPI & Card settlements</div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="metric-card-clean metric-card-tables-border">
            <div class="d-flex justify-content-between align-items-center">
                <span class="metric-label metric-label-bold">PENDING PAYMENT</span>
                <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle fw-bold">@pendingCount Due</span>
            </div>
            <div class="metric-value-bold mt-1 text-danger">₹@totalPending.ToString("N0")</div>
            <div class="metric-desc-bold mt-1">Awaiting customer payment</div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="metric-card-clean metric-card-completed-border">
            <div class="d-flex justify-content-between align-items-center">
                <span class="metric-label metric-label-bold">COLLECTION RATE</span>
                <span class="badge rounded-pill bg-purple-subtle text-purple border fw-bold" style="background:#f3e8ff; color:#7e22ce;">Efficiency</span>
            </div>
            @{
                int collectionRate = totalBilled > 0 ? (int)Math.Round((double)totalPaid / (double)totalBilled * 100) : 100;
            }
            <div class="metric-value-bold mt-1">@collectionRate%</div>
            <div class="metric-desc-bold mt-1">Payment recovery ratio</div>
        </div>
    </div>
</div>

<div class="glass-card p-4 animated-fade-in">
    <!-- Header with Search & Filter Tabs -->
    <div class="row g-3 align-items-center mb-3">
        <div class="col-md-6">
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-sm btn-dark rounded-pill px-3 py-1 bill-filter-btn active" onclick="filterBills('all', this)">
                    All Bills (@totalCount)
                </button>
                <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 bill-filter-btn" onclick="filterBills('paid', this)">
                    <i class="fa-solid fa-circle-check me-1"></i> Paid (@paidCount)
                </button>
                <button type="button" class="btn btn-sm btn-outline-warning rounded-pill px-3 py-1 bill-filter-btn" onclick="filterBills('pending', this)">
                    <i class="fa-solid fa-clock me-1"></i> Pending (@pendingCount)
                </button>
            </div>
        </div>
        <div class="col-md-6 d-flex justify-content-md-end">
            <div class="input-group input-group-sm" style="max-width: 280px;">
                <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" id="billSearchInput" class="form-control border-start-0" placeholder="Search invoice, table, or order..." onkeyup="applyBillFilters()" />
            </div>
        </div>
    </div>

    <!-- Bills Datagrid -->
    <div class="table-responsive">
        <table class="table app-datagrid align-middle mb-0" id="billsTable">
            <thead>
                <tr>
                    <th>Invoice #</th>
                    <th>Order #</th>
                    <th>Table / Dining</th>
                    <th>Date & Time</th>
                    <th>Subtotal & GST</th>
                    <th>Grand Total</th>
                    <th>Payment Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!billsList.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-file-invoice-dollar fs-2 d-block mb-2 text-secondary opacity-50"></i>
                            <p class="small mb-0 text-muted">No invoices or bills generated yet.</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var bill in billsList)
                    {
                        var billPayments = bill.Payments?.Where(p => p.PaymentStatus == PaymentStatus.Paid).Sum(p => p.Amount) ?? (bill.IsPaid ? bill.GrandTotal : 0m);
                        var remainingBalance = Math.Max(0m, bill.GrandTotal - billPayments);
                        bool isBillPaid = bill.IsPaid && remainingBalance <= 0.01m;
                        string filterCategory = isBillPaid ? "paid" : "pending";
                        string cleanTableNo = string.IsNullOrEmpty(bill.TableNumber) ? "Dine-in" : (bill.TableNumber.Contains("Table") ? bill.TableNumber : "Table " + bill.TableNumber);

                        <tr class="bill-row" data-status="@filterCategory" data-search="@bill.InvoiceNumber.ToLower() @bill.OrderNumber.ToLower() @cleanTableNo.ToLower()">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="p-2 rounded-3 bg-light border text-success">
                                        <i class="fa-solid fa-receipt fs-6"></i>
                                    </div>
                                    <span class="fw-bold text-dark fs-6">@bill.InvoiceNumber</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill px-3 py-1">
                                    #@bill.OrderNumber
                                </span>
                            </td>
                            <td>
                                <span class="badge rounded-pill px-3 py-1 fw-semibold" style="background:#e0f2fe; color:#0369a1; border:1px solid #bae6fd;">
                                    <i class="fa-solid fa-chair me-1"></i>@cleanTableNo
                                </span>
                            </td>
                            <td class="small text-secondary">
                                <div><i class="fa-regular fa-calendar me-1"></i>@bill.BillDate.ToString("dd-MMM-yyyy")</div>
                                <div class="text-muted"><i class="fa-regular fa-clock me-1"></i>@bill.BillDate.ToString("hh:mm tt")</div>
                            </td>
                            <td class="small text-secondary">
                                <div>Subtotal: ₹@bill.SubTotal.ToString("N0")</div>
                                <div class="text-muted">GST (5%): ₹@((bill.CGST + bill.SGST).ToString("N0"))</div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark fs-5">₹@bill.GrandTotal.ToString("N0")</div>
                            </td>
                            <td>
                                @if (isBillPaid)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-bold">
                                        <i class="fa-solid fa-circle-check me-1"></i> Paid
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1 fw-bold">
                                        <i class="fa-solid fa-clock me-1"></i> Pending Payment @(remainingBalance < bill.GrandTotal && remainingBalance > 0 ? $"(Due ₹{remainingBalance:N0})" : "")
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a href="/Billing/Invoice/@bill.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold" title="View Full Tax Invoice">
                                        <i class="fa-solid fa-eye me-1"></i> View
                                    </a>
                                    @if (!isBillPaid || remainingBalance > 0.01m)
                                    {
                                        <button type="button" class="btn btn-sm btn-success rounded-pill px-3 fw-bold shadow-sm" onclick="openQuickPayModal(@bill.Id, '@bill.InvoiceNumber', @(remainingBalance > 0 ? remainingBalance : bill.GrandTotal))" title="Collect Payment Now">
                                            <i class="fa-solid fa-credit-card me-1"></i> Pay
                                        </button>
                                    }
                                    <a href="/Billing/Invoice/@bill.Id" onclick="setTimeout(() => window.print(), 500);" class="btn btn-sm btn-light border rounded-pill px-2" title="Print Invoice">
                                        <i class="fa-solid fa-print"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Quick Settle Payment from Billing Index (On-screen Payment Modes & Udhari Customer Search) -->
<div class="modal fade" id="quickPayModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="CollectPayment" method="post" id="quickSettleForm" class="modal-content rounded-4 border-0 shadow-lg text-dark">
            <input type="hidden" name="BillId" id="quickBillId" value="" />
            <input type="hidden" name="ReturnUrl" value="/Billing" />
            <input type="hidden" name="PaymentMethod" id="quickPaymentMethodSelect" value="1" />
            
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark">
                    <i class="fa-solid fa-credit-card text-success me-2"></i>Collect Payment - <span id="quickInvoiceNum"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="p-3 bg-light rounded-3 border mb-3 text-center">
                    <span class="text-secondary small d-block">Total Payable Amount</span>
                    <strong class="fs-2 text-success" id="quickPayAmountDisplay">₹0</strong>
                    <input type="hidden" name="Amount" id="quickPayAmountInput" value="0" />
                </div>

                <!-- On-Screen Payment Mode Tiles -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label text-dark fw-bold small mb-0">Select Payment Method</label>
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-bold" id="quickActivePaymentLabel">
                            <i class="fa-solid fa-money-bill-wave me-1"></i> Cash
                        </span>
                    </div>

                    <div class="row g-2" id="quickPaymentTilesGrid">
                        <div class="col-4">
                            <button type="button" class="btn w-100 rounded-3 text-center payment-mode-tile active" data-method="1" onclick="quickSelectPaymentMethod('1', 'Cash', 'fa-money-bill-wave')">
                                <span class="check-indicator"><i class="fa-solid fa-circle-check"></i></span>
                                <i class="fa-solid fa-money-bill-wave fs-4 text-success d-block mb-1"></i>
                                <span class="small fw-bold d-block">Cash</span>
                            </button>
                        </div>
                        <div class="col-4">
                            <button type="button" class="btn w-100 rounded-3 text-center payment-mode-tile" data-method="2" onclick="quickSelectPaymentMethod('2', 'UPI / QR', 'fa-qrcode')">
                                <span class="check-indicator"><i class="fa-solid fa-circle-check"></i></span>
                                <i class="fa-solid fa-qrcode fs-4 text-primary d-block mb-1"></i>
                                <span class="small fw-bold d-block">UPI / QR</span>
                            </button>
                        </div>
                        <div class="col-4">
                            <button type="button" class="btn w-100 rounded-3 text-center payment-mode-tile" data-method="3" onclick="quickSelectPaymentMethod('3', 'Credit Card', 'fa-credit-card')">
                                <span class="check-indicator"><i class="fa-solid fa-circle-check"></i></span>
                                <i class="fa-regular fa-credit-card fs-4 text-warning-emphasis d-block mb-1"></i>
                                <span class="small fw-bold d-block">Credit Card</span>
                            </button>
                        </div>
                        <div class="col-4">
                            <button type="button" class="btn w-100 rounded-3 text-center payment-mode-tile" data-method="4" onclick="quickSelectPaymentMethod('4', 'Debit Card', 'fa-id-card')">
                                <span class="check-indicator"><i class="fa-solid fa-circle-check"></i></span>
                                <i class="fa-solid fa-id-card fs-4 text-info d-block mb-1"></i>
                                <span class="small fw-bold d-block">Debit Card</span>
                            </button>
                        </div>
                        <div class="col-4">
                            <button type="button" class="btn w-100 rounded-3 text-center payment-mode-tile" data-method="5" onclick="quickSelectPaymentMethod('5', 'Wallet', 'fa-wallet')">
                                <span class="check-indicator"><i class="fa-solid fa-circle-check"></i></span>
                                <i class="fa-solid fa-wallet fs-4 text-secondary d-block mb-1"></i>
                                <span class="small fw-bold d-block">Wallet</span>
                            </button>
                        </div>
                        <div class="col-4">
                            <button type="button" class="btn w-100 rounded-3 text-center payment-mode-tile" data-method="6" onclick="quickSelectPaymentMethod('6', 'Split Pay', 'fa-arrows-split-up-and-left')">
                                <span class="check-indicator"><i class="fa-solid fa-circle-check"></i></span>
                                <i class="fa-solid fa-arrows-split-up-and-left fs-4 d-block mb-1" style="color: #6366f1;"></i>
                                <span class="small fw-bold d-block">Split Pay</span>
                            </button>
                        </div>
                        <div class="col-12">
                            <button type="button" class="btn w-100 rounded-3 text-center payment-mode-tile" data-method="7" onclick="quickSelectPaymentMethod('7', 'Customer Credit (Udhari)', 'fa-book-bookmark')" style="border-style: dashed !important;">
                                <span class="check-indicator"><i class="fa-solid fa-circle-check"></i></span>
                                <div class="d-flex align-items-center justify-content-center gap-2 py-1">
                                    <i class="fa-solid fa-book-bookmark fs-5 text-danger"></i>
                                    <span class="fw-bold text-danger">Customer Credit (Udhari / खातीव)</span>
                                    <span class="badge bg-danger-subtle text-danger rounded-pill px-2">Ledger</span>
                                </div>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Cash Tendered Box -->
                <div id="quickCashBox" class="p-3 bg-light rounded-3 border mb-3">
                    <div class="mb-2">
                        <label class="form-label text-dark fw-bold small">Cash Tendered (₹)</label>
                        <input type="number" step="1" id="quickCashReceivedInput" class="form-control form-control-lg fw-bold text-success border-success" oninput="quickCalculateChangeReturn()" placeholder="e.g. 500" />
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <span class="fw-bold text-dark small">Change to Return:</span>
                        <span class="fs-5 fw-bold text-primary" id="quickChangeReturnDisplay">₹0.00</span>
                    </div>
                </div>

                <!-- Split Payment Box -->
                <div id="quickSplitBox" class="p-3 bg-light rounded-3 border mb-3" style="display: none;">
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label text-dark fw-bold small">Cash (₹)</label>
                            <input type="number" step="0.01" name="SplitCashAmount" id="quickSplitCashInput" class="form-control form-control-sm fw-bold" oninput="quickOnSplitChange()" />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-dark fw-bold small">Online (₹)</label>
                            <input type="number" step="0.01" name="SplitOnlineAmount" id="quickSplitOnlineInput" class="form-control form-control-sm fw-bold" oninput="quickOnSplitChange()" />
                        </div>
                    </div>
                    <div class="small mt-2" id="quickSplitHelperText">Split sum verification</div>
                </div>

                <!-- Customer Credit / Udhari Box with Customer Search -->
                <div id="quickCustomerCreditBox" class="p-3 bg-light rounded-3 border mb-3" style="display: none;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label text-dark fw-bold small mb-0"><i class="fa-solid fa-magnifying-glass text-danger me-1"></i>Search Customer (Udhari Account)</label>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">Credit Account</span>
                    </div>

                    <!-- Hidden CustomerId input sent with form -->
                    <input type="hidden" name="CustomerId" id="quickCreditCustomerIdInput" value="" />

                    <!-- Selected Customer Preview Card -->
                    <div id="quickSelectedCustomerCard" class="p-3 mb-2 bg-white border border-success rounded-3 shadow-sm" style="display: none;">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-success-subtle text-success rounded-circle p-2 fs-6"><i class="fa-solid fa-user-check"></i></span>
                                <div>
                                    <div class="fw-bold text-dark small" id="quickSelectedCustomerName">Customer Name</div>
                                    <div class="text-muted" style="font-size: 0.78rem;" id="quickSelectedCustomerPhone">+91 00000 00000</div>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-0" onclick="quickClearSelectedCustomer()" title="Change customer">
                                <i class="fa-solid fa-xmark me-1"></i> Change
                            </button>
                        </div>
                        <div class="row g-2 mt-2 pt-2 border-top small">
                            <div class="col-6">
                                <span class="text-muted d-block" style="font-size: 0.75rem;">Current Due:</span>
                                <strong class="text-danger" id="quickSelectedCustomerPrevBalance">₹0</strong>
                            </div>
                            <div class="col-6 text-end">
                                <span class="text-muted d-block" style="font-size: 0.75rem;">Total After Bill:</span>
                                <strong class="text-primary" id="quickSelectedCustomerNewBalance">₹0</strong>
                            </div>
                        </div>
                    </div>

                    <!-- Customer Search Container -->
                    <div id="quickCustomerSearchContainer">
                        <div class="input-group mb-2">
                            <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                            <input type="text" id="quickCustomerSearchBox" class="form-control border-start-0" placeholder="Type customer name or mobile..." oninput="quickOnCustomerSearchInput(this.value)" autocomplete="off" />
                            <button type="button" class="btn btn-outline-secondary" onclick="document.getElementById('quickCustomerSearchBox').value=''; quickOnCustomerSearchInput('');"><i class="fa-solid fa-xmark"></i></button>
                        </div>

                        <!-- Dropdown list of matching customers -->
                        <div id="quickCustomerSearchResults" class="bg-white border rounded-3 mb-2 shadow-sm overflow-auto" style="max-height: 160px;">
                            <!-- Dynamically populated -->
                        </div>
                    </div>

                    <div class="form-check form-switch my-2">
                        <input class="form-check-input" type="checkbox" id="quickToggleNewCust" onchange="quickToggleNewCustomerInput(this.checked)">
                        <label class="form-check-label small fw-semibold text-secondary" for="quickToggleNewCust">+ Register New Customer for Udhari</label>
                    </div>

                    <div id="quickNewCustomerFields" class="p-2 border rounded-3 bg-white" style="display: none;">
                        <div class="small text-muted mb-2">Enter new customer details to register & debit ledger:</div>
                        <input type="text" name="NewCustomerName" id="quickNewCustNameInput" class="form-control form-control-sm mb-2" placeholder="Customer Full Name (Required)" />
                        <input type="tel" name="NewCustomerPhone" id="quickNewCustPhoneInput" class="form-control form-control-sm" placeholder="10-digit Mobile Number" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-dark fw-bold small">Transaction / Reference ID (Optional)</label>
                    <input type="text" name="TransactionId" class="form-control" placeholder="UPI txn id / Card slip number..." />
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" id="quickConfirmSettleBtn" class="btn btn-success rounded-pill px-4 fw-bold">
                    <i class="fa-solid fa-circle-check me-1"></i> Confirm & Settle Table
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    let currentBillFilter = 'all';
    let currentPayAmount = 0;

    const quickCustomers = [
        @foreach (var c in customers)
        {
            @:{ id: @c.Id, name: "@Html.Raw(c.Name.Replace("\"", "\\\""))", phone: "@(c.Phone ?? "")", balance: @c.OutstandingCredit },
        }
    ];

    function filterBills(status, btn) {
        currentBillFilter = status;
        $('.bill-filter-btn').removeClass('active btn-dark btn-success btn-warning')
                            .addClass('btn-outline-dark');
        $(btn).removeClass('btn-outline-dark').addClass('active btn-dark');
        applyBillFilters();
    }

    function applyBillFilters() {
        let q = ($('#billSearchInput').val() || '').toLowerCase().trim();
        $('.bill-row').each(function() {
            let rowStatus = $(this).data('status');
            let searchContent = $(this).data('search') || '';

            let matchesStatus = (currentBillFilter === 'all') || (rowStatus === currentBillFilter);
            let matchesSearch = !q || searchContent.includes(q);

            $(this).toggle(matchesStatus && matchesSearch);
        });
    }

    function openQuickPayModal(billId, invoiceNo, amount) {
        currentPayAmount = Number(amount);
        $('#quickBillId').val(billId);
        $('#quickInvoiceNum').text(invoiceNo);
        $('#quickPayAmountDisplay').text('₹' + currentPayAmount.toLocaleString('en-IN'));
        $('#quickPayAmountInput').val(currentPayAmount);
        
        // Reset to Cash by default
        quickSelectPaymentMethod('1', 'Cash', 'fa-money-bill-wave');
        $('#quickCashReceivedInput').val(currentPayAmount);
        quickCalculateChangeReturn();

        // Preset split values
        const half = Math.round(currentPayAmount / 2);
        $('#quickSplitCashInput').val(half);
        $('#quickSplitOnlineInput').val(currentPayAmount - half);

        // Reset Udhari customer selection
        quickClearSelectedCustomer();

        new bootstrap.Modal(document.getElementById('quickPayModal')).show();
    }

    function quickSelectPaymentMethod(method, name, iconClass) {
        $('#quickPaymentMethodSelect').val(method);

        // Update active tile
        $('#quickPaymentTilesGrid .payment-mode-tile').removeClass('active');
        $(`#quickPaymentTilesGrid .payment-mode-tile[data-method="${method}"]`).addClass('active');

        // Update badge
        $('#quickActivePaymentLabel').html(`<i class="fa-solid ${iconClass} me-1"></i> ${name}`);

        // Toggle sub-boxes
        $('#quickCashBox').toggle(method === '1');
        $('#quickSplitBox').toggle(method === '6');
        $('#quickCustomerCreditBox').toggle(method === '7');

        if (method === '1') {
            quickCalculateChangeReturn();
        } else if (method === '6') {
            quickOnSplitChange();
        } else if (method === '7') {
            quickValidateCreditCustomerSelection();
            if (!$('#quickCreditCustomerIdInput').val() && !$('#quickToggleNewCust').is(':checked')) {
                quickRenderCustomerSearchResults('');
            }
        } else {
            $('#quickConfirmSettleBtn').prop('disabled', false);
        }
    }

    function quickCalculateChangeReturn() {
        const received = parseFloat($('#quickCashReceivedInput').val()) || 0;
        const change = received - currentPayAmount;
        const changeDisplay = $('#quickChangeReturnDisplay');
        const settleBtn = $('#quickConfirmSettleBtn');

        if (change >= 0) {
            changeDisplay.text('₹' + change.toFixed(2)).removeClass('text-danger').addClass('text-success');
            settleBtn.prop('disabled', false);
        } else {
            changeDisplay.text('Short ₹' + Math.abs(change).toFixed(2)).removeClass('text-success').addClass('text-danger');
            settleBtn.prop('disabled', true);
        }
    }

    function quickOnSplitChange() {
        const cash = parseFloat($('#quickSplitCashInput').val()) || 0;
        const online = parseFloat($('#quickSplitOnlineInput').val()) || 0;
        const sum = cash + online;
        const helper = $('#quickSplitHelperText');
        const settleBtn = $('#quickConfirmSettleBtn');

        if (Math.abs(sum - currentPayAmount) < 0.05) {
            helper.text(`Valid Split: ₹${cash.toFixed(2)} Cash + ₹${online.toFixed(2)} Online`).removeClass('text-danger').addClass('text-success fw-bold');
            settleBtn.prop('disabled', false);
        } else {
            const diff = currentPayAmount - sum;
            helper.text(`Mismatch: ₹${sum.toFixed(2)} / ₹${currentPayAmount.toFixed(2)} (Diff: ₹${diff.toFixed(2)})`).removeClass('text-success').addClass('text-danger fw-bold');
            settleBtn.prop('disabled', true);
        }
    }

    function quickOnCustomerSearchInput(query) {
        quickRenderCustomerSearchResults(query);
    }

    function quickRenderCustomerSearchResults(query) {
        const container = $('#quickCustomerSearchResults');
        const q = (query || '').toLowerCase().trim();
        const matches = quickCustomers.filter(c => {
            if (!q) return true;
            return c.name.toLowerCase().includes(q) || (c.phone && c.phone.includes(q));
        });

        if (matches.length === 0) {
            container.html(`
                <div class="p-3 text-center text-muted small">
                    No customers found matching "<strong>${query}</strong>".<br />
                    <button type="button" class="btn btn-sm btn-link text-success p-0 mt-1" onclick="$('#quickToggleNewCust').prop('checked', true); quickToggleNewCustomerInput(true);">+ Click here to register a new customer</button>
                </div>
            `).show();
            return;
        }

        let html = '';
        matches.slice(0, 15).forEach(c => {
            html += `
                <div class="p-2 border-bottom customer-search-item d-flex justify-content-between align-items-center" onclick="quickSelectCustomer(${c.id}, '${c.name.replace(/'/g, "\\'")}', '${c.phone}', ${c.balance})">
                    <div>
                        <div class="fw-bold text-dark small">${c.name}</div>
                        <div class="text-muted" style="font-size: 0.78rem;"><i class="fa-solid fa-phone me-1"></i>${c.phone || 'No phone'}</div>
                    </div>
                    <div class="text-end">
                        <span class="badge ${c.balance > 0 ? 'bg-danger-subtle text-danger' : 'bg-success-subtle text-success'} rounded-pill" style="font-size: 0.75rem;">
                            Due: ₹${c.balance.toLocaleString('en-IN')}
                        </span>
                        <div class="text-primary small fw-semibold" style="font-size: 0.75rem;">Select <i class="fa-solid fa-chevron-right ms-1"></i></div>
                    </div>
                </div>
            `;
        });
        container.html(html).show();
    }

    function quickSelectCustomer(id, name, phone, balance) {
        $('#quickCreditCustomerIdInput').val(id);
        $('#quickSelectedCustomerName').text(name);
        $('#quickSelectedCustomerPhone').text(phone || 'No phone');
        $('#quickSelectedCustomerPrevBalance').text('₹' + balance.toLocaleString('en-IN'));
        $('#quickSelectedCustomerNewBalance').text('₹' + (balance + currentPayAmount).toLocaleString('en-IN'));

        $('#quickSelectedCustomerCard').show();
        $('#quickCustomerSearchContainer').hide();
        $('#quickToggleNewCust').prop('checked', false);
        $('#quickNewCustomerFields').hide();

        quickValidateCreditCustomerSelection();
    }

    function quickClearSelectedCustomer() {
        $('#quickCreditCustomerIdInput').val('');
        $('#quickSelectedCustomerCard').hide();
        $('#quickCustomerSearchContainer').show();
        $('#quickCustomerSearchBox').val('');
        quickRenderCustomerSearchResults('');
        quickValidateCreditCustomerSelection();
    }

    function quickToggleNewCustomerInput(show) {
        $('#quickNewCustomerFields').toggle(show);
        if (show) {
            $('#quickCreditCustomerIdInput').val('');
            $('#quickSelectedCustomerCard').hide();
            $('#quickCustomerSearchContainer').hide();
        } else {
            $('#quickCustomerSearchContainer').show();
            quickRenderCustomerSearchResults('');
        }
        quickValidateCreditCustomerSelection();
    }

    function quickValidateCreditCustomerSelection() {
        const mode = $('#quickPaymentMethodSelect').val();
        const settleBtn = $('#quickConfirmSettleBtn');
        if (mode !== '7') return;

        const hasCustomerId = !!$('#quickCreditCustomerIdInput').val();
        const isNewCust = $('#quickToggleNewCust').is(':checked');
        const newCustName = ($('#quickNewCustNameInput').val() || '').trim();

        if (hasCustomerId || (isNewCust && newCustName.length > 0)) {
            settleBtn.prop('disabled', false);
        } else if (isNewCust) {
            settleBtn.prop('disabled', newCustName.length === 0);
        } else {
            settleBtn.prop('disabled', true);
        }
    }

    $(document).ready(function() {
        $('#quickNewCustNameInput').on('input', quickValidateCreditCustomerSelection);

        $('#quickSettleForm').on('submit', function(e) {
            const mode = $('#quickPaymentMethodSelect').val();
            if (mode === '7') {
                const hasCustomerId = !!$('#quickCreditCustomerIdInput').val();
                const isNewCust = $('#quickToggleNewCust').is(':checked');
                const newCustName = ($('#quickNewCustNameInput').val() || '').trim();

                if (!hasCustomerId && !isNewCust) {
                    e.preventDefault();
                    alert('Please search and select a customer, or check "Register New Customer" to record Udhari.');
                    return false;
                }
                if (isNewCust && !newCustName) {
                    e.preventDefault();
                    alert('Please enter the customer name for registering the Udhari account.');
                    return false;
                }
            }
        });
    });
</script>
}
