                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Display Order</label>
                    <input type="number" name="DisplayOrder" class="form-control" value="@(Model.Categories.Count() + 1)" min="1" required />
                </div>
                <div class="mb-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="addCategoryActive" checked />
                        <label class="form-check-label fw-bold small" for="addCategoryActive">Active Status</label>
