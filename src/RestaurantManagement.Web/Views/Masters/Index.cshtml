            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary rounded-pill px-4">Register Employee</button>
            </div>
        </form>
    </div>
</div>

<!-- 12. Edit Employee Modal -->
<div class="modal fade" id="editEmployeeModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <form asp-action="UpdateEmployee" method="post" class="modal-content rounded-4 border-0 shadow-lg">
            <input type="hidden" name="id" id="editEmpId" />
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-user-pen text-primary me-2"></i>Edit Employee Profile</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Full Name</label>
                        <input type="text" name="Name" id="editEmpName" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Role</label>
                        <select name="Role" id="editEmpRole" class="form-select" required>
                            <option value="2">Manager</option>
                            <option value="7">Cook / Chef</option>
                            <option value="4">Waiter</option>
                            <option value="8">Housekeeping / Cleaner</option>
                            <option value="3">Cashier</option>
                            <option value="5">Kitchen Staff</option>
                            <option value="6">Inventory Staff</option>
                            <option value="1">Admin</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Phone</label>
                        <input type="tel" name="Phone" id="editEmpPhone" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Email</label>
                        <input type="email" name="Email" id="editEmpEmail" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Shift</label>
                        <select name="Shift" id="editEmpShift" class="form-select">
                            <option value="Morning">Morning Shift</option>
                            <option value="Evening">Evening Shift</option>
                            <option value="General">General Shift</option>
                            <option value="Night">Night Shift</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Salary (₹)</label>
                        <input type="number" name="BaseSalary" id="editEmpSalary" class="form-control" min="0" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Status</label>
                        <select name="IsActive" id="editEmpIsActive" class="form-select">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary rounded-pill px-4">Update Employee</button>
            </div>
        </form>
    </div>
</div>

<!-- 13. Adjust Stock Modal -->
<div class="modal fade" id="adjustStockModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="AdjustStock" method="post" class="modal-content rounded-4 border-0 shadow-lg">
            <input type="hidden" name="InventoryItemId" id="adjustItemId" />
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-sliders text-primary me-2"></i>Adjust Stock: <span id="adjustItemName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold small">Action Type</label>
                    <select name="TransactionType" class="form-select">
                        <option value="IN">Stock In (Purchase Receive)</option>
                        <option value="OUT">Stock Out (Manual Deduction)</option>
                        <option value="WASTAGE">Wastage / Spoiled</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Quantity (<span id="adjustItemUnit"></span>)</label>
                    <input type="number" step="0.01" name="Quantity" class="form-control" placeholder="e.g. 10" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Notes / Reason</label>
                    <input type="text" name="Notes" class="form-control" placeholder="Stock update notes..." />
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary rounded-pill px-4">Record Adjustment</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function editFloor(id, name, desc, order, isActive) {
        $('#editFloorId').val(id);
        $('#editFloorName').val(name);
        $('#editFloorDescription').val(desc);
        $('#editFloorOrder').val(order);
        $('#editFloorActive').prop('checked', isActive);
        new bootstrap.Modal('#editFloorModal').show();
    }

    function editTable(id, number, floorId, cap, type, desc, isActive) {
        $('#editTableId').val(id);
        $('#editTableNumber').val(number);
        $('#editTableFloorId').val(floorId);
        $('#editTableCapacity').val(cap);
        $('#editTableType').val(type || 'Dine-In');
        $('#editTableDescription').val(desc || '');
        $('#editTableActive').prop('checked', isActive);
        new bootstrap.Modal('#editTableModal').show();
    }

    function editCategory(id, name, nameMarathi, desc, order, isActive) {
        $('#editCategoryId').val(id);
        $('#editCategoryName').val(name);
        $('#editCategoryNameMarathi').val(nameMarathi || '');
        $('#editCategoryDescription').val(desc);
        $('#editCategoryOrder').val(order);
        $('#editCategoryActive').prop('checked', isActive);
        new bootstrap.Modal('#editCategoryModal').show();
    }

    function editMenuItem(id, catId, name, nameMarathi, code, shortCode, desc, price, tax, isVeg, prepTime, kitchenCat, isActive) {
        $('#editMenuItemId').val(id);
        $('#editMenuItemCatId').val(catId);
        $('#editMenuItemName').val(name);
        $('#editMenuItemNameMarathi').val(nameMarathi || '');
        $('#editMenuItemCode').val(code || '');
        $('#editMenuItemShortCode').val(shortCode || '');
        $('#editMenuItemDesc').val(desc);
        $('#editMenuItemPrice').val(price);
        $('#editMenuItemTax').val(tax);
        $('#editMenuItemIsVeg').val(isVeg ? "true" : "false");
        $('#editMenuItemPrepTime').val(prepTime);
        $('#editMenuItemKitchenCat').val(kitchenCat || 'Main Kitchen');
        $('#editMenuItemActive').prop('checked', isActive);
        new bootstrap.Modal('#editMenuItemModal').show();
    }

    function editCustomer(id, name, phone, email, address, gstin, notes, points, isActive) {
        $('#editCustomerId').val(id);
        $('#editCustomerName').val(name);
        $('#editCustomerPhone').val(phone);
        $('#editCustomerEmail').val(email || '');
        $('#editCustomerAddress').val(address || '');
        $('#editCustomerGSTIN').val(gstin || '');
        $('#editCustomerNotes').val(notes || '');
        $('#editCustomerPoints').val(points || 0);
        $('#editCustomerActive').prop('checked', isActive);
        new bootstrap.Modal('#editCustomerModal').show();
    }

    function filterCustomerMaster() {
        var query = ($('#customerMasterSearchInput').val() || '').toLowerCase();
        $('#customerMasterTable tbody tr.customer-row').each(function() {
            var rowText = $(this).text().toLowerCase();
            $(this).toggle(rowText.indexOf(query) > -1);
        });
    }

    function editSupplier(id, name, contact, phone, email, address, gst, balance, isActive) {
        $('#editSupplierId').val(id);
        $('#editSupplierName').val(name);
        $('#editSupplierContact').val(contact || '');
        $('#editSupplierPhone').val(phone);
        $('#editSupplierEmail').val(email || '');
        $('#editSupplierAddress').val(address || '');
        $('#editSupplierGST').val(gst || '');
        $('#editSupplierBalance').val(balance || 0);
        $('#editSupplierActive').prop('checked', isActive);
        new bootstrap.Modal('#editSupplierModal').show();
    }

    function editEmployee(id, name, email, phone, role, shift, salary, isActive) {
        $('#editEmpId').val(id);
        $('#editEmpName').val(name);
        $('#editEmpEmail').val(email);
        $('#editEmpPhone').val(phone);
        $('#editEmpRole').val(role);
        $('#editEmpShift').val(shift);
        $('#editEmpSalary').val(salary);
        $('#editEmpIsActive').val(isActive ? "true" : "false");
        new bootstrap.Modal('#editEmployeeModal').show();
    }

    function adjustStock(id, name, unit) {
        $('#adjustItemId').val(id);
        $('#adjustItemName').text(name);
        $('#adjustItemUnit').text(unit);
        new bootstrap.Modal('#adjustStockModal').show();
    }

    $(document).ready(function() {
        @if (Model.OpenAdd)
        {
            <text>
            setTimeout(function() {
                var addModal = new bootstrap.Modal(document.getElementById('addMenuItemModal'));
                addModal.show();
            }, 300);
            </text>
        }
    });
</script>
}
