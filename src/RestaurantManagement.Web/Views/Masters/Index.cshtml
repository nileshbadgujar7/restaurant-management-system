@using RestaurantManagement.Domain.Entities
@model MastersViewModel
@{
    ViewData["Title"] = "Masters";
    var activeTab = (Model.ActiveTab ?? "floor").ToLower();
}

<!-- Breadcrumb & Top Bar -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 animated-fade-in">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 fs-6">
                <li class="breadcrumb-item">
                    <a href="/Dashboard" class="text-decoration-none fw-semibold text-success">
                        <i class="fa-solid fa-chart-pie me-1" data-bs-toggle="tooltip" title="Dashboard"></i> Dashboard
                    </a>
                </li>
                <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">
                    <i class="fa-solid fa-layer-group text-primary me-1"></i> Masters
                </li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-layer-group text-primary me-2"></i>Masters
        </h2>
    </div>
    <div>
        <a href="/Dashboard" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm" data-bs-toggle="tooltip" title="Return to main dashboard">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Modern Horizontal Masters Tabs Navigation -->
<div class="glass-card p-2 mb-4 animated-fade-in shadow-sm">
    <div class="masters-nav-tabs" id="mastersTab" role="tablist">
        <button class="masters-nav-tab-btn @(activeTab == "floor" ? "active" : "")" 
                id="floor-tab" data-bs-toggle="tab" data-bs-target="#floor-pane" type="button" role="tab" title="Floors & Zones">
            <i class="fa-solid fa-building text-warning fs-5"></i>
            <span>Floors</span>
            <span class="badge bg-light text-dark border ms-1">@Model.Floors.Count()</span>
        </button>

        <button class="masters-nav-tab-btn @(activeTab == "table" ? "active" : "")" 
                id="table-tab" data-bs-toggle="tab" data-bs-target="#table-pane" type="button" role="tab" title="Dining Tables">
            <i class="fa-solid fa-chair text-info fs-5"></i>
            <span>Tables</span>
            <span class="badge bg-light text-dark border ms-1">@Model.Tables.Count()</span>
        </button>

        <button class="masters-nav-tab-btn @(activeTab == "menu" ? "active" : "")" 
                id="menu-tab" data-bs-toggle="tab" data-bs-target="#menu-pane" type="button" role="tab" title="Food & Beverage Menu">
            <i class="fa-solid fa-bowl-food text-success fs-5"></i>
            <span>Menu Items</span>
            <span class="badge bg-light text-dark border ms-1">@Model.MenuItems.Count()</span>
        </button>

        <button class="masters-nav-tab-btn @(activeTab == "category" ? "active" : "")" 
                id="category-tab" data-bs-toggle="tab" data-bs-target="#category-pane" type="button" role="tab" title="Menu Categories">
            <i class="fa-solid fa-tags text-primary fs-5"></i>
            <span>Categories</span>
            <span class="badge bg-light text-dark border ms-1">@Model.Categories.Count()</span>
        </button>

        <button class="masters-nav-tab-btn @(activeTab == "employee" ? "active" : "")" 
                id="employee-tab" data-bs-toggle="tab" data-bs-target="#employee-pane" type="button" role="tab" title="Staff & Personnel">
            <i class="fa-solid fa-users text-danger fs-5"></i>
            <span>Employees</span>
            <span class="badge bg-light text-dark border ms-1">@Model.Employees.Count()</span>
        </button>

        <button class="masters-nav-tab-btn @(activeTab == "inventory" ? "active" : "")" 
                id="inventory-tab" data-bs-toggle="tab" data-bs-target="#inventory-pane" type="button" role="tab" title="Inventory & Raw Stock">
            <i class="fa-solid fa-boxes-stacked text-secondary fs-5"></i>
            <span>Inventory</span>
            <span class="badge bg-light text-dark border ms-1">@Model.InventoryItems.Count()</span>
        </button>

        <button class="masters-nav-tab-btn @(activeTab == "settings" ? "active" : "")" 
                id="settings-tab" data-bs-toggle="tab" data-bs-target="#settings-pane" type="button" role="tab" title="Restaurant & Tax Configuration">
            <i class="fa-solid fa-gear text-dark fs-5"></i>
            <span>Settings</span>
            <span class="badge bg-light text-dark border ms-1">GST & Info</span>
        </button>
    </div>
</div>

<!-- Tab Contents -->
<div class="tab-content" id="mastersTabContent">

    <!-- ==================== TAB 1: FLOORS ==================== -->
    <div class="tab-pane fade @(activeTab == "floor" ? "show active" : "")" id="floor-pane" role="tabpanel">
        <div class="glass-card p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-building text-warning me-2"></i>Floors</h4>
                <button class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addFloorModal" title="Add a new dining floor">
                    <i class="fa-solid fa-plus me-1"></i> Add Floor
                </button>
            </div>

            <div class="table-responsive">
                <table class="table app-datagrid align-middle">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th>Floor Name</th>
                            <th>Description</th>
                            <th>Display Order</th>
                            <th>Total Tables</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var floor in Model.Floors)
                        {
                            <tr>
                                <td class="fw-bold text-muted">#@floor.Id</td>
                                <td>
                                    <span class="fw-bold text-dark fs-6 d-flex align-items-center gap-2">
                                        <i class="fa-solid fa-layer-group text-warning"></i>
                                        @floor.Name
                                    </span>
                                </td>
                                <td class="text-secondary">@(string.IsNullOrWhiteSpace(floor.Description) ? "—" : floor.Description)</td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1">Order @floor.DisplayOrder</span>
                                </td>
                                <td>
                                    <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-1 fw-bold">
                                        <i class="fa-solid fa-chair me-1"></i>@floor.Tables.Count Tables
                                    </span>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1" 
                                            onclick="editFloor(@floor.Id, '@floor.Name', '@floor.Description', @floor.DisplayOrder)" 
                                            data-bs-toggle="tooltip" title="Edit floor details">
                                        <i class="fa-solid fa-pen-to-square"></i> Edit
                                    </button>
                                    <form asp-action="DeleteFloor" method="post" class="d-inline" onsubmit="return confirm('Delete floor @floor.Name? This will fail if tables exist on this floor.');">
                                        <input type="hidden" name="id" value="@floor.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2" data-bs-toggle="tooltip" title="Delete floor">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ==================== TAB 2: TABLES ==================== -->
    <div class="tab-pane fade @(activeTab == "table" ? "show active" : "")" id="table-pane" role="tabpanel">
        <div class="glass-card p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-chair text-info me-2"></i>Tables</h4>
                <div class="d-flex gap-2">
                    <a href="/Tables" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm" data-bs-toggle="tooltip" title="Open visual floor plan">
                        <i class="fa-solid fa-eye me-1"></i> Live Floor Plan
                    </a>
                    <button class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addTableModal" title="Add a new dining table">
                        <i class="fa-solid fa-plus me-1"></i> Add Table
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table app-datagrid align-middle">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th>Table Number</th>
                            <th>Floor</th>
                            <th>Capacity</th>
                            <th>Current Status</th>
                            <th>Current Order</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var table in Model.Tables)
                        {
                            string badgeClass = table.Status switch {
                                TableStatus.Available => "badge-available",
                                TableStatus.Occupied => "badge-occupied",
                                TableStatus.Reserved => "badge-reserved",
                                TableStatus.Billing => "badge-billing",
                                _ => "badge-cleaning"
                            };

                            <tr>
                                <td class="fw-bold text-muted">#@table.Id</td>
                                <td>
                                    <span class="fw-bold text-dark fs-6 d-flex align-items-center gap-2">
                                        <i class="fa-solid fa-chair text-info"></i>
                                        @table.TableNumber
                                    </span>
                                </td>
                                <td>
                                    <span class="floor-tag-badge">
                                        <i class="fa-solid fa-layer-group me-1"></i>@table.FloorName
                                    </span>
                                </td>
                                <td>
                                    <span class="seat-pill">
                                        <i class="fa-solid fa-users text-muted me-1"></i>@table.Capacity Guests
                                    </span>
                                </td>
                                <td>
                                    <span class="status-badge @badgeClass">@table.StatusName</span>
                                </td>
                                <td>
                                    @if (table.CurrentOrderId.HasValue)
                                    {
                                        <span class="fw-bold text-success">₹@table.CurrentOrderAmount.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1" 
                                            onclick="editTable(@table.Id, '@table.TableNumber', @table.FloorId, @table.Capacity)" 
                                            data-bs-toggle="tooltip" title="Edit table details">
                                        <i class="fa-solid fa-pen-to-square"></i> Edit
                                    </button>
                                    <form asp-action="DeleteTable" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete @table.TableNumber?');">
                                        <input type="hidden" name="id" value="@table.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2" data-bs-toggle="tooltip" title="Delete table">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ==================== TAB 3: MENU ITEMS ==================== -->
    <div class="tab-pane fade @(activeTab == "menu" ? "show active" : "")" id="menu-pane" role="tabpanel">
        <div class="glass-card p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-bowl-food text-success me-2"></i>Menu Items</h4>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#addCategoryModal" title="Add a new category">
                        <i class="fa-solid fa-folder-plus me-1"></i> Add Category
                    </button>
                    <button class="btn btn-success rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addMenuItemModal" title="Add a new food dish or beverage">
                        <i class="fa-solid fa-plus me-1"></i> Add Menu Item
                    </button>
                </div>
            </div>

            <!-- Categories Quick Filter Pills -->
            <div class="d-flex flex-wrap gap-2 mb-4 pb-3 border-bottom align-items-center">
                <span class="fw-bold text-secondary small me-2"><i class="fa-solid fa-tags me-1"></i>Categories:</span>
                @foreach (var cat in Model.Categories)
                {
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill d-flex align-items-center gap-2">
                        <strong>@cat.Name</strong>
                        <span class="badge bg-secondary rounded-pill">@cat.ItemCount</span>
                        <button class="btn btn-link text-primary p-0 border-0" onclick="editCategory(@cat.Id, '@cat.Name', '@cat.Description', @cat.DisplayOrder)" title="Edit Category">
                            <i class="fa-solid fa-pen-to-square small"></i>
                        </button>
                    </span>
                }
            </div>

            <div class="table-responsive">
                <table class="table app-datagrid align-middle">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th>Dish / Item Name</th>
                            <th>Category</th>
                            <th>Type</th>
                            <th>Price</th>
                            <th>Prep Time</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.MenuItems)
                        {
                            <tr>
                                <td class="fw-bold text-muted">#@item.Id</td>
                                <td>
                                    <div>
                                        <span class="fw-bold text-dark fs-6">@item.Name</span>
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <div class="small text-muted text-truncate" style="max-width: 250px;">@item.Description</div>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill px-3 py-1">
                                        @item.CategoryName
                                    </span>
                                </td>
                                <td>
                                    @if (item.IsVeg)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                            <i class="fa-solid fa-leaf me-1"></i>Veg
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">
                                            <i class="fa-solid fa-drumstick-bite me-1"></i>Non-Veg
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="fw-bold text-dark fs-6">₹@item.Price.ToString("N0")</span>
                                </td>
                                <td>
                                    <span class="small text-secondary">
                                        <i class="fa-regular fa-clock me-1"></i>@item.PreparationTimeMinutes mins
                                    </span>
                                </td>
                                <td>
                                    <form asp-action="ToggleMenuItemAvailability" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        @if (item.IsAvailable)
                                        {
                                            <button type="submit" class="badge bg-success border-0 px-3 py-2 rounded-pill text-white cursor-pointer" data-bs-toggle="tooltip" title="Click to mark Out of Stock">
                                                <i class="fa-solid fa-check me-1"></i> Available
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="badge bg-danger border-0 px-3 py-2 rounded-pill text-white cursor-pointer" data-bs-toggle="tooltip" title="Click to mark Available">
                                                <i class="fa-solid fa-ban me-1"></i> Out of Stock
                                            </button>
                                        }
                                    </form>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1" 
                                            onclick="editMenuItem(@item.Id, @item.CategoryId, '@item.Name', '@item.Description', @item.Price, @item.TaxPercentage, @(item.IsVeg ? "true" : "false"), @item.PreparationTimeMinutes)" 
                                            data-bs-toggle="tooltip" title="Edit menu item">
                                        <i class="fa-solid fa-pen-to-square"></i> Edit
                                    </button>
                                    <form asp-action="DeleteMenuItem" method="post" class="d-inline" onsubmit="return confirm('Delete @item.Name from menu?');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2" data-bs-toggle="tooltip" title="Delete menu item">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ==================== TAB 4: CATEGORIES ==================== -->
    <div class="tab-pane fade @(activeTab == "category" ? "show active" : "")" id="category-pane" role="tabpanel">
        <div class="glass-card p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-tags text-primary me-2"></i>Categories</h4>
                <button class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addCategoryModal" title="Add a new category">
                    <i class="fa-solid fa-plus me-1"></i> Add Category
                </button>
            </div>

            <div class="table-responsive">
                <table class="table app-datagrid align-middle">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th>Category Name</th>
                            <th>Description</th>
                            <th>Display Order</th>
                            <th>Total Menu Items</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in Model.Categories)
                        {
                            <tr>
                                <td class="fw-bold text-muted">#@cat.Id</td>
                                <td>
                                    <span class="fw-bold text-dark fs-6 d-flex align-items-center gap-2">
                                        <i class="fa-solid fa-tag text-primary"></i>
                                        @cat.Name
                                    </span>
                                </td>
                                <td class="text-secondary">@(string.IsNullOrWhiteSpace(cat.Description) ? "—" : cat.Description)</td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1">Order @cat.DisplayOrder</span>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 fw-bold">
                                        @cat.ItemCount Items
                                    </span>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1" 
                                            onclick="editCategory(@cat.Id, '@cat.Name', '@cat.Description', @cat.DisplayOrder)" 
                                            data-bs-toggle="tooltip" title="Edit category">
                                        <i class="fa-solid fa-pen-to-square"></i> Edit
                                    </button>
                                    <form asp-action="DeleteCategory" method="post" class="d-inline" onsubmit="return confirm('Delete category @cat.Name?');">
                                        <input type="hidden" name="id" value="@cat.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2" data-bs-toggle="tooltip" title="Delete category">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ==================== TAB 5: EMPLOYEES ==================== -->
    <div class="tab-pane fade @(activeTab == "employee" ? "show active" : "")" id="employee-pane" role="tabpanel">
        <div class="glass-card p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-users text-danger me-2"></i>Employees</h4>
                <button class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addEmployeeModal" title="Register a new employee">
                    <i class="fa-solid fa-user-plus me-1"></i> Add Employee
                </button>
            </div>

            <!-- Role Summary Badges -->
            <div class="d-flex flex-wrap gap-2 mb-4 pb-3 border-bottom">
                <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle px-3 py-2 rounded-pill">
                    All Staff: <strong>@Model.Employees.Count()</strong>
                </span>
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill">
                    <i class="fa-solid fa-briefcase me-1"></i>Managers: <strong>@Model.Employees.Count(e => e.Role == UserRole.Manager)</strong>
                </span>
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 rounded-pill">
                    <i class="fa-solid fa-kitchen-set me-1"></i>Cooks / Kitchen: <strong>@Model.Employees.Count(e => e.Role == UserRole.Cook || e.Role == UserRole.KitchenStaff)</strong>
                </span>
                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-3 py-2 rounded-pill">
                    <i class="fa-solid fa-tray me-1"></i>Waiters: <strong>@Model.Employees.Count(e => e.Role == UserRole.Waiter)</strong>
                </span>
                <span class="badge bg-teal-subtle text-teal border px-3 py-2 rounded-pill" style="background:#ccfbf1; color:#0f766e; border-color:#99f6e4;">
                    <i class="fa-solid fa-broom me-1"></i>Housekeeping: <strong>@Model.Employees.Count(e => e.Role == UserRole.Housekeeping)</strong>
                </span>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                    <i class="fa-solid fa-cash-register me-1"></i>Cashiers: <strong>@Model.Employees.Count(e => e.Role == UserRole.Cashier)</strong>
                </span>
            </div>

            <div class="table-responsive">
                <table class="table app-datagrid align-middle">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th>Employee Name</th>
                            <th>Role / Designation</th>
                            <th>Contact Phone</th>
                            <th>Email</th>
                            <th>Work Shift</th>
                            <th>Base Salary</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in Model.Employees)
                        {
                            string roleBadgeClass = emp.Role switch {
                                UserRole.Admin => "bg-danger text-white",
                                UserRole.Manager => "bg-dark text-white",
                                UserRole.Cashier => "bg-success text-white",
                                UserRole.Waiter => "bg-info text-white",
                                UserRole.Cook => "bg-warning text-dark",
                                UserRole.KitchenStaff => "bg-warning text-dark",
                                UserRole.Housekeeping => "text-white",
                                _ => "bg-secondary text-white"
                            };

                            string roleIcon = emp.Role switch {
                                UserRole.Admin => "fa-user-gear",
                                UserRole.Manager => "fa-briefcase",
                                UserRole.Cashier => "fa-cash-register",
                                UserRole.Waiter => "fa-tray",
                                UserRole.Cook => "fa-kitchen-set",
                                UserRole.KitchenStaff => "fa-fire-burner",
                                UserRole.Housekeeping => "fa-broom",
                                _ => "fa-user"
                            };

                            <tr>
                                <td class="fw-bold text-muted">#@emp.Id</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center text-primary fw-bold" style="width:36px; height:36px;">
                                            @emp.Name.FirstOrDefault()
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark fs-6">@emp.Name</div>
                                            <div class="small text-muted">Joined: @emp.JoiningDate.ToString("MMM yyyy")</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @roleBadgeClass px-3 py-1 rounded-pill" style="@(emp.Role == UserRole.Housekeeping ? "background-color: #0d9488;" : "")">
                                        <i class="fa-solid @roleIcon me-1"></i>@emp.RoleName
                                    </span>
                                </td>
                                <td>
                                    <span class="text-dark fw-semibold">
                                        <i class="fa-solid fa-phone text-muted me-1 small"></i>@emp.Phone
                                    </span>
                                </td>
                                <td>
                                    <span class="text-secondary small">@(string.IsNullOrWhiteSpace(emp.Email) ? "—" : emp.Email)</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1">
                                        <i class="fa-regular fa-sun text-warning me-1"></i>@emp.Shift
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark">₹@emp.BaseSalary.ToString("N0")</span>
                                </td>
                                <td>
                                    @if (emp.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1" 
                                            onclick="editEmployee(@emp.Id, '@emp.Name', '@emp.Email', '@emp.Phone', @((int)emp.Role), '@emp.Shift', @emp.BaseSalary, @(emp.IsActive ? "true" : "false"))" 
                                            data-bs-toggle="tooltip" title="Edit employee profile">
                                        <i class="fa-solid fa-pen-to-square"></i> Edit
                                    </button>
                                    <form asp-action="DeleteEmployee" method="post" class="d-inline" onsubmit="return confirm('Remove employee @emp.Name?');">
                                        <input type="hidden" name="id" value="@emp.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2" data-bs-toggle="tooltip" title="Delete employee">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ==================== TAB 6: INVENTORY ==================== -->
    <div class="tab-pane fade @(activeTab == "inventory" ? "show active" : "")" id="inventory-pane" role="tabpanel">
        <div class="glass-card p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-boxes-stacked text-secondary me-2"></i>Inventory</h4>
                <a href="/Inventory" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm" data-bs-toggle="tooltip" title="Open full inventory system">
                    <i class="fa-solid fa-boxes-stacked me-1"></i> Open Stock System
                </a>
            </div>

            <div class="table-responsive">
                <table class="table app-datagrid align-middle">
                    <thead>
                        <tr>
                            <th>Ingredient Item</th>
                            <th>Category</th>
                            <th>Current Stock</th>
                            <th>Minimum Level</th>
                            <th>Unit Cost</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.InventoryItems)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@item.Name</td>
                                <td><span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle px-2 py-1 rounded-pill">@item.Category</span></td>
                                <td class="fw-bold fs-6 @(item.IsLowStock ? "text-danger" : "text-success")">
                                    @item.CurrentStock @item.Unit
                                </td>
                                <td class="small text-secondary">@item.MinimumStock @item.Unit</td>
                                <td class="text-dark">₹@item.UnitCost.ToString("N0") / @item.Unit</td>
                                <td>
                                    @if (item.CurrentStock <= (item.MinimumStock / 2m))
                                    {
                                        <span class="badge bg-danger px-3 py-1 rounded-pill"><i class="fa-solid fa-circle-exclamation me-1"></i> Critical Low</span>
                                    }
                                    else if (item.IsLowStock)
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-1 rounded-pill"><i class="fa-solid fa-triangle-exclamation me-1"></i> Low Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i> Optimal</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="adjustStock(@item.Id, '@item.Name', '@item.Unit')">
                                        <i class="fa-solid fa-sliders me-1"></i> Adjust Stock
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ==================== TAB 7: SETTINGS ==================== -->
    <div class="tab-pane fade @(activeTab == "settings" ? "show active" : "")" id="settings-pane" role="tabpanel">
        <div class="glass-card p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-gear text-dark me-2"></i>Settings</h4>
            </div>

            @{
                var setting = Model.Setting ?? new RestaurantSetting();
            }
            <form asp-action="UpdateSettings" method="post" class="needs-validation">
                <input type="hidden" name="Id" value="@setting.Id" />
                
                <h5 class="fw-bold text-primary mb-3"><i class="fa-solid fa-store me-2"></i>Restaurant Profile</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Restaurant Brand Name</label>
                        <input type="text" name="RestaurantName" class="form-control" value="@setting.RestaurantName" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">GSTIN (Tax Identification Number)</label>
                        <input type="text" name="GSTIN" class="form-control" value="@setting.GSTIN" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Phone Contact</label>
                        <input type="tel" name="Phone" class="form-control" value="@setting.Phone" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Official Email</label>
                        <input type="email" name="Email" class="form-control" value="@setting.Email" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold small">Physical Address (Appears on Tax Invoices)</label>
                        <textarea name="Address" class="form-control" rows="2">@setting.Address</textarea>
                    </div>
                </div>

                <h5 class="fw-bold text-success mb-3 border-top pt-4"><i class="fa-solid fa-percent me-2"></i>Tax & Surcharge Configuration</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <label class="form-label fw-bold small">Currency Symbol</label>
                        <input type="text" name="CurrencySymbol" class="form-control" value="@setting.CurrencySymbol" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small">CGST (%)</label>
                        <input type="number" step="0.1" name="CGSTPercentage" class="form-control" value="@setting.CGSTPercentage" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small">SGST (%)</label>
                        <input type="number" step="0.1" name="SGSTPercentage" class="form-control" value="@setting.SGSTPercentage" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small">Service Charge (%)</label>
                        <input type="number" step="0.1" name="ServiceChargePercentage" class="form-control" value="@setting.ServiceChargePercentage" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Takeaway Packaging Charge (₹)</label>
                        <input type="number" step="1" name="PackagingCharge" class="form-control" value="@setting.PackagingCharge" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Delivery Charge (₹)</label>
                        <input type="number" step="1" name="DeliveryCharge" class="form-control" value="@setting.DeliveryCharge" />
                    </div>
                </div>

                <div class="row g-3 mb-4 border-top pt-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Manager Security PIN</label>
                        <input type="password" name="ManagerPIN" class="form-control" value="@setting.ManagerPIN" placeholder="Default: 1234" />
                    </div>
                </div>

                <div class="border-top pt-3 d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary rounded-pill px-5 shadow-sm fw-bold">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Save Settings
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

