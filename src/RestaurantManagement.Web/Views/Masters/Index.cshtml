<!-- 11. Adjust Stock Modal -->
<div class="modal fade" id="adjustStockModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="AdjustStock" method="post" class="modal-content rounded-4 border-0 shadow-lg">
            <input type="hidden" name="InventoryItemId" id="adjustItemId" />
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-sliders text-primary me-2"></i>Adjust Stock: <span id="adjustItemName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold small">Action Type</label>
                    <select name="TransactionType" class="form-select">
                        <option value="IN">Stock In (Purchase Receive)</option>
                        <option value="OUT">Stock Out (Manual Deduction)</option>
                        <option value="WASTAGE">Wastage / Spoiled</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Quantity (<span id="adjustItemUnit"></span>)</label>
                    <input type="number" step="0.01" name="Quantity" class="form-control" placeholder="e.g. 10" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Notes / Reason</label>
                    <input type="text" name="Notes" class="form-control" placeholder="Stock update notes..." />
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary rounded-pill px-4">Record Adjustment</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function editFloor(id, name, desc, order) {
        $('#editFloorId').val(id);
        $('#editFloorName').val(name);
        $('#editFloorDescription').val(desc);
        $('#editFloorOrder').val(order);
        new bootstrap.Modal('#editFloorModal').show();
    }

    function editTable(id, number, floorId, cap) {
        $('#editTableId').val(id);
        $('#editTableNumber').val(number);
        $('#editTableFloorId').val(floorId);
        $('#editTableCapacity').val(cap);
        new bootstrap.Modal('#editTableModal').show();
    }

    function editCategory(id, name, desc, order) {
        $('#editCategoryId').val(id);
        $('#editCategoryName').val(name);
        $('#editCategoryDescription').val(desc);
        $('#editCategoryOrder').val(order);
        new bootstrap.Modal('#editCategoryModal').show();
    }

    function editMenuItem(id, catId, name, desc, price, tax, isVeg, prepTime) {
        $('#editMenuItemId').val(id);
        $('#editMenuItemCatId').val(catId);
        $('#editMenuItemName').val(name);
        $('#editMenuItemDesc').val(desc);
        $('#editMenuItemPrice').val(price);
        $('#editMenuItemTax').val(tax);
        $('#editMenuItemIsVeg').val(isVeg ? "true" : "false");
        $('#editMenuItemPrepTime').val(prepTime);
        new bootstrap.Modal('#editMenuItemModal').show();
    }

    function editEmployee(id, name, email, phone, role, shift, salary, isActive) {
        $('#editEmpId').val(id);
        $('#editEmpName').val(name);
        $('#editEmpEmail').val(email);
        $('#editEmpPhone').val(phone);
        $('#editEmpRole').val(role);
        $('#editEmpShift').val(shift);
        $('#editEmpSalary').val(salary);
        $('#editEmpIsActive').val(isActive ? "true" : "false");
        new bootstrap.Modal('#editEmployeeModal').show();
    }

    function adjustStock(id, name, unit) {
        $('#adjustItemId').val(id);
        $('#adjustItemName').text(name);
        $('#adjustItemUnit').text(unit);
        new bootstrap.Modal('#adjustStockModal').show();
    }

    $(document).ready(function() {
        @if (Model.OpenAdd)
        {
            <text>
            setTimeout(function() {
                var addModal = new bootstrap.Modal(document.getElementById('addMenuItemModal'));
                addModal.show();
            }, 300);
            </text>
        }
    });
</script>
}
