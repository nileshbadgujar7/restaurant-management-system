                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Category Name (मराठी)</label>
                    <input type="text" name="NameMarathi" class="form-control" placeholder="e.g. स्टार्टर्स आणि स्नॅक्स" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Description</label>
