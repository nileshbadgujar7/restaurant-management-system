@using RestaurantManagement.Domain.Entities
@using RestaurantManagement.Domain.Enums
@model MastersViewModel
@{
    ViewData["Title"] = "Masters";
    var activeTab = (Model.ActiveTab ?? "floor").ToLower();
}

<!-- Breadcrumb & Top Bar -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 animated-fade-in">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 fs-6">
                <li class="breadcrumb-item">
                    <a href="/Dashboard" class="text-decoration-none fw-semibold text-success">
                        <i class="fa-solid fa-chart-pie me-1" data-bs-toggle="tooltip" title="Dashboard"></i> Dashboard
                    </a>
                </li>
                <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">
                    <i class="fa-solid fa-layer-group text-primary me-1"></i> Masters
                </li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-layer-group text-primary me-2"></i>Masters
        </h2>
    </div>
    <div>
        <a href="/Dashboard" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm" data-bs-toggle="tooltip" title="Return to main dashboard">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Modern Horizontal Masters Tabs Navigation -->
<div class="glass-card p-2 mb-4 animated-fade-in shadow-sm">
    <div class="masters-nav-tabs" id="mastersTab" role="tablist">
        <button class="masters-nav-tab-btn @(activeTab == "floor" ? "active" : "")" 
                id="floor-tab" data-bs-toggle="tab" data-bs-target="#floor-pane" type="button" role="tab" title="Floors & Zones">
            <i class="fa-solid fa-building text-warning fs-5"></i>
            <span>Floors</span>
            <span class="badge bg-light text-dark border ms-1">@Model.Floors.Count()</span>
        </button>

        <button class="masters-nav-tab-btn @(activeTab == "table" ? "active" : "")" 
                id="table-tab" data-bs-toggle="tab" data-bs-target="#table-pane" type="button" role="tab" title="Dining Tables">
            <i class="fa-solid fa-chair text-info fs-5"></i>
            <span>Tables</span>
            <span class="badge bg-light text-dark border ms-1">@Model.Tables.Count()</span>
        </button>

        <button class="masters-nav-tab-btn @(activeTab == "menu" ? "active" : "")" 
                id="menu-tab" data-bs-toggle="tab" data-bs-target="#menu-pane" type="button" role="tab" title="Food & Beverage Menu">
            <i class="fa-solid fa-bowl-food text-success fs-5"></i>
            <span>Menu Items</span>
            <span class="badge bg-light text-dark border ms-1">@Model.MenuItems.Count()</span>
        </button>

        <button class="masters-nav-tab-btn @(activeTab == "category" ? "active" : "")" 
                id="category-tab" data-bs-toggle="tab" data-bs-target="#category-pane" type="button" role="tab" title="Menu Categories">
            <i class="fa-solid fa-tags text-primary fs-5"></i>
            <span>Categories</span>
            <span class="badge bg-light text-dark border ms-1">@Model.Categories.Count()</span>
        </button>

        <button class="masters-nav-tab-btn @(activeTab == "supplier" ? "active" : "")" 
                id="supplier-tab" data-bs-toggle="tab" data-bs-target="#supplier-pane" type="button" role="tab" title="Suppliers & Vendors">
            <i class="fa-solid fa-truck text-dark fs-5"></i>
            <span>Suppliers</span>
            <span class="badge bg-light text-dark border ms-1">@Model.Suppliers.Count()</span>
        </button>

        <button class="masters-nav-tab-btn @(activeTab == "customer" ? "active" : "")" 
                id="customer-tab" data-bs-toggle="tab" data-bs-target="#customer-pane" type="button" role="tab" title="Customer Masters">
            <i class="fa-solid fa-address-book text-success fs-5"></i>
            <span>Customers</span>
            <span class="badge bg-light text-dark border ms-1">@Model.Customers.Count()</span>
        </button>

        <button class="masters-nav-tab-btn @(activeTab == "employee" ? "active" : "")" 
                id="employee-tab" data-bs-toggle="tab" data-bs-target="#employee-pane" type="button" role="tab" title="Staff & Personnel">
            <i class="fa-solid fa-users text-danger fs-5"></i>
            <span>Employees</span>
            <span class="badge bg-light text-dark border ms-1">@Model.Employees.Count()</span>
        </button>

        <button class="masters-nav-tab-btn @(activeTab == "inventory" ? "active" : "")" 
                id="inventory-tab" data-bs-toggle="tab" data-bs-target="#inventory-pane" type="button" role="tab" title="Inventory & Raw Stock">
            <i class="fa-solid fa-boxes-stacked text-secondary fs-5"></i>
            <span>Inventory</span>
            <span class="badge bg-light text-dark border ms-1">@Model.InventoryItems.Count()</span>
        </button>

        <button class="masters-nav-tab-btn @(activeTab == "settings" ? "active" : "")" 
                id="settings-tab" data-bs-toggle="tab" data-bs-target="#settings-pane" type="button" role="tab" title="Application Configurations & Settings">
            <i class="fa-solid fa-gear text-dark fs-5"></i>
            <span>Configurations</span>
            <span class="badge bg-light text-dark border ms-1">Master</span>
        </button>
    </div>
</div>

<!-- Tab Contents -->
<div class="tab-content" id="mastersTabContent">

    <!-- ==================== TAB 1: FLOORS (Section 5.1) ==================== -->
    <div class="tab-pane fade @(activeTab == "floor" ? "show active" : "")" id="floor-pane" role="tabpanel">
        <div class="glass-card p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-building text-warning me-2"></i>Floors</h4>
                <button class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addFloorModal" title="Add a new dining floor">
                    <i class="fa-solid fa-plus me-1"></i> Add Floor
                </button>
            </div>

            <div class="table-responsive">
                <table class="table app-datagrid align-middle">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th>Floor Name</th>
                            <th>Description</th>
                            <th>Display Order</th>
                            <th>Total Tables</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var floor in Model.Floors)
                        {
                            <tr>
                                <td class="fw-bold text-muted">#@floor.Id</td>
                                <td>
                                    <span class="fw-bold text-dark fs-6 d-flex align-items-center gap-2">
                                        <i class="fa-solid fa-layer-group text-warning"></i>
                                        @floor.Name
                                    </span>
                                </td>
                                <td class="text-secondary">@(string.IsNullOrWhiteSpace(floor.Description) ? "—" : floor.Description)</td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1">Order @floor.DisplayOrder</span>
                                </td>
                                <td>
                                    <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-1 fw-bold">
                                        <i class="fa-solid fa-chair me-1"></i>@floor.Tables.Count Tables
                                    </span>
                                </td>
                                <td>
                                    @if (floor.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1" 
                                            onclick="editFloor(@floor.Id, '@floor.Name', '@floor.Description', @floor.DisplayOrder, @(floor.IsActive ? "true" : "false"))" 
                                            data-bs-toggle="tooltip" title="Edit floor details">
                                        <i class="fa-solid fa-pen-to-square"></i> Edit
                                    </button>
                                    <form asp-action="ToggleFloorStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@floor.Id" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-2 me-1" data-bs-toggle="tooltip" title="Toggle active/inactive status">
                                            <i class="fa-solid fa-power-off @(floor.IsActive ? "text-success" : "text-muted")"></i>
                                        </button>
                                    </form>
                                    <form asp-action="DeleteFloor" method="post" class="d-inline" onsubmit="return confirm('Delete floor @floor.Name? This will be blocked if tables depend on this floor.');">
                                        <input type="hidden" name="id" value="@floor.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2" data-bs-toggle="tooltip" title="Delete floor">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ==================== TAB 2: TABLES (Section 5.2) ==================== -->
    <div class="tab-pane fade @(activeTab == "table" ? "show active" : "")" id="table-pane" role="tabpanel">
        <div class="glass-card p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-chair text-info me-2"></i>Tables</h4>
                <div class="d-flex gap-2">
                    <a href="/Tables" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm" data-bs-toggle="tooltip" title="Open visual floor plan">
                        <i class="fa-solid fa-eye me-1"></i> Live Floor Plan
                    </a>
                    <button class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addTableModal" title="Add a new dining table">
                        <i class="fa-solid fa-plus me-1"></i> Add Table
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table app-datagrid align-middle">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th>Table Number</th>
                            <th>Floor</th>
                            <th>Capacity</th>
                            <th>Type</th>
                            <th>Live Status</th>
                            <th>Master Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var table in Model.Tables)
                        {
                            string badgeClass = table.Status switch {
                                TableStatus.Available => "badge-available",
                                TableStatus.Occupied => "badge-occupied",
                                TableStatus.Reserved => "badge-reserved",
                                TableStatus.Billing => "badge-billing",
                                _ => "badge-cleaning"
                            };

                            <tr>
                                <td class="fw-bold text-muted">#@table.Id</td>
                                <td>
                                    <span class="fw-bold text-dark fs-6 d-flex align-items-center gap-2">
                                        <i class="fa-solid fa-chair text-info"></i>
                                        @table.TableNumber
                                    </span>
                                </td>
                                <td>
                                    <span class="floor-tag-badge">
                                        <i class="fa-solid fa-layer-group me-1"></i>@table.FloorName
                                    </span>
                                </td>
                                <td>
                                    <span class="seat-pill">
                                        <i class="fa-solid fa-users text-muted me-1"></i>@table.Capacity Guests
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1">@table.TableType</span>
                                </td>
                                <td>
                                    <span class="status-badge @badgeClass">@table.StatusName</span>
                                    @if (table.CurrentOrderId.HasValue && table.CurrentOrderAmount > 0)
                                    {
                                        <span class="small fw-bold text-success ms-1">₹@table.CurrentOrderAmount.ToString("N0")</span>
                                    }
                                </td>
                                <td>
                                    @if (table.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1" 
                                            onclick="editTable(@table.Id, '@table.TableNumber', @table.FloorId, @table.Capacity, '@table.TableType', '@table.Description', @(table.IsActive ? "true" : "false"))" 
                                            data-bs-toggle="tooltip" title="Edit table details">
                                        <i class="fa-solid fa-pen-to-square"></i> Edit
                                    </button>
                                    <form asp-action="ToggleTableStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@table.Id" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-2 me-1" data-bs-toggle="tooltip" title="Toggle active/inactive status">
                                            <i class="fa-solid fa-power-off @(table.IsActive ? "text-success" : "text-muted")"></i>
                                        </button>
                                    </form>
                                    <form asp-action="DeleteTable" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete @table.TableNumber?');">
                                        <input type="hidden" name="id" value="@table.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2" data-bs-toggle="tooltip" title="Delete table">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ==================== TAB 3: MENU ITEMS (Section 5.4) ==================== -->
    <div class="tab-pane fade @(activeTab == "menu" ? "show active" : "")" id="menu-pane" role="tabpanel">
        <div class="glass-card p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-bowl-food text-success me-2"></i>Menu Items</h4>
                <div class="d-flex gap-2">
                    <a href="/Menu/PrintMenuCard" target="_blank" class="btn btn-outline-success rounded-pill px-3 shadow-sm" title="Preview & Print Bilingual Menu Card">
                        <i class="fa-solid fa-print me-1"></i> Print Menu Card
                    </a>
                    <button class="btn btn-outline-secondary rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#addCategoryModal" title="Add a new category">
                        <i class="fa-solid fa-folder-plus me-1"></i> Add Category
                    </button>
                    <button class="btn btn-success rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addMenuItemModal" title="Add a new food dish or beverage">
                        <i class="fa-solid fa-plus me-1"></i> Add Menu Item
                    </button>
                </div>
            </div>

            <!-- Categories Quick Filter Pills -->
            <div class="d-flex flex-wrap gap-2 mb-4 pb-3 border-bottom align-items-center">
                <span class="fw-bold text-secondary small me-2"><i class="fa-solid fa-tags me-1"></i>Categories:</span>
                @foreach (var cat in Model.Categories)
                {
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill d-flex align-items-center gap-2">
                        <strong>@cat.Name</strong>
                        @if (!string.IsNullOrEmpty(cat.NameMarathi))
                        {
                            <span class="text-muted small">(@cat.NameMarathi)</span>
                        }
                        <span class="badge bg-secondary rounded-pill">@cat.ItemCount</span>
                        <button class="btn btn-link text-primary p-0 border-0" onclick="editCategory(@cat.Id, '@cat.Name', '@cat.NameMarathi', '@cat.Description', @cat.DisplayOrder, @(cat.IsActive ? "true" : "false"))" title="Edit Category">
                            <i class="fa-solid fa-pen-to-square small"></i>
                        </button>
                    </span>
                }
            </div>

            <div class="table-responsive">
                <table class="table app-datagrid align-middle">
                    <thead>
                        <tr>
                            <th>#Code / Short Code</th>
                            <th>Dish Name (English / मराठी)</th>
                            <th>Category</th>
                            <th>Type</th>
                            <th>Price</th>
                            <th>Tax</th>
                            <th>Kitchen</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.MenuItems)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ShortCode))
                                    {
                                        <span class="badge bg-dark text-white fw-bold px-2 py-1 fs-6">#@item.ShortCode</span>
                                        @if (!string.IsNullOrEmpty(item.ItemCode) && item.ItemCode != item.ShortCode)
                                        {
                                            <div class="small text-muted mt-1">@item.ItemCode</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-muted">@(string.IsNullOrEmpty(item.ItemCode) ? $"#{item.Id}" : item.ItemCode)</span>
                                    }
                                </td>
                                <td>
                                    <div>
                                        <span class="fw-bold text-dark fs-6">@item.Name</span>
                                        @if (!string.IsNullOrEmpty(item.NameMarathi))
                                        {
                                            <span class="text-success small fw-semibold ms-1">(@item.NameMarathi)</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <div class="small text-muted text-truncate" style="max-width: 250px;">@item.Description</div>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill px-3 py-1">
                                        @item.CategoryName
                                    </span>
                                </td>
                                <td>
                                    @if (item.IsVeg)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                            <i class="fa-solid fa-leaf me-1"></i>Veg
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">
                                            <i class="fa-solid fa-drumstick-bite me-1"></i>Non-Veg
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="fw-bold text-dark fs-6">₹@item.Price.ToString("N0")</span>
                                </td>
                                <td>
                                    <span class="small text-muted">@item.TaxPercentage%</span>
                                </td>
                                <td>
                                    <span class="small text-secondary">@item.KitchenCategory</span>
                                </td>
                                <td>
                                    <form asp-action="ToggleMenuItemAvailability" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        @if (item.IsAvailable)
                                        {
                                            <button type="submit" class="badge bg-success border-0 px-2 py-1 rounded-pill text-white cursor-pointer" data-bs-toggle="tooltip" title="Click to mark Out of Stock">
                                                <i class="fa-solid fa-check me-1"></i> Available
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="badge bg-danger border-0 px-2 py-1 rounded-pill text-white cursor-pointer" data-bs-toggle="tooltip" title="Click to mark Available">
                                                <i class="fa-solid fa-ban me-1"></i> Out of Stock
                                            </button>
                                        }
                                    </form>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 ms-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1 ms-1">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1" 
                                            onclick="editMenuItem(@item.Id, @item.CategoryId, '@item.Name', '@item.NameMarathi', '@item.ItemCode', '@item.ShortCode', '@item.Description', @item.Price, @item.TaxPercentage, @(item.IsVeg ? "true" : "false"), @item.PreparationTimeMinutes, '@item.KitchenCategory', @(item.IsActive ? "true" : "false"))" 
                                            data-bs-toggle="tooltip" title="Edit menu item">
                                        <i class="fa-solid fa-pen-to-square"></i> Edit
                                    </button>
                                    <form asp-action="ToggleMenuItemStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-2 me-1" data-bs-toggle="tooltip" title="Toggle active status">
                                            <i class="fa-solid fa-power-off @(item.IsActive ? "text-success" : "text-muted")"></i>
                                        </button>
                                    </form>
                                    <form asp-action="DeleteMenuItem" method="post" class="d-inline" onsubmit="return confirm('Delete @item.Name from menu?');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2" data-bs-toggle="tooltip" title="Delete menu item">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ==================== TAB 4: CATEGORIES (Section 5.3) ==================== -->
    <div class="tab-pane fade @(activeTab == "category" ? "show active" : "")" id="category-pane" role="tabpanel">
        <div class="glass-card p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-tags text-primary me-2"></i>Categories</h4>
                <button class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addCategoryModal" title="Add a new category">
                    <i class="fa-solid fa-plus me-1"></i> Add Category
                </button>
            </div>

            <div class="table-responsive">
                <table class="table app-datagrid align-middle">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th>Category Name (English / मराठी)</th>
                            <th>Description</th>
                            <th>Display Order</th>
                            <th>Total Items</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in Model.Categories)
                        {
                            <tr>
                                <td class="fw-bold text-muted">#@cat.Id</td>
                                <td>
                                    <span class="fw-bold text-dark fs-6 d-flex align-items-center gap-2">
                                        <i class="fa-solid fa-tag text-primary"></i>
                                        @cat.Name
                                        @if (!string.IsNullOrEmpty(cat.NameMarathi))
                                        {
                                            <span class="text-success small fw-semibold">(@cat.NameMarathi)</span>
                                        }
                                    </span>
                                </td>
                                <td class="text-secondary">@(string.IsNullOrWhiteSpace(cat.Description) ? "—" : cat.Description)</td>
                                <td><span class="badge bg-light text-dark border px-2 py-1">Order @cat.DisplayOrder</span></td>
                                <td>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-bold">
                                        @cat.ItemCount Items
                                    </span>
                                </td>
                                <td>
                                    @if (cat.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1" 
                                            onclick="editCategory(@cat.Id, '@cat.Name', '@cat.NameMarathi', '@cat.Description', @cat.DisplayOrder, @(cat.IsActive ? "true" : "false"))" 
                                            data-bs-toggle="tooltip" title="Edit category">
                                        <i class="fa-solid fa-pen-to-square"></i> Edit
                                    </button>
                                    <form asp-action="ToggleCategoryStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@cat.Id" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-2 me-1" data-bs-toggle="tooltip" title="Toggle active status">
                                            <i class="fa-solid fa-power-off @(cat.IsActive ? "text-success" : "text-muted")"></i>
                                        </button>
                                    </form>
                                    <form asp-action="DeleteCategory" method="post" class="d-inline" onsubmit="return confirm('Delete category @cat.Name?');">
                                        <input type="hidden" name="id" value="@cat.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2" data-bs-toggle="tooltip" title="Delete category">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ==================== TAB 5: SUPPLIERS (Section 5.5) ==================== -->
    <div class="tab-pane fade @(activeTab == "supplier" ? "show active" : "")" id="supplier-pane" role="tabpanel">
        <div class="glass-card p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-truck text-dark me-2"></i>Suppliers & Vendors</h4>
                <button class="btn btn-dark rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addSupplierModal" title="Add a new supplier">
                    <i class="fa-solid fa-plus me-1"></i> Add Supplier
                </button>
            </div>

            <div class="table-responsive">
                <table class="table app-datagrid align-middle">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th>Supplier / Company</th>
                            <th>Contact Person</th>
                            <th>Phone</th>
                            <th>GST Number</th>
                            <th>Opening Balance</th>
                            <th>Purchase Orders</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Suppliers.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">
                                    <i class="fa-solid fa-truck fs-3 d-block mb-2 text-secondary opacity-50"></i>
                                    <span>No suppliers registered yet. Click "Add Supplier" to record your vendor masters.</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var s in Model.Suppliers)
                            {
                                <tr>
                                    <td class="fw-bold text-muted">#@s.Id</td>
                                    <td>
                                        <span class="fw-bold text-dark fs-6 d-flex align-items-center gap-2">
                                            <i class="fa-solid fa-building text-secondary"></i>
                                            @s.Name
                                        </span>
                                        @if (!string.IsNullOrEmpty(s.Email))
                                        {
                                            <div class="small text-muted">@s.Email</div>
                                        }
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(s.ContactPerson) ? "—" : s.ContactPerson)</td>
                                    <td class="fw-semibold text-dark"><i class="fa-solid fa-phone me-1 small text-muted"></i>@s.Phone</td>
                                    <td><span class="badge bg-light text-dark border">@(string.IsNullOrEmpty(s.GSTNumber) ? "Unregistered" : s.GSTNumber)</span></td>
                                    <td class="fw-bold text-dark">₹@s.OpeningBalance.ToString("N0")</td>
                                    <td>
                                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-1">
                                            @s.PurchaseOrdersCount Orders
                                        </span>
                                    </td>
                                    <td>
                                        @if (s.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1" 
                                                onclick="editSupplier(@s.Id, '@s.Name', '@s.ContactPerson', '@s.Phone', '@s.Email', '@s.Address', '@s.GSTNumber', @s.OpeningBalance, @(s.IsActive ? "true" : "false"))" 
                                                data-bs-toggle="tooltip" title="Edit supplier details">
                                            <i class="fa-solid fa-pen-to-square"></i> Edit
                                        </button>
                                        <form asp-action="ToggleSupplierStatus" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@s.Id" />
                                            <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-2 me-1" data-bs-toggle="tooltip" title="Toggle active status">
                                                <i class="fa-solid fa-power-off @(s.IsActive ? "text-success" : "text-muted")"></i>
                                            </button>
                                        </form>
                                        <form asp-action="DeleteSupplier" method="post" class="d-inline" onsubmit="return confirm('Delete supplier @s.Name?');">
                                            <input type="hidden" name="id" value="@s.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2" data-bs-toggle="tooltip" title="Delete supplier">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ==================== TAB: CUSTOMERS MASTER ==================== -->
    <div class="tab-pane fade @(activeTab == "customer" ? "show active" : "")" id="customer-pane" role="tabpanel">
        <div class="glass-card p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-3 border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <h4 class="fw-bold text-dark mb-0">
                        <i class="fa-solid fa-address-book text-success me-2"></i>Customer Master
                    </h4>
                    <span class="badge bg-secondary-subtle text-dark border px-3 py-2 rounded-pill">
                        @Model.Customers.Count() Registered Customers
                    </span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div class="input-group input-group-sm" style="max-width: 260px;">
                        <span class="input-group-text bg-white border-end-0 rounded-start-pill"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                        <input type="text" id="customerMasterSearchInput" onkeyup="filterCustomerMaster()" class="form-control border-start-0 rounded-end-pill" placeholder="Search customer, phone, GSTIN..." />
                    </div>
                    <button class="btn btn-success rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addCustomerModal" title="Register new customer">
                        <i class="fa-solid fa-user-plus me-1"></i> Add Customer
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table app-datagrid align-middle" id="customerMasterTable">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th>Customer Name & Contact</th>
                            <th>GSTIN / Tax ID</th>
                            <th>Address</th>
                            <th>Loyalty Tier</th>
                            <th>Total Visits & Spend</th>
                            <th>Credit (Udhari)</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Customers.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-users fs-2 mb-2 d-block text-secondary opacity-50"></i>
                                    No customer records registered yet. Click "Add Customer" to create one.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var c in Model.Customers)
                            {
                                <tr class="customer-row">
                                    <td class="fw-bold text-muted">#@c.Id</td>
                                    <td>
                                        <div class="fw-bold text-dark fs-6 d-flex align-items-center gap-2">
                                            <i class="fa-solid fa-user text-success"></i>
                                            <span class="customer-name">@c.Name</span>
                                        </div>
                                        <div class="small text-muted customer-phone">
                                            <i class="fa-solid fa-phone me-1 small"></i>@(string.IsNullOrEmpty(c.Phone) ? "No phone" : c.Phone)
                                            @if (!string.IsNullOrEmpty(c.Email))
                                            {
                                                <span class="ms-2"><i class="fa-solid fa-envelope me-1 small"></i>@c.Email</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(c.Notes))
                                        {
                                            <div class="small text-secondary fst-italic mt-1"><i class="fa-solid fa-note-sticky me-1 small"></i>@c.Notes</div>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(c.GSTIN))
                                        {
                                            <span class="badge bg-light text-dark border fw-bold customer-gstin">@c.GSTIN</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(c.Address))
                                        {
                                            <span class="small text-dark text-truncate d-inline-block" style="max-width: 180px;" title="@c.Address">@c.Address</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (c.TierName == "Gold")
                                        {
                                            <span class="badge bg-warning text-dark border px-2 py-1"><i class="fa-solid fa-crown me-1"></i>Gold (@c.LoyaltyPoints pts)</span>
                                        }
                                        else if (c.TierName == "Silver")
                                        {
                                            <span class="badge bg-secondary text-white px-2 py-1"><i class="fa-solid fa-medal me-1"></i>Silver (@c.LoyaltyPoints pts)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border px-2 py-1">Bronze (@c.LoyaltyPoints pts)</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">₹@c.TotalSpent.ToString("N0")</div>
                                        <div class="small text-muted">@c.TotalVisits visits</div>
                                    </td>
                                    <td>
                                        @if (c.OutstandingCredit > 0)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1 fw-bold fs-6">
                                                ₹@c.OutstandingCredit.ToString("N0")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
                                                Clear
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (c.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1" 
                                                onclick="editCustomer(@c.Id, '@(c.Name?.Replace("'", "\\'"))', '@(c.Phone?.Replace("'", "\\'"))', '@(c.Email?.Replace("'", "\\'"))', '@(c.Address?.Replace("'", "\\'"))', '@(c.GSTIN?.Replace("'", "\\'"))', '@(c.Notes?.Replace("'", "\\'"))', @c.LoyaltyPoints, @(c.IsActive ? "true" : "false"))" 
                                                data-bs-toggle="tooltip" title="Edit customer details">
                                            <i class="fa-solid fa-pen-to-square"></i> Edit
                                        </button>
                                        <form asp-action="ToggleCustomerStatus" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-2 me-1" data-bs-toggle="tooltip" title="Toggle active status">
                                                <i class="fa-solid fa-power-off @(c.IsActive ? "text-success" : "text-muted")"></i>
                                            </button>
                                        </form>
                                        <form asp-action="DeleteCustomer" method="post" class="d-inline" onsubmit="return confirm('Delete customer @c.Name?');">
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2" data-bs-toggle="tooltip" title="Delete customer">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ==================== TAB 6: EMPLOYEES ==================== -->
    <div class="tab-pane fade @(activeTab == "employee" ? "show active" : "")" id="employee-pane" role="tabpanel">
        <div class="glass-card p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-users text-danger me-2"></i>Employees</h4>
                <div class="d-flex gap-2">
                    <a href="/Staff" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm" data-bs-toggle="tooltip" title="Open staff attendance & roles">
                        <i class="fa-solid fa-user-check me-1"></i> Staff & Attendance
                    </a>
                    <button class="btn btn-danger rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addEmployeeModal" title="Register new employee">
                        <i class="fa-solid fa-user-plus me-1"></i> Add Employee
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table app-datagrid align-middle">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th>Staff Name</th>
                            <th>Role / Designation</th>
                            <th>Mobile</th>
                            <th>Shift</th>
                            <th>Base Salary</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in Model.Employees)
                        {
                            <tr>
                                <td class="fw-bold text-muted">#@emp.Id</td>
                                <td>
                                    <span class="fw-bold text-dark fs-6 d-flex align-items-center gap-2">
                                        <i class="fa-solid fa-user-tie text-danger"></i>
                                        @emp.Name
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">
                                        @emp.RoleName
                                    </span>
                                </td>
                                <td><i class="fa-solid fa-phone me-1 small text-muted"></i>@emp.Phone</td>
                                <td><span class="badge bg-light text-dark border px-2 py-1">@emp.Shift</span></td>
                                <td>
                                    <span class="fw-bold text-dark">₹@emp.BaseSalary.ToString("N0")</span>
                                </td>
                                <td>
                                    @if (emp.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1" 
                                            onclick="editEmployee(@emp.Id, '@emp.Name', '@emp.Email', '@emp.Phone', @((int)emp.Role), '@emp.Shift', @emp.BaseSalary, @(emp.IsActive ? "true" : "false"))" 
                                            data-bs-toggle="tooltip" title="Edit employee profile">
                                        <i class="fa-solid fa-pen-to-square"></i> Edit
                                    </button>
                                    <form asp-action="DeleteEmployee" method="post" class="d-inline" onsubmit="return confirm('Remove employee @emp.Name?');">
                                        <input type="hidden" name="id" value="@emp.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2" data-bs-toggle="tooltip" title="Delete employee">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ==================== TAB 7: INVENTORY ==================== -->
    <div class="tab-pane fade @(activeTab == "inventory" ? "show active" : "")" id="inventory-pane" role="tabpanel">
        <div class="glass-card p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-boxes-stacked text-secondary me-2"></i>Inventory</h4>
                <a href="/Inventory" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm" data-bs-toggle="tooltip" title="Open full inventory system">
                    <i class="fa-solid fa-boxes-stacked me-1"></i> Open Stock System
                </a>
            </div>

            <div class="table-responsive">
                <table class="table app-datagrid align-middle">
                    <thead>
                        <tr>
                            <th>Ingredient Item</th>
                            <th>Category</th>
                            <th>Current Stock</th>
                            <th>Minimum Level</th>
                            <th>Unit Cost</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.InventoryItems)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@item.Name</td>
                                <td><span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle px-2 py-1 rounded-pill">@item.Category</span></td>
                                <td class="fw-bold fs-6 @(item.IsLowStock ? "text-danger" : "text-success")">
                                    @item.CurrentStock @item.Unit
                                </td>
                                <td class="small text-secondary">@item.MinimumStock @item.Unit</td>
                                <td class="text-dark">₹@item.UnitCost.ToString("N0") / @item.Unit</td>
                                <td>
                                    @if (item.CurrentStock <= (item.MinimumStock / 2m))
                                    {
                                        <span class="badge bg-danger px-3 py-1 rounded-pill"><i class="fa-solid fa-circle-exclamation me-1"></i> Critical Low</span>
                                    }
                                    else if (item.IsLowStock)
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-1 rounded-pill"><i class="fa-solid fa-triangle-exclamation me-1"></i> Low Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i> Optimal</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="adjustStock(@item.Id, '@item.Name', '@item.Unit')">
                                        <i class="fa-solid fa-sliders me-1"></i> Adjust Stock
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ==================== TAB 8: APPLICATION CONFIGURATION MASTER (Section 5.6) ==================== -->
    <div class="tab-pane fade @(activeTab == "settings" ? "show active" : "")" id="settings-pane" role="tabpanel">
        <div class="glass-card p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <div>
                    <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-sliders text-dark me-2"></i>Application Configuration Master</h4>
                    <span class="text-muted small">Manage centralized operational parameters, profiles, GST tax rules, and workflows</span>
                </div>
            </div>

            @{
                var setting = Model.Setting ?? new RestaurantSetting();
            }
            <form asp-action="UpdateSettings" method="post" enctype="multipart/form-data" class="needs-validation">
                <input type="hidden" name="Id" value="@setting.Id" />

                <!-- SECTION A: ROLE-BASED MENU ACCESS MATRIX (5.6 A) -->
                <div class="card rounded-4 border p-4 mb-4 shadow-sm bg-light-subtle">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="fa-solid fa-user-shield text-primary me-2"></i>Section A: Role-Based Access Control Matrix
                        </h5>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">Enforced Backend & Frontend</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm align-middle text-center mb-0 bg-white">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-start">Module / Menu</th>
                                    <th>Admin</th>
                                    <th>Manager</th>
                                    <th>Cashier</th>
                                    <th>Waiter</th>
                                    <th>Kitchen / Chef</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="text-start fw-bold"><i class="fa-solid fa-chart-pie text-success me-1"></i> Dashboard</td>
                                    <td><i class="fa-solid fa-check text-success"></i> Full</td>
                                    <td><i class="fa-solid fa-check text-success"></i> Full</td>
                                    <td><i class="fa-solid fa-check text-success"></i> View</td>
                                    <td><i class="fa-solid fa-check text-success"></i> View</td>
                                    <td><i class="fa-solid fa-check text-success"></i> View</td>
                                </tr>
                                <tr>
                                    <td class="text-start fw-bold"><i class="fa-solid fa-chair text-warning me-1"></i> Tables & Floors</td>
                                    <td><i class="fa-solid fa-check text-success"></i> Full</td>
                                    <td><i class="fa-solid fa-check text-success"></i> Full</td>
                                    <td><i class="fa-solid fa-check text-success"></i> Status</td>
                                    <td><i class="fa-solid fa-check text-success"></i> Status</td>
                                    <td><i class="fa-solid fa-minus text-muted"></i></td>
                                </tr>
                                <tr>
                                    <td class="text-start fw-bold"><i class="fa-solid fa-receipt text-primary me-1"></i> Orders & POS</td>
                                    <td><i class="fa-solid fa-check text-success"></i> Full</td>
                                    <td><i class="fa-solid fa-check text-success"></i> Full</td>
                                    <td><i class="fa-solid fa-check text-success"></i> Create/Edit</td>
                                    <td><i class="fa-solid fa-check text-success"></i> Create/Edit</td>
                                    <td><i class="fa-solid fa-check text-success"></i> View KOT</td>
                                </tr>
                                <tr>
                                    <td class="text-start fw-bold"><i class="fa-solid fa-kitchen-set text-danger me-1"></i> Kitchen (KDS)</td>
                                    <td><i class="fa-solid fa-check text-success"></i> Full</td>
                                    <td><i class="fa-solid fa-check text-success"></i> Full</td>
                                    <td><i class="fa-solid fa-minus text-muted"></i></td>
                                    <td><i class="fa-solid fa-minus text-muted"></i></td>
                                    <td><i class="fa-solid fa-check text-success"></i> Complete/Serve</td>
                                </tr>
                                <tr>
                                    <td class="text-start fw-bold"><i class="fa-solid fa-file-invoice-dollar text-purple me-1"></i> Billing & Payments</td>
                                    <td><i class="fa-solid fa-check text-success"></i> Full</td>
                                    <td><i class="fa-solid fa-check text-success"></i> Full</td>
                                    <td><i class="fa-solid fa-check text-success"></i> Settle & Print</td>
                                    <td><i class="fa-solid fa-minus text-muted"></i></td>
                                    <td><i class="fa-solid fa-minus text-muted"></i></td>
                                </tr>
                                <tr>
                                    <td class="text-start fw-bold"><i class="fa-solid fa-layer-group text-danger me-1"></i> Masters & Configs</td>
                                    <td><i class="fa-solid fa-check text-success"></i> Full</td>
                                    <td><i class="fa-solid fa-check text-success"></i> Manage</td>
                                    <td><i class="fa-solid fa-minus text-muted"></i></td>
                                    <td><i class="fa-solid fa-minus text-muted"></i></td>
                                    <td><i class="fa-solid fa-minus text-muted"></i></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- SECTION B: RESTAURANT PROFILE & BRANDING (5.6 B) -->
                <div class="card rounded-4 border p-4 mb-4 shadow-sm bg-light-subtle">
                    <h5 class="fw-bold text-primary mb-3">
                        <i class="fa-solid fa-store me-2"></i>Section B: Restaurant Profile & Brand Details
                    </h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Restaurant Brand Name (English)</label>
                            <input type="text" name="RestaurantName" class="form-control" value="@setting.RestaurantName" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-success">Restaurant Brand Name (मराठी)</label>
                            <input type="text" name="RestaurantNameMarathi" class="form-control" value="@setting.RestaurantNameMarathi" placeholder="उदा. गिराणा गार्डन फाईन डाईन" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">GSTIN (Tax Identification Number)</label>
                            <input type="text" name="GSTIN" class="form-control" value="@setting.GSTIN" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Phone Contact Number</label>
                            <input type="tel" name="Phone" class="form-control" value="@setting.Phone" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Official Email Address</label>
                            <input type="email" name="Email" class="form-control" value="@setting.Email" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Invoice Prefix (e.g. GIR, INV)</label>
                            <input type="text" name="InvoicePrefix" class="form-control" value="@setting.InvoicePrefix" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Currency Symbol</label>
                            <input type="text" name="CurrencySymbol" class="form-control" value="@setting.CurrencySymbol" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small">Physical Address (Prints on Bills & Invoices)</label>
                            <textarea name="Address" class="form-control" rows="2">@setting.Address</textarea>
                        </div>

                        <!-- Logo Upload, Preview & Removal -->
                        <div class="col-12 border-top pt-3">
                            <label class="form-label fw-bold small">Restaurant Logo</label>
                            <div class="d-flex align-items-center gap-3">
                                <div class="p-2 border rounded-3 bg-white" style="width: 70px; height: 70px; display: flex; align-items: center; justify-content: center;">
                                    @if (!string.IsNullOrEmpty(setting.LogoUrl))
                                    {
                                        <img src="@setting.LogoUrl" alt="Restaurant Logo" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-utensils fs-3 text-success"></i>
                                    }
                                </div>
                                <div class="flex-grow-1">
                                    <input type="file" name="logoFile" class="form-control form-control-sm mb-1" accept="image/*" />
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="small text-muted">Upload PNG or JPG (will appear on thermal receipts and headers)</span>
                                        @if (!string.IsNullOrEmpty(setting.LogoUrl))
                                        {
                                            <div class="form-check form-check-inline small">
                                                <input class="form-check-input" type="checkbox" name="removeLogo" id="removeLogoCheck" value="true" />
                                                <label class="form-check-label text-danger" for="removeLogoCheck">Remove Logo</label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECTION C: GST CONFIGURATION (5.6 C) -->
                <div class="card rounded-4 border p-4 mb-4 shadow-sm bg-light-subtle">
                    <h5 class="fw-bold text-success mb-3">
                        <i class="fa-solid fa-percent me-2"></i>Section C: GST Configuration
                    </h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-check form-switch p-3 bg-white rounded-3 border">
                                <input class="form-check-input ms-0 me-3" type="checkbox" role="switch" id="gstToggle" name="IsGSTEnabled" value="true" @(setting.IsGSTEnabled ? "checked" : "") />
                                <label class="form-check-label fw-bold" for="gstToggle">
                                    Enable GST Tax Calculation
                                    <div class="text-muted small fw-normal">When disabled, CGST and SGST will not be charged on food orders.</div>
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch p-3 bg-white rounded-3 border">
                                <input class="form-check-input ms-0 me-3" type="checkbox" role="switch" id="taxInclusiveToggle" name="IsTaxInclusive" value="true" @(setting.IsTaxInclusive ? "checked" : "") />
                                <label class="form-check-label fw-bold" for="taxInclusiveToggle">
                                    Menu Prices are Tax-Inclusive
                                    <div class="text-muted small fw-normal">When enabled, menu price includes applicable GST taxes.</div>
                                </label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold small">CGST (%)</label>
                            <input type="number" step="0.1" name="CGSTPercentage" class="form-control" value="@setting.CGSTPercentage" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold small">SGST (%)</label>
                            <input type="number" step="0.1" name="SGSTPercentage" class="form-control" value="@setting.SGSTPercentage" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold small">Service Charge (%)</label>
                            <input type="number" step="0.1" name="ServiceChargePercentage" class="form-control" value="@setting.ServiceChargePercentage" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold small">Packaging Charge (₹)</label>
                            <input type="number" step="1" name="PackagingCharge" class="form-control" value="@setting.PackagingCharge" />
                        </div>
                    </div>
                </div>

                <!-- SECTION D: QR CODE SETTINGS (5.6 D) -->
                <div class="card rounded-4 border p-4 mb-4 shadow-sm bg-light-subtle">
                    <h5 class="fw-bold text-info mb-3">
                        <i class="fa-solid fa-qrcode me-2"></i>Section D: QR Code Settings
                    </h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-check form-switch p-3 bg-white rounded-3 border">
                                <input class="form-check-input ms-0 me-3" type="checkbox" role="switch" id="qrToggle" name="IsQRCodeEnabled" value="true" @(setting.IsQRCodeEnabled ? "checked" : "") />
                                <label class="form-check-label fw-bold" for="qrToggle">
                                    Enable QR Code on Invoices & Tables
                                    <div class="text-muted small fw-normal">Prints dynamic UPI payment QR on customer bills and allows digital menu scanning.</div>
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Digital Menu / UPI QR Payload String</label>
                            <input type="text" name="QRCodeData" class="form-control" value="@setting.QRCodeData" placeholder="e.g. upi://pay?pa=restaurant@upi or https://..." />
                        </div>
                    </div>
                </div>

                <!-- SECTION E: KITCHEN (KDS) & KOT WORKFLOW TOGGLE (5.6 E) -->
                <div class="card rounded-4 border p-4 mb-4 shadow-sm bg-light-subtle">
                    <h5 class="fw-bold text-danger mb-3">
                        <i class="fa-solid fa-kitchen-set me-2"></i>Section E: Kitchen / KOT Workflow Mode
                    </h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-check form-switch p-3 bg-white rounded-3 border">
                                <input class="form-check-input ms-0 me-3" type="checkbox" role="switch" id="kotToggle" name="IsKOTWorkflowEnabled" value="true" @(setting.IsKOTWorkflowEnabled ? "checked" : "") />
                                <label class="form-check-label fw-bold" for="kotToggle">
                                    Mode A: KOT Workflow Enabled
                                    <div class="text-muted small fw-normal">Orders route through KDS tickets. When unchecked (Mode B), direct order creation and immediate billing operate without KDS requirement.</div>
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Billing Policy with Unserved Items</label>
                            <select name="AllowBillingWithUnservedItems" class="form-select">
                                <option value="1" selected="@(setting.AllowBillingWithUnservedItems == BillingUnservedItemsSetting.Yes)">Allow Billing (Auto-serve items upon bill creation)</option>
                                <option value="2" selected="@(setting.AllowBillingWithUnservedItems == BillingUnservedItemsSetting.Ask)">Ask Confirmation (Warn cashier if items still in kitchen)</option>
                                <option value="3" selected="@(setting.AllowBillingWithUnservedItems == BillingUnservedItemsSetting.No)">Block Billing (Enforce all items must be marked Served first)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- SECTION F: HARDWARE & INTEGRATIONS -->
                <div class="card rounded-4 border p-4 mb-4 shadow-sm bg-light-subtle">
                    <h5 class="fw-bold text-secondary mb-3">
                        <i class="fa-solid fa-print me-2"></i>Section F: POS Printing & Messaging Integration
                    </h5>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Thermal Printer Paper Width</label>
                            <select name="ThermalPrinterWidth" class="form-select">
                                <option value="80" selected="@(setting.ThermalPrinterWidth == 80)">80mm (Standard POS Thermal Receipt)</option>
                                <option value="58" selected="@(setting.ThermalPrinterWidth == 58)">58mm (Compact Mobile / Handheld Printer)</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Default UI Language</label>
                            <select name="DefaultLanguage" class="form-select">
                                <option value="en" selected="@(setting.DefaultLanguage == "en")">English</option>
                                <option value="mr" selected="@(setting.DefaultLanguage == "mr")">मराठी (Marathi)</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Manager PIN</label>
                            <input type="password" name="ManagerPIN" class="form-control" value="@setting.ManagerPIN" placeholder="Default: 1234" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold small">WhatsApp Gateway / Share Integration Key (Optional)</label>
                            <input type="text" name="WhatsAppApiKey" class="form-control" value="@setting.WhatsAppApiKey" placeholder="API Key for direct WhatsApp bill dispatch" />
                        </div>
                    </div>
                </div>

                <div class="border-top pt-3 d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary rounded-pill px-5 shadow-sm fw-bold">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Save Application Configurations
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

