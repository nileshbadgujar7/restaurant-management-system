                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Email Address</label>
                        <input type="email" name="Email" class="form-control" placeholder="employee@giranagarden.com" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Work Shift</label>
                        <select name="Shift" class="form-select">
