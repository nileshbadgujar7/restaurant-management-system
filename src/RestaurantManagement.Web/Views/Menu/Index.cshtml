@model IEnumerable<MenuItemDto>
@{
    ViewData["Title"] = "Menu Management";
    var categories = ViewBag.Categories as IEnumerable<CategoryDto> ?? new List<CategoryDto>();
    string? returnUrl = Context.Request.Query["returnUrl"];
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 animated-fade-in">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 fs-6">
                <li class="breadcrumb-item">
                    <a href="/Dashboard" class="text-decoration-none fw-semibold text-success">
                        <i class="fa-solid fa-chart-pie me-1" data-bs-toggle="tooltip" title="Dashboard"></i> Dashboard
                    </a>
                </li>
                <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">
                    <i class="fa-solid fa-bowl-food text-warning me-1"></i> Food & Beverage Menu
                </li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-bowl-food text-warning me-2"></i>Food & Beverage Menu
        </h2>
    </div>
    <div class="d-flex gap-2">
        <a href="/Dashboard" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm" data-bs-toggle="tooltip" title="Back to Dashboard">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Dashboard
        </a>
        <button class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addItemModal">
            <i class="fa-solid fa-plus me-1"></i> Add Menu Item
        </button>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="glass-card p-4 animated-fade-in">
    <div class="table-responsive">
        <table class="table app-datagrid align-middle">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Item Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Prep Time</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (item.IsVeg)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
                                    <i class="fa-solid fa-leaf me-1"></i>Veg
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1">
                                    <i class="fa-solid fa-drumstick-bite me-1"></i>Non-Veg
                                </span>
                            }
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Name" class="rounded-3 border object-fit-cover flex-shrink-0" style="width: 42px; height: 42px;" onerror="this.style.display='none'; this.nextElementSibling.classList.remove('d-none');" />
                                    <div class="rounded-3 bg-light d-none align-items-center justify-content-center text-muted border flex-shrink-0" style="width: 42px; height: 42px;">
                                        <i class="fa-solid fa-utensils"></i>
                                    </div>
                                }
                                else
                                {
                                    <div class="rounded-3 bg-light d-flex align-items-center justify-content-center text-muted border flex-shrink-0" style="width: 42px; height: 42px;">
                                        <i class="fa-solid fa-utensils"></i>
                                    </div>
                                }
                                <div>
                                    <div class="fw-bold text-dark fs-6">@item.Name</div>
                                    <div class="small text-muted">@item.Description</div>
                                </div>
                            </div>
                        </td>
                        <td><span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill px-3 py-1">@item.CategoryName</span></td>
                        <td class="fw-bold text-dark fs-6">₹@item.Price.ToString("N0")</td>
                        <td class="small text-secondary"><i class="fa-solid fa-clock me-1"></i>@item.PreparationTimeMinutes Mins</td>
                        <td>
                            @if (item.IsAvailable)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1"><i class="fa-solid fa-circle-check me-1"></i> Available</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1"><i class="fa-solid fa-ban me-1"></i> Sold Out</span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-action="ToggleAvailability" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm @(item.IsAvailable ? "btn-outline-danger" : "btn-outline-success") rounded-pill px-3">
                                    @(item.IsAvailable ? "Mark Sold Out" : "Mark Available")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Item Modal -->
<div class="modal fade" id="addItemModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Create" method="post" enctype="multipart/form-data" class="modal-content rounded-4 border-0 shadow-lg">
            @if (!string.IsNullOrEmpty(returnUrl))
            {
                <input type="hidden" name="returnUrl" value="@returnUrl" />
            }
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-plus me-2 text-primary"></i>Add New Menu Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(returnUrl))
                {
                    <div class="alert alert-info py-2 px-3 small rounded-3 mb-3">
                        <i class="fa-solid fa-arrow-turn-down me-1"></i> Once added, you will return back to your previous screen.
                    </div>
                }
                <div class="mb-3">
                    <label class="form-label fw-bold small">Category</label>
                    <select name="CategoryId" class="form-select" required>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Item Name</label>
                    <input type="text" name="Name" class="form-control" placeholder="e.g. Butter Chicken" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Description</label>
                    <textarea name="Description" class="form-control" rows="2" placeholder="Ingredients description..."></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small"><i class="fa-solid fa-image text-primary me-1"></i>Dish Image (Optional)</label>
                    <input type="file" name="imageFile" class="form-control" accept="image/png, image/jpeg, image/webp, image/gif" />
                    <div class="form-text small text-muted">Upload an appetizing photo for the matrix POS menu (JPG, PNG, WebP).</div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-bold small">Price (₹)</label>
                        <input type="number" step="0.01" name="Price" class="form-control" placeholder="299" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-bold small">Type</label>
                        <select name="IsVeg" class="form-select">
                            <option value="true">Veg</option>
                            <option value="false">Non-Veg</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary rounded-pill px-4">Save Menu Item</button>
            </div>
        </form>
    </div>
</div>
