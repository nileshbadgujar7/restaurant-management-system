@model ComprehensiveReportDto
@{
    ViewData["Title"] = "Sales & Analytics Reports";
    string currentPeriod = Model.PeriodType;
    int curYear = Model.SelectedYear;
    int curMonth = Model.SelectedMonth;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 animated-fade-in">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 fs-6">
                <li class="breadcrumb-item">
                    <a href="/Dashboard" class="text-decoration-none fw-semibold text-success">
                        <i class="fa-solid fa-chart-pie me-1"></i> Dashboard
                    </a>
                </li>
                <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">
                    <i class="fa-solid fa-chart-line text-success me-1"></i> Reports & Analytics
                </li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-chart-line text-success me-2"></i>Sales & Revenue Reports
        </h2>
        <div class="text-muted small mt-1">
            Displaying @currentPeriod report for 
            @if (currentPeriod == "DayWise")
            {
                <span class="fw-bold text-dark">@(new DateTime(curYear, curMonth, 1).ToString("MMMM yyyy"))</span>
            }
            else if (currentPeriod == "MonthWise")
            {
                <span class="fw-bold text-dark">Year @curYear</span>
            }
            else if (currentPeriod == "YearWise")
            {
                <span class="fw-bold text-dark">Past 5 Years</span>
            }
            else
            {
                <span class="fw-bold text-dark">@Model.StartDate.ToString("dd MMM yyyy") to @Model.EndDate.ToString("dd MMM yyyy")</span>
            }
        </div>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
            <i class="fa-solid fa-print me-1"></i> Print Report
        </button>
        <a href="/Dashboard" class="btn btn-outline-dark rounded-pill px-3 shadow-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Dashboard
        </a>
    </div>
</div>

<!-- Period Selection Card -->
<div class="glass-card p-4 mb-4 animated-fade-in shadow-sm">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <!-- Period Mode Switcher -->
        <div class="btn-group p-1 bg-light rounded-pill border" role="group">
            <a href="/Reports?period=DayWise&year=@curYear&month=@curMonth" class="btn btn-sm rounded-pill px-3 fw-bold @(currentPeriod == "DayWise" ? "btn-success shadow-sm" : "text-dark")">
                <i class="fa-solid fa-calendar-day me-1"></i> Day-wise
            </a>
            <a href="/Reports?period=MonthWise&year=@curYear" class="btn btn-sm rounded-pill px-3 fw-bold @(currentPeriod == "MonthWise" ? "btn-success shadow-sm" : "text-dark")">
                <i class="fa-solid fa-calendar-week me-1"></i> Month-wise
            </a>
            <a href="/Reports?period=YearWise&year=@curYear" class="btn btn-sm rounded-pill px-3 fw-bold @(currentPeriod == "YearWise" ? "btn-success shadow-sm" : "text-dark")">
                <i class="fa-solid fa-calendar me-1"></i> Year-wise
            </a>
            <a href="/Reports?period=Custom" class="btn btn-sm rounded-pill px-3 fw-bold @(currentPeriod == "Custom" ? "btn-success shadow-sm" : "text-dark")">
                <i class="fa-solid fa-sliders me-1"></i> Custom Range
            </a>
        </div>

        <!-- Dynamic Filter Controls -->
        <form method="get" action="/Reports" class="d-flex flex-wrap align-items-center gap-2">
            <input type="hidden" name="period" value="@currentPeriod" />
            
            @if (currentPeriod == "DayWise")
            {
                <div class="d-flex align-items-center gap-2">
                    <label class="small fw-bold text-secondary mb-0">Month:</label>
                    <select name="month" class="form-select form-select-sm rounded-pill" style="width: 140px;">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(m == curMonth)">@(new DateTime(2026, m, 1).ToString("MMMM"))</option>
                        }
                    </select>
                    <label class="small fw-bold text-secondary mb-0">Year:</label>
                    <select name="year" class="form-select form-select-sm rounded-pill" style="width: 100px;">
                        @for (int y = DateTime.UtcNow.Year; y >= DateTime.UtcNow.Year - 4; y--)
                        {
                            <option value="@y" selected="@(y == curYear)">@y</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-sm btn-dark rounded-pill px-3"><i class="fa-solid fa-filter me-1"></i> Apply</button>
                </div>
            }
            else if (currentPeriod == "MonthWise")
            {
                <div class="d-flex align-items-center gap-2">
                    <label class="small fw-bold text-secondary mb-0">Year:</label>
                    <select name="year" class="form-select form-select-sm rounded-pill" style="width: 110px;">
                        @for (int y = DateTime.UtcNow.Year; y >= DateTime.UtcNow.Year - 4; y--)
                        {
                            <option value="@y" selected="@(y == curYear)">@y</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-sm btn-dark rounded-pill px-3"><i class="fa-solid fa-filter me-1"></i> Apply</button>
                </div>
            }
            else if (currentPeriod == "Custom")
            {
                <div class="d-flex align-items-center gap-2">
                    <input type="date" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm rounded-pill" />
                    <span class="small text-muted">to</span>
                    <input type="date" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm rounded-pill" />
                    <button type="submit" class="btn btn-sm btn-dark rounded-pill px-3"><i class="fa-solid fa-filter me-1"></i> Filter</button>
                </div>
            }
        </form>
    </div>
</div>

<!-- KPI Summary Cards -->
<div class="row g-3 mb-4 animated-fade-in">
    <div class="col-xl-3 col-md-6 col-12">
        <div class="glass-card p-3 p-xl-4 h-100 border-start border-4 border-success">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Total Net Revenue</div>
                    <div class="fs-3 fw-bold text-success mt-1">₹@Model.TotalRevenue.ToString("N0")</div>
                    <div class="small text-muted mt-1">Completed & Settled Sales</div>
                </div>
                <div class="p-3 bg-success-subtle text-success rounded-circle">
                    <i class="fa-solid fa-indian-rupee-sign fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12">
        <div class="glass-card p-3 p-xl-4 h-100 border-start border-4 border-info">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Total Orders</div>
                    <div class="fs-3 fw-bold text-info mt-1">@Model.TotalOrders</div>
                    <div class="small text-muted mt-1">
                        <span class="text-dark fw-semibold">₹@Model.AverageOrderValue.ToString("N0")</span> Avg Ticket Value
                    </div>
                </div>
                <div class="p-3 bg-info-subtle text-info rounded-circle">
                    <i class="fa-solid fa-bag-shopping fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12">
        <div class="glass-card p-3 p-xl-4 h-100 border-start border-4 border-warning">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Total GST Collected</div>
                    <div class="fs-3 fw-bold text-warning mt-1">₹@Model.TotalTax.ToString("N0")</div>
                    <div class="small text-muted mt-1">
                        CGST: ₹@Model.TotalCGST.ToString("N0") &bull; SGST: ₹@Model.TotalSGST.ToString("N0")
                    </div>
                </div>
                <div class="p-3 bg-warning-subtle text-warning rounded-circle">
                    <i class="fa-solid fa-file-invoice-dollar fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12">
        <div class="glass-card p-3 p-xl-4 h-100 border-start border-4 border-primary" style="border-color:#0f766e !important;">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Takeaway / Parcel Sales</div>
                    <div class="fs-3 fw-bold mt-1" style="color:#0f766e;">₹@Model.TakeawaySales.ToString("N0")</div>
                    <div class="small text-muted mt-1">
                        Dine-in: ₹@Model.DineInSales.ToString("N0")
                    </div>
                </div>
                <div class="p-3 rounded-circle" style="background:#ccfbf1; color:#0f766e;">
                    <i class="fa-solid fa-box-open fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Visual Charts Section -->
<div class="row g-4 mb-4 animated-fade-in">
    <!-- Trend Chart -->
    <div class="col-lg-8">
        <div class="glass-card p-4 h-100 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0"><i class="fa-solid fa-chart-simple text-success me-2"></i>Sales & Revenue Trend</h5>
                <span class="badge bg-light text-secondary border">@(currentPeriod == "DayWise" ? "Daily Breakdown" : (currentPeriod == "MonthWise" ? "Monthly Breakdown" : "Yearly Trend"))</span>
            </div>
            <div style="height: 280px; width:100%;">
                <canvas id="salesTrendChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Payment & Channel Split -->
    <div class="col-lg-4">
        <div class="glass-card p-4 h-100 shadow-sm">
            <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-pie-chart text-info me-2"></i>Payment Breakdown</h5>
            <div style="height: 200px; width:100%; position:relative;">
                <canvas id="paymentMethodsChart"></canvas>
            </div>
            <div class="mt-3">
                @foreach (var p in Model.PaymentBreakdown)
                {
                    <div class="d-flex justify-content-between align-items-center small mb-1 pb-1 border-bottom">
                        <span class="fw-semibold text-dark"><i class="fa-solid fa-circle me-1 text-primary" style="font-size:0.5rem;"></i>@p.Method</span>
                        <span class="text-secondary">@p.TransactionCount txns (@p.Percentage%)</span>
                        <span class="fw-bold text-dark">₹@p.TotalAmount.ToString("N0")</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Detailed Table Section -->
<div class="glass-card p-4 mb-4 animated-fade-in shadow-sm">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 border-bottom pb-3">
        <div>
            <h5 class="fw-bold text-dark mb-0">
                <i class="fa-solid fa-table-list text-primary me-2"></i>Detailed @currentPeriod Breakdown
            </h5>
            <div class="text-muted small">Comprehensive audit of orders, tax liabilities, discounts, and settled figures</div>
        </div>
        <div class="badge rounded-pill bg-success-subtle text-success px-3 py-2 border border-success-subtle">
            @Model.BreakdownList.Count(b => b.OrdersCount > 0) active periods
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-muted small text-uppercase">
                <tr>
                    <th>Period</th>
                    <th class="text-center">Orders</th>
                    <th class="text-center">Dine-in</th>
                    <th class="text-center">Takeaway</th>
                    <th class="text-end">Gross Sales</th>
                    <th class="text-end">Tax (GST)</th>
                    <th class="text-end">Discounts</th>
                    <th class="text-end">Net Revenue</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.BreakdownList.Any() || Model.BreakdownList.All(b => b.OrdersCount == 0 && b.NetRevenue == 0))
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-chart-line fs-2 d-block mb-2 text-secondary opacity-50"></i>
                            <p class="small mb-0">No completed orders found for this selected period range.</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var row in Model.BreakdownList)
                    {
                        <tr class="@(row.OrdersCount > 0 ? "" : "text-muted opacity-75")">
                            <td class="fw-bold text-dark">
                                @row.PeriodLabel
                            </td>
                            <td class="text-center">
                                @if (row.OrdersCount > 0)
                                {
                                    <span class="badge rounded-pill bg-info-subtle text-info-emphasis border border-info-subtle px-3 py-1">@row.OrdersCount</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-center small">@(row.DineInCount > 0 ? row.DineInCount.ToString() : "-")</td>
                            <td class="text-center small">
                                @if (row.TakeawayCount > 0)
                                {
                                    <span class="badge rounded-pill" style="background:#ccfbf1; color:#0f766e; font-size:0.75rem;">@row.TakeawayCount</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-end text-secondary">₹@row.GrossSales.ToString("N0")</td>
                            <td class="text-end text-warning-emphasis">₹@row.TaxCollected.ToString("N0")</td>
                            <td class="text-end text-danger">@(row.DiscountGiven > 0 ? $"-₹{row.DiscountGiven:N0}" : "₹0")</td>
                            <td class="text-end fw-bold text-success fs-6">₹@row.NetRevenue.ToString("N0")</td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot class="table-light fw-bold">
                <tr>
                    <td>TOTALS</td>
                    <td class="text-center text-info">@Model.TotalOrders</td>
                    <td class="text-center">@Model.BreakdownList.Sum(b => b.DineInCount)</td>
                    <td class="text-center" style="color:#0f766e;">@Model.BreakdownList.Sum(b => b.TakeawayCount)</td>
                    <td class="text-end">₹@Model.BreakdownList.Sum(b => b.GrossSales).ToString("N0")</td>
                    <td class="text-end text-warning">₹@Model.TotalTax.ToString("N0")</td>
                    <td class="text-end text-danger">-₹@Model.TotalDiscount.ToString("N0")</td>
                    <td class="text-end text-success fs-5">₹@Model.TotalRevenue.ToString("N0")</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- Category Sales Breakdown -->
@if (Model.CategoryBreakdown.Any())
{
    <div class="glass-card p-4 animated-fade-in shadow-sm">
        <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-utensils text-success me-2"></i>Sales by Menu Category</h5>
        <div class="row g-3">
            @foreach (var c in Model.CategoryBreakdown)
            {
                <div class="col-md-4 col-sm-6 col-12">
                    <div class="p-3 bg-light rounded-4 border">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold text-dark">@c.CategoryName</span>
                            <span class="badge bg-success-subtle text-success">@c.Percentage%</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center small text-muted">
                            <span>@c.ItemsSold items sold</span>
                            <span class="fw-bold text-dark fs-6">₹@c.TotalSales.ToString("N0")</span>
                        </div>
                        <div class="progress mt-2" style="height: 6px;">
                            <div class="progress-bar bg-success" style="width: @c.Percentage%;"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    // 1. Sales Trend Bar/Line Chart
    const trendCtx = document.getElementById('salesTrendChart').getContext('2d');
    const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BreakdownList.Select(b => b.PeriodLabel)));
    const salesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BreakdownList.Select(b => b.NetRevenue)));
    const ordersData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BreakdownList.Select(b => b.OrdersCount)));

    new Chart(trendCtx, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [
                {
                    label: 'Net Revenue (₹)',
                    data: salesData,
                    backgroundColor: 'rgba(16, 185, 129, 0.7)',
                    borderColor: '#10b981',
                    borderWidth: 1,
                    borderRadius: 6,
                    yAxisID: 'y'
                },
                {
                    label: 'Orders Count',
                    data: ordersData,
                    type: 'line',
                    borderColor: '#0284c7',
                    backgroundColor: '#0284c7',
                    tension: 0.3,
                    borderWidth: 2,
                    pointRadius: 3,
                    yAxisID: 'y1'
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    type: 'linear',
                    display: true,
                    position: 'left',
                    ticks: {
                        callback: function(v) { return '₹' + v; }
                    }
                },
                y1: {
                    type: 'linear',
                    display: true,
                    position: 'right',
                    grid: { drawOnChartArea: false },
                    ticks: { precision: 0 }
                }
            }
        }
    });

    // 2. Payment Methods Donut Chart
    const payCtx = document.getElementById('paymentMethodsChart').getContext('2d');
    const payLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PaymentBreakdown.Select(p => p.Method)));
    const payAmounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PaymentBreakdown.Select(p => p.TotalAmount)));

    new Chart(payCtx, {
        type: 'doughnut',
        data: {
            labels: payLabels,
            datasets: [{
                data: payAmounts,
                backgroundColor: ['#10b981', '#0ea5e9', '#f59e0b', '#8b5cf6', '#ec4899'],
                borderWidth: 2
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });
</script>
}
