                                    </td>
                                    <td class="text-center small text-secondary">@row.DineInCount</td>
                                    <td class="text-end fw-bold text-success">₹@row.NetRevenue.ToString("N0")</td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td>@(isMarathi ? "एकूण पार्सल महसूल (TOTAL)" : "TOTAL TAKEAWAY REVENUE")</td>
                            <td class="text-center fs-6" style="color:#0f766e;">@Model.BreakdownList.Sum(b => b.TakeawayCount) Orders</td>
                            <td class="text-center text-muted">@Model.BreakdownList.Sum(b => b.DineInCount) Dine-in</td>
                            <td class="text-end text-success fs-5">₹@Model.TakeawaySales.ToString("N0")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    // Show and scroll to specific report pane
    function showReportPane(paneId, title) {
        var triggerEl = document.querySelector('#reportTabs button[data-bs-target="#' + paneId + '"]');
        if (triggerEl) {
            bootstrap.Tab.getInstance(triggerEl)?.show() || new bootstrap.Tab(triggerEl).show();
            triggerEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    }

    // Print specific report tab
    function printSpecificReport(paneId, title) {
        var triggerEl = document.querySelector('#reportTabs button[data-bs-target="#' + paneId + '"]');
        if (triggerEl) {
            bootstrap.Tab.getInstance(triggerEl)?.show() || new bootstrap.Tab(triggerEl).show();
        }
        var docTitle = document.getElementById('printReportDocTitle');
        if (docTitle && title) {
            docTitle.innerText = title;
        }
        setTimeout(function() {
            window.print();
        }, 200);
    }

    // 1. Sales Trend Bar/Line Chart
    const trendElem = document.getElementById('salesTrendChart');
    if (trendElem) {
        const trendCtx = trendElem.getContext('2d');
        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BreakdownList.Select(b => b.PeriodLabel)));
        const salesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BreakdownList.Select(b => b.NetRevenue)));
        const ordersData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BreakdownList.Select(b => b.OrdersCount)));

        new Chart(trendCtx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: '@(isMarathi ? "निव्वळ महसूल (₹)" : "Net Revenue (₹)")',
                        data: salesData,
                        backgroundColor: 'rgba(16, 185, 129, 0.7)',
                        borderColor: '#10b981',
                        borderWidth: 1,
                        borderRadius: 6,
                        yAxisID: 'y'
                    },
                    {
                        label: '@(isMarathi ? "ऑर्डर्स संख्या" : "Orders Count")',
                        data: ordersData,
                        type: 'line',
                        borderColor: '#0284c7',
                        backgroundColor: '#0284c7',
                        tension: 0.3,
                        borderWidth: 2,
                        pointRadius: 3,
                        yAxisID: 'y1'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        ticks: {
                            callback: function(v) { return '₹' + v; }
                        }
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        grid: { drawOnChartArea: false },
                        ticks: { precision: 0 }
                    }
                }
            }
        });
    }

    // 2. Payment Methods Donut Chart
    const payElem = document.getElementById('paymentMethodsChart');
    if (payElem) {
        const payCtx = payElem.getContext('2d');
        const payLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PaymentBreakdown.Select(p => p.Method)));
        const payAmounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PaymentBreakdown.Select(p => p.TotalAmount)));

        new Chart(payCtx, {
            type: 'doughnut',
            data: {
                labels: payLabels,
                datasets: [{
                    data: payAmounts,
                    backgroundColor: ['#10b981', '#0ea5e9', '#f59e0b', '#8b5cf6', '#ec4899'],
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });
    }

    // Filter Menu Item Report Table Real-time (by code or name)
    function filterMenuReportTable() {
        var query = document.getElementById('menuReportSearch').value.toLowerCase().trim();
        var rows = document.querySelectorAll('#menuReportTable tbody tr');
        rows.forEach(function (row) {
            var text = row.textContent.toLowerCase();
            row.style.display = text.indexOf(query) > -1 ? '' : 'none';
        });
    }
</script>
}