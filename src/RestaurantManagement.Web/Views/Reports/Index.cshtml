@model ComprehensiveReportDto
@inject IUnitOfWork UnitOfWork
@{
    var setting = (await UnitOfWork.RestaurantSettings.GetAllAsync()).FirstOrDefault();
    var currentLang = Context.Request.Cookies["GiranaRMS.Language"] ?? "en";
    var isMarathi = currentLang == "mr";
    var restaurantName = !string.IsNullOrWhiteSpace(setting?.RestaurantName) ? setting.RestaurantName : "Girana Garden";
    var restaurantNameMr = !string.IsNullOrWhiteSpace(setting?.RestaurantNameMarathi) ? setting.RestaurantNameMarathi : (!string.IsNullOrWhiteSpace(setting?.RestaurantName) ? setting.RestaurantName : "गिराणा गार्डन");
    var effectiveBrandName = isMarathi ? restaurantNameMr : restaurantName;
    ViewData["Title"] = isMarathi ? $"{effectiveBrandName} अहवाल सूची व विश्लेषण" : $"{effectiveBrandName} Reports Directory & Analytics";
    
    string currentPeriod = Model.PeriodType;
    int curYear = Model.SelectedYear;
    int curMonth = Model.SelectedMonth;
    var exportBaseUrl = $"/Reports/ExportExcel?period={currentPeriod}&year={curYear}&month={curMonth}&startDate={Model.StartDate:yyyy-MM-dd}&endDate={Model.EndDate:yyyy-MM-dd}";
}

<style>
    @@media print {
        #appSidebar, .sidebar, header, .app-footer, .no-print, .btn, .nav-tabs, form, .btn-group, .dropdown, #reportCatalogList {
            display: none !important;
        }
        .main-content {
            padding: 0 !important;
            margin: 0 !important;
            width: 100% !important;
        }
        .print-header {
            display: block !important;
            border-bottom: 2px solid #059669;
            padding-bottom: 12px;
            margin-bottom: 20px;
        }
        .glass-card {
            border: 1px solid #cbd5e1 !important;
            box-shadow: none !important;
            background: #fff !important;
        }
        table {
            border-collapse: collapse !important;
            width: 100% !important;
        }
        th, td {
            border: 1px solid #cbd5e1 !important;
            padding: 6px 10px !important;
            color: #000 !important;
        }
        .tab-pane {
            display: none !important;
        }
        .tab-pane.active {
            display: block !important;
            opacity: 1 !important;
            visibility: visible !important;
        }
    }
    .print-header {
        display: none;
    }
    .report-card-row {
        transition: all 0.2s ease-in-out;
        border: 1px solid #e2e8f0;
    }
    .report-card-row:hover {
        border-color: #059669;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(5, 150, 105, 0.08);
    }
    .report-badge-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }
</style>

<!-- Print Only Official Header -->
<div class="print-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-1" style="color: #059669;">@effectiveBrandName</h2>
            <div class="text-secondary small">@(setting?.Address ?? "Pure Veg Family Restaurant") &bull; Phone: @(setting?.Phone ?? "-") &bull; GSTIN: @(setting?.GSTIN ?? "-")</div>
            <h4 class="fw-bold mt-2 text-dark" id="printReportDocTitle">@(isMarathi ? "व्यावसायिक अहवाल व विश्लेषण" : "Official Business & Revenue Report")</h4>
            <div class="small text-muted">Period: @currentPeriod &bull; Generated: @DateTime.Now.ToString("dd-MMM-yyyy hh:mm tt")</div>
        </div>
        <div class="text-end">
            <div class="badge bg-success fs-6 p-2">Net Sales: ₹@Model.TotalRevenue.ToString("N0")</div>
            <div class="small text-muted mt-1">Total Orders: @Model.TotalOrders</div>
        </div>
    </div>
</div>

<!-- Screen Top Header Bar -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 animated-fade-in no-print">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 fs-6">
                <li class="breadcrumb-item">
                    <a href="/Dashboard" class="text-decoration-none fw-semibold text-success">
                        <i class="fa-solid fa-chart-pie me-1"></i> @(isMarathi ? "डॅशबोर्ड" : "Dashboard")
                    </a>
                </li>
                <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">
                    <i class="fa-solid fa-folder-open text-success me-1"></i> @(isMarathi ? "अहवाल सूची व डाउनलोड" : "Reports Directory")
                </li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-folder-open text-success me-2"></i>@(isMarathi ? "अहवाल सूची व डाउनलोड केंद्र" : "Reports Directory & Downloads")
        </h2>
        <div class="text-muted small mt-1">
            @(isMarathi ? "निवडलेला कालावधी: " : "Displaying period: ") 
            @if (currentPeriod == "DayWise")
            {
                <span class="fw-bold text-dark">@(new DateTime(curYear, curMonth, 1).ToString("MMMM yyyy"))</span>
            }
            else if (currentPeriod == "MonthWise")
            {
                <span class="fw-bold text-dark">@(isMarathi ? $"वर्ष {curYear}" : $"Year {curYear}")</span>
            }
            else if (currentPeriod == "YearWise")
            {
                <span class="fw-bold text-dark">@(isMarathi ? "मागील ५ वर्षे" : "Past 5 Years")</span>
            }
            else
            {
                <span class="fw-bold text-dark">@Model.StartDate.ToString("dd MMM yyyy") - @Model.EndDate.ToString("dd MMM yyyy")</span>
            }
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button onclick="window.print()" class="btn btn-outline-dark rounded-pill px-3 shadow-sm fw-semibold">
            <i class="fa-solid fa-print text-danger me-1"></i> @(isMarathi ? "प्रिंट / सर्व PDF" : "Print / PDF All")
        </button>
        <a href="/Dashboard" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm fw-semibold">
            <i class="fa-solid fa-arrow-left me-1"></i> @(isMarathi ? "डॅशबोर्डवर परत" : "Back to Dashboard")
        </a>
    </div>
</div>

<!-- Period Selection Card (Screen Only) -->
<div class="glass-card p-3 p-md-4 mb-4 animated-fade-in shadow-sm no-print">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <!-- Period Mode Switcher -->
        <div class="btn-group p-1 bg-light rounded-pill border" role="group">
            <a href="/Reports?period=DayWise&year=@curYear&month=@curMonth" class="btn btn-sm rounded-pill px-3 fw-bold @(currentPeriod == "DayWise" ? "btn-success shadow-sm" : "text-dark")">
                <i class="fa-solid fa-calendar-day me-1"></i> @(isMarathi ? "दिवसनिहाय" : "Day-wise")
            </a>
            <a href="/Reports?period=MonthWise&year=@curYear" class="btn btn-sm rounded-pill px-3 fw-bold @(currentPeriod == "MonthWise" ? "btn-success shadow-sm" : "text-dark")">
                <i class="fa-solid fa-calendar-week me-1"></i> @(isMarathi ? "महिनानिहाय" : "Month-wise")
            </a>
            <a href="/Reports?period=YearWise&year=@curYear" class="btn btn-sm rounded-pill px-3 fw-bold @(currentPeriod == "YearWise" ? "btn-success shadow-sm" : "text-dark")">
                <i class="fa-solid fa-calendar me-1"></i> @(isMarathi ? "वर्षनिहाय" : "Year-wise")
            </a>
            <a href="/Reports?period=Custom" class="btn btn-sm rounded-pill px-3 fw-bold @(currentPeriod == "Custom" ? "btn-success shadow-sm" : "text-dark")">
                <i class="fa-solid fa-sliders me-1"></i> @(isMarathi ? "कस्टम तारीख" : "Custom Range")
            </a>
        </div>

        <!-- Dynamic Filter Controls -->
        <form method="get" action="/Reports" class="d-flex flex-wrap align-items-center gap-2">
            <input type="hidden" name="period" value="@currentPeriod" />
            
            @if (currentPeriod == "DayWise")
            {
                <div class="d-flex align-items-center gap-2">
                    <label class="small fw-bold text-secondary mb-0">@(isMarathi ? "महिना:" : "Month:")</label>
                    <select name="month" class="form-select form-select-sm rounded-pill" style="width: 140px;">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(m == curMonth)">@(new DateTime(2026, m, 1).ToString("MMMM"))</option>
                        }
                    </select>
                    <label class="small fw-bold text-secondary mb-0">@(isMarathi ? "वर्ष:" : "Year:")</label>
                    <select name="year" class="form-select form-select-sm rounded-pill" style="width: 100px;">
                        @for (int y = DateTime.UtcNow.Year; y >= DateTime.UtcNow.Year - 4; y--)
                        {
                            <option value="@y" selected="@(y == curYear)">@y</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-sm btn-dark rounded-pill px-3"><i class="fa-solid fa-filter me-1"></i> @(isMarathi ? "लागू करा" : "Apply")</button>
                </div>
            }
            else if (currentPeriod == "MonthWise")
            {
                <div class="d-flex align-items-center gap-2">
                    <label class="small fw-bold text-secondary mb-0">@(isMarathi ? "वर्ष:" : "Year:")</label>
                    <select name="year" class="form-select form-select-sm rounded-pill" style="width: 110px;">
                        @for (int y = DateTime.UtcNow.Year; y >= DateTime.UtcNow.Year - 4; y--)
                        {
                            <option value="@y" selected="@(y == curYear)">@y</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-sm btn-dark rounded-pill px-3"><i class="fa-solid fa-filter me-1"></i> @(isMarathi ? "लागू करा" : "Apply")</button>
                </div>
            }
            else if (currentPeriod == "Custom")
            {
                <div class="d-flex align-items-center gap-2">
                    <input type="date" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm rounded-pill" />
                    <span class="small text-muted">@(isMarathi ? "ते" : "to")</span>
                    <input type="date" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm rounded-pill" />
                    <button type="submit" class="btn btn-sm btn-dark rounded-pill px-3"><i class="fa-solid fa-filter me-1"></i> @(isMarathi ? "फिल्टर करा" : "Filter")</button>
                </div>
            }
        </form>
    </div>
</div>

<!-- KPI Summary Cards -->
<div class="row g-3 mb-4 animated-fade-in no-print">
    <div class="col-xl-3 col-md-6 col-12">
        <div class="glass-card p-3 p-xl-4 h-100 border-start border-4 border-success">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">@(isMarathi ? "एकूण निव्वळ विक्री" : "Total Net Revenue")</div>
                    <div class="fs-3 fw-bold text-success mt-1">₹@Model.TotalRevenue.ToString("N0")</div>
                    <div class="small text-muted mt-1">@(isMarathi ? "पूर्ण व सेटल झालेल्या ऑर्डर्स" : "Completed & Settled Sales")</div>
                </div>
                <div class="p-3 bg-success-subtle text-success rounded-circle">
                    <i class="fa-solid fa-indian-rupee-sign fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12">
        <div class="glass-card p-3 p-xl-4 h-100 border-start border-4 border-info">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">@(isMarathi ? "एकूण ऑर्डर्स संख्या" : "Total Orders")</div>
                    <div class="fs-3 fw-bold text-info mt-1">@Model.TotalOrders</div>
                    <div class="small text-muted mt-1">
                        <span class="text-dark fw-semibold">₹@Model.AverageOrderValue.ToString("N0")</span> @(isMarathi ? "सरासरी बिल" : "Avg Ticket")
                    </div>
                </div>
                <div class="p-3 bg-info-subtle text-info rounded-circle">
                    <i class="fa-solid fa-bag-shopping fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12">
        <div class="glass-card p-3 p-xl-4 h-100 border-start border-4 border-warning">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">@(isMarathi ? "एकूण जीएसटी कर" : "Total GST Collected")</div>
                    <div class="fs-3 fw-bold text-warning mt-1">₹@Model.TotalTax.ToString("N0")</div>
                    <div class="small text-muted mt-1">
                        CGST: ₹@Model.TotalCGST.ToString("N0") &bull; SGST: ₹@Model.TotalSGST.ToString("N0")
                    </div>
                </div>
                <div class="p-3 bg-warning-subtle text-warning rounded-circle">
                    <i class="fa-solid fa-file-invoice-dollar fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12">
        <div class="glass-card p-3 p-xl-4 h-100 border-start border-4 border-primary" style="border-color:#0f766e !important;">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">@(isMarathi ? "पार्सल / टेकअवे विक्री" : "Takeaway / Parcel Sales")</div>
                    <div class="fs-3 fw-bold mt-1" style="color:#0f766e;">₹@Model.TakeawaySales.ToString("N0")</div>
                    <div class="small text-muted mt-1">
                        @(isMarathi ? "डायन-इन: " : "Dine-in: ")₹@Model.DineInSales.ToString("N0")
                    </div>
                </div>
                <div class="p-3 rounded-circle" style="background:#ccfbf1; color:#0f766e;">
                    <i class="fa-solid fa-box-open fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== USER-FRIENDLY LIST OF REPORTS (REPORT CATALOG) ==================== -->
<div class="glass-card p-4 mb-4 shadow-sm animated-fade-in no-print" id="reportCatalogList">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 pb-3 border-bottom">
        <div>
            <h4 class="fw-bold text-dark mb-0">
                <i class="fa-solid fa-list-check text-success me-2"></i>@(isMarathi ? "उपलब्ध अहवाल सूची (सर्व अहवाल एक्सेल व PDF मध्ये डाउनलोड करा)" : "Available Reports Catalog (View & Download in Excel & PDF)")
            </h4>
            <div class="text-muted small">
                @(isMarathi ? "खालील कोणत्याही अहवालावर क्लिक करून तक्ता पहा किंवा थेट एक्सेल आणि पीडीएफ डाउनलोड करा" : "Click 'View Report' to inspect detailed records or click Excel/PDF to download directly")
            </div>
        </div>
        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 fw-semibold">
            8 Ready Reports
        </span>
    </div>

    <div class="row g-3">
        <!-- Report 1: Sales & Revenue Report -->
        <div class="col-12">
            <div class="p-3 bg-white rounded-4 report-card-row d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="report-badge-icon bg-success-subtle text-success">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark fs-6">
                            1. @(isMarathi ? "दैनिक / मासिक विक्री व महसूल अहवाल" : "Sales & Revenue Summary Statement")
                        </div>
                        <div class="text-muted small">
                            @(isMarathi ? "कालावधीनुसार एकूण विक्री, कर, सूट व निव्वळ उत्पन्नाचा सर्वंकष अहवाल" : "Date-wise gross sales, GST tax collected, discount deductions, and net revenue breakdown")
                        </div>
                        <div class="small fw-semibold text-success mt-1">
                            <i class="fa-solid fa-circle-check me-1"></i>₹@Model.TotalRevenue.ToString("N0") Net Sales &bull; @Model.TotalOrders Orders &bull; ₹@Model.TotalTax.ToString("N0") GST
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" onclick="showReportPane('sales-pane', 'Sales & Revenue Statement')">
                        <i class="fa-solid fa-eye me-1"></i> @(isMarathi ? "अहवाल पहा" : "View Report")
                    </button>
                    <a href="@($"{exportBaseUrl}&reportType=Sales")" class="btn btn-sm btn-outline-success rounded-pill px-3 shadow-sm">
                        <i class="fa-solid fa-file-excel text-success me-1"></i> Excel (.csv)
                    </a>
                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 shadow-sm" onclick="printSpecificReport('sales-pane', 'Sales & Revenue Statement')">
                        <i class="fa-solid fa-file-pdf me-1"></i> PDF / Print
                    </button>
                </div>
            </div>
        </div>

        <!-- Report 2: Table-Wise Collection Report -->
        <div class="col-12">
            <div class="p-3 bg-white rounded-4 report-card-row d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="report-badge-icon bg-info-subtle text-info">
                        <i class="fa-solid fa-chair"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark fs-6">
                            2. @(isMarathi ? "टेबलनिहाय वसुली व विक्री अहवाल" : "Table-Wise Collection & Occupancy Report")
                        </div>
                        <div class="text-muted small">
                            @(isMarathi ? "प्रत्येक टेबलद्वारे पूर्ण केलेल्या ऑर्डर्स, सरासरी बिल आणि एकूण महसूल वाटा" : "Orders served, floor zones, average ticket value, and total collection share per table")
                        </div>
                        <div class="small fw-semibold text-info mt-1">
                            <i class="fa-solid fa-chair me-1"></i>@Model.TableBreakdown.Count Tables Active &bull; ₹@Model.TableBreakdown.Sum(t => t.TotalAmount).ToString("N0") Collected
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" onclick="showReportPane('table-pane', 'Table-Wise Collection Report')">
                        <i class="fa-solid fa-eye me-1"></i> @(isMarathi ? "अहवाल पहा" : "View Report")
                    </button>
                    <a href="@($"{exportBaseUrl}&reportType=Table")" class="btn btn-sm btn-outline-success rounded-pill px-3 shadow-sm">
                        <i class="fa-solid fa-file-excel text-success me-1"></i> Excel (.csv)
                    </a>
                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 shadow-sm" onclick="printSpecificReport('table-pane', 'Table-Wise Collection Report')">
                        <i class="fa-solid fa-file-pdf me-1"></i> PDF / Print
                    </button>
                </div>
            </div>
        </div>

        <!-- Report 3: Menu Item-Wise Sales Report -->
        <div class="col-12">
            <div class="p-3 bg-white rounded-4 report-card-row d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="report-badge-icon bg-warning-subtle text-warning">
                        <i class="fa-solid fa-utensils"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark fs-6">
                            3. @(isMarathi ? "पदार्थनिहाय (मेनू आयटम) विक्री व संकलन अहवाल" : "Menu Item-Wise Sales & Dish Performance Report")
                        </div>
                        <div class="text-muted small">
                            @(isMarathi ? "प्रत्येक पदार्थाचा शॉर्ट कोड, विक्री नग, दर, एकूण महसूल आणि टक्केवारी" : "Dish short codes, English/Marathi names, quantity sold, unit price, and revenue contribution")
                        </div>
                        <div class="small fw-semibold text-warning-emphasis mt-1">
                            <i class="fa-solid fa-bowl-food me-1"></i>@Model.MenuItemBreakdown.Count Menu Items &bull; @Model.MenuItemBreakdown.Sum(m => m.QuantitySold) Dishes Sold &bull; ₹@Model.MenuItemBreakdown.Sum(m => m.TotalRevenue).ToString("N0")
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" onclick="showReportPane('menu-pane', 'Menu Item-Wise Sales Report')">
                        <i class="fa-solid fa-eye me-1"></i> @(isMarathi ? "अहवाल पहा" : "View Report")
                    </button>
                    <a href="@($"{exportBaseUrl}&reportType=MenuItem")" class="btn btn-sm btn-outline-success rounded-pill px-3 shadow-sm">
                        <i class="fa-solid fa-file-excel text-success me-1"></i> Excel (.csv)
                    </a>
                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 shadow-sm" onclick="printSpecificReport('menu-pane', 'Menu Item-Wise Sales Report')">
                        <i class="fa-solid fa-file-pdf me-1"></i> PDF / Print
                    </button>
                </div>
            </div>
        </div>

        <!-- Report 4: Category-Wise Sales Report -->
        <div class="col-12">
            <div class="p-3 bg-white rounded-4 report-card-row d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="report-badge-icon bg-primary-subtle text-primary">
                        <i class="fa-solid fa-tags"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark fs-6">
                            4. @(isMarathi ? "मेनू श्रेणीनुसार विक्री अहवाल" : "Category-Wise Revenue Breakdown Report")
                        </div>
                        <div class="text-muted small">
                            @(isMarathi ? "स्टार्टर्स, मेन कोर्स, रोटी, शीतपेये इत्यादी श्रेणीनुसार विक्री संख्या व उत्पन्न" : "Sales breakdown across menu food categories, item quantities and % share")
                        </div>
                        <div class="small fw-semibold text-primary mt-1">
                            <i class="fa-solid fa-tag me-1"></i>@Model.CategoryBreakdown.Count Categories &bull; ₹@Model.CategoryBreakdown.Sum(c => c.TotalSales).ToString("N0") Category Revenue
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" onclick="showReportPane('category-pane', 'Category-Wise Revenue Report')">
                        <i class="fa-solid fa-eye me-1"></i> @(isMarathi ? "अहवाल पहा" : "View Report")
                    </button>
                    <a href="@($"{exportBaseUrl}&reportType=Category")" class="btn btn-sm btn-outline-success rounded-pill px-3 shadow-sm">
                        <i class="fa-solid fa-file-excel text-success me-1"></i> Excel (.csv)
                    </a>
                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 shadow-sm" onclick="printSpecificReport('category-pane', 'Category-Wise Revenue Report')">
                        <i class="fa-solid fa-file-pdf me-1"></i> PDF / Print
                    </button>
                </div>
            </div>
        </div>

        <!-- Report 5: Payment Modes Reconciliations -->
        <div class="col-12">
            <div class="p-3 bg-white rounded-4 report-card-row d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="report-badge-icon bg-secondary-subtle text-dark">
                        <i class="fa-solid fa-wallet"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark fs-6">
                            5. @(isMarathi ? "पेमेंट पद्धती व संकलन मेळ अहवाल" : "Payment Modes & Settlements Reconciliation Report")
                        </div>
                        <div class="text-muted small">
                            @(isMarathi ? "कॅश, युपीआय/क्यूआर, कार्ड व बँक ट्रान्सफर द्वारे जमा झालेली बिले आणि व्यवहार" : "Cash in counter, UPI/QR code settlements, Cards and reconciliation shares")
                        </div>
                        <div class="small fw-semibold text-dark mt-1">
                            <i class="fa-solid fa-money-bill-wave me-1"></i>@Model.PaymentBreakdown.Count Payment Modes &bull; ₹@Model.PaymentBreakdown.Sum(p => p.TotalAmount).ToString("N0") Total Settled
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" onclick="showReportPane('payment-pane', 'Payment Modes Reconciliation')">
                        <i class="fa-solid fa-eye me-1"></i> @(isMarathi ? "अहवाल पहा" : "View Report")
                    </button>
                    <a href="@($"{exportBaseUrl}&reportType=Payment")" class="btn btn-sm btn-outline-success rounded-pill px-3 shadow-sm">
                        <i class="fa-solid fa-file-excel text-success me-1"></i> Excel (.csv)
                    </a>
                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 shadow-sm" onclick="printSpecificReport('payment-pane', 'Payment Modes Reconciliation')">
                        <i class="fa-solid fa-file-pdf me-1"></i> PDF / Print
                    </button>
                </div>
            </div>
        </div>

        <!-- Report 6: GST & Tax Compliance Report -->
        <div class="col-12">
            <div class="p-3 bg-white rounded-4 report-card-row d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="report-badge-icon bg-warning-subtle text-danger">
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark fs-6">
                            6. @(isMarathi ? "जीएसटी कर विवरण व अनुपालन अहवाल" : "GST & Tax Compliance Statement Report")
                        </div>
                        <div class="text-muted small">
                            @(isMarathi ? "करपात्र महसूल, सीजीएसटी (2.5%), एसजीएसटी (2.5%) आणि एकूण जीएसटी कर संकलन" : "Taxable gross turnover, CGST, SGST, and statutory total tax collected for tax filing")
                        </div>
                        <div class="small fw-semibold text-danger mt-1">
                            <i class="fa-solid fa-receipt me-1"></i>₹@Model.TotalTax.ToString("N0") GST Collected (CGST: ₹@Model.TotalCGST:N0 &bull; SGST: ₹@Model.TotalSGST:N0)
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" onclick="showReportPane('gst-pane', 'GST & Tax Compliance Statement')">
                        <i class="fa-solid fa-eye me-1"></i> @(isMarathi ? "अहवाल पहा" : "View Report")
                    </button>
                    <a href="@($"{exportBaseUrl}&reportType=GST")" class="btn btn-sm btn-outline-success rounded-pill px-3 shadow-sm">
                        <i class="fa-solid fa-file-excel text-success me-1"></i> Excel (.csv)
                    </a>
                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 shadow-sm" onclick="printSpecificReport('gst-pane', 'GST & Tax Compliance Statement')">
                        <i class="fa-solid fa-file-pdf me-1"></i> PDF / Print
                    </button>
                </div>
            </div>
        </div>

        <!-- Report 7: Takeaway & Parcel Sales Report -->
        <div class="col-12">
            <div class="p-3 bg-white rounded-4 report-card-row d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="report-badge-icon bg-teal-subtle" style="background:#ccfbf1; color:#0f766e;">
                        <i class="fa-solid fa-box-open"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark fs-6">
                            7. @(isMarathi ? "पार्सल व टेकअवे विक्री अहवाल" : "Takeaway & Parcel Orders Report")
                        </div>
                        <div class="text-muted small">
                            @(isMarathi ? "काउंटर पार्सल ऑर्डर्स, पॅकिंग ऑर्डर्स आणि टेकअवेद्वारे झालेली निव्वळ विक्री" : "Counter takeaway pickups, parcel orders count and total takeaway sales revenue")
                        </div>
                        <div class="small fw-semibold mt-1" style="color:#0f766e;">
                            <i class="fa-solid fa-bag-shopping me-1"></i>₹@Model.TakeawaySales.ToString("N0") Takeaway Sales &bull; @Model.BreakdownList.Sum(b => b.TakeawayCount) Parcel Orders
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" onclick="showReportPane('takeaway-pane', 'Takeaway & Parcel Sales Report')">
                        <i class="fa-solid fa-eye me-1"></i> @(isMarathi ? "अहवाल पहा" : "View Report")
                    </button>
                    <a href="@($"{exportBaseUrl}&reportType=Takeaway")" class="btn btn-sm btn-outline-success rounded-pill px-3 shadow-sm">
                        <i class="fa-solid fa-file-excel text-success me-1"></i> Excel (.csv)
                    </a>
                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 shadow-sm" onclick="printSpecificReport('takeaway-pane', 'Takeaway & Parcel Sales Report')">
                        <i class="fa-solid fa-file-pdf me-1"></i> PDF / Print
                    </button>
                </div>
            </div>
        </div>

        <!-- Report 8: Income & Expenses Report -->
        <div class="col-12">
            <div class="p-3 bg-white rounded-4 report-card-row d-flex flex-wrap align-items-center justify-content-between gap-3 border-start border-4 border-success">
                <div class="d-flex align-items-center gap-3">
                    <div class="report-badge-icon bg-success-subtle text-success">
                        <i class="fa-solid fa-scale-balanced"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark fs-6">
                            8. @(isMarathi ? "उत्पन्न व खर्च (नफा-तोटा P&L) अहवाल" : "Income & Expenses (P&L) Financial Report")
                        </div>
                        <div class="text-muted small">
                            @(isMarathi ? "हॉटेलचे एकूण उत्पन्न, कामगारांचे पगार, किराणा व साहित्य खरेदी आणि निव्वळ नफा/तोटा" : "Monthly operating revenues, attendance-based staff salaries, raw stock expenses & net margin")
                        </div>
                        <div class="small fw-semibold text-success mt-1">
                            <i class="fa-solid fa-book-open me-1"></i>Official Accounts Module P&L Statement
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <a href="/Accounts?tab=income-expenses&month=@curMonth&year=@curYear" class="btn btn-sm btn-success rounded-pill px-3 shadow-sm">
                        <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> @(isMarathi ? "खाते विभागात उघडा" : "Open in Accounts")
                    </a>
                    <a href="/Accounts/ExportIncomeExpenseExcel?month=@curMonth&year=@curYear" class="btn btn-sm btn-outline-success rounded-pill px-3 shadow-sm">
                        <i class="fa-solid fa-file-excel text-success me-1"></i> Excel (.csv)
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== DETAILED REPORT VIEWER TABS ==================== -->
<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h5 class="fw-bold text-dark mb-0">
        <i class="fa-solid fa-table-list text-primary me-2"></i>@(isMarathi ? "तपशीलवार अहवाल डेटा टेबल" : "Detailed Report Data View")
    </h5>
    <div class="text-muted small">
        @(isMarathi ? "खालील टॅब निवडून कोणताही अहवाल सविस्तर पहा किंवा सर्च करा" : "Switch tabs below to view detailed breakdown table or search records")
    </div>
</div>

<!-- Module Navigation Tabs -->
<ul class="nav nav-pills mb-4 p-1 bg-white border rounded-pill shadow-sm no-print" id="reportTabs" role="tablist" style="width: fit-content;">
    <li class="nav-item" role="presentation">
        <button class="nav-link active rounded-pill px-3 fw-bold" id="sales-tab" data-bs-toggle="pill" data-bs-target="#sales-pane" type="button" role="tab">
            <i class="fa-solid fa-chart-line me-1"></i>@(isMarathi ? "विक्री अहवाल" : "Sales Summary")
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link rounded-pill px-3 fw-bold" id="table-tab" data-bs-toggle="pill" data-bs-target="#table-pane" type="button" role="tab">
            <i class="fa-solid fa-chair me-1"></i>@(isMarathi ? "टेबल वसुली" : "Table Collection")
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link rounded-pill px-3 fw-bold" id="menu-tab" data-bs-toggle="pill" data-bs-target="#menu-pane" type="button" role="tab">
            <i class="fa-solid fa-utensils me-1"></i>@(isMarathi ? "मेनू पदार्थ विक्री" : "Menu Item Sales")
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link rounded-pill px-3 fw-bold" id="category-tab" data-bs-toggle="pill" data-bs-target="#category-pane" type="button" role="tab">
            <i class="fa-solid fa-tags me-1"></i>@(isMarathi ? "श्रेणी महसूल" : "Category Breakdown")
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link rounded-pill px-3 fw-bold" id="payment-tab" data-bs-toggle="pill" data-bs-target="#payment-pane" type="button" role="tab">
            <i class="fa-solid fa-wallet me-1"></i>@(isMarathi ? "पेमेंट पद्धती" : "Payment Modes")
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link rounded-pill px-3 fw-bold" id="gst-tab" data-bs-toggle="pill" data-bs-target="#gst-pane" type="button" role="tab">
            <i class="fa-solid fa-file-invoice-dollar me-1"></i>@(isMarathi ? "जीएसटी विवरण" : "GST Statement")
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link rounded-pill px-3 fw-bold" id="takeaway-tab" data-bs-toggle="pill" data-bs-target="#takeaway-pane" type="button" role="tab">
            <i class="fa-solid fa-box-open me-1"></i>@(isMarathi ? "पार्सल विक्री" : "Takeaway Sales")
        </button>
    </li>
</ul>

<!-- Tab Contents -->
<div class="tab-content" id="reportTabContent">

    <!-- TAB 1: SALES & REVENUE -->
    <div class="tab-pane fade show active" id="sales-pane" role="tabpanel">
        <!-- Visual Charts Section -->
        <div class="row g-4 mb-4 animated-fade-in no-print">
            <!-- Trend Chart -->
            <div class="col-lg-8">
                <div class="glass-card p-4 h-100 shadow-sm">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-dark mb-0"><i class="fa-solid fa-chart-simple text-success me-2"></i>@(isMarathi ? "विक्री व ऑर्डर ट्रेंड" : "Sales & Revenue Trend")</h5>
                        <span class="badge bg-light text-secondary border">@(currentPeriod == "DayWise" ? (isMarathi ? "दैनिक आढावा" : "Daily Breakdown") : (currentPeriod == "MonthWise" ? (isMarathi ? "मासिक आढावा" : "Monthly Breakdown") : (isMarathi ? "वार्षिक ट्रेंड" : "Yearly Trend")))</span>
                    </div>
                    <div style="height: 280px; width:100%;">
                        <canvas id="salesTrendChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Payment Methods Donut -->
            <div class="col-lg-4">
                <div class="glass-card p-4 h-100 shadow-sm">
                    <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-wallet text-primary me-2"></i>@(isMarathi ? "पेमेंट पद्धतीनुसार संकलन" : "Payment Methods")</h5>
                    <div style="height: 220px; width:100%; position:relative;">
                        <canvas id="paymentMethodsChart"></canvas>
                    </div>
                    <div class="mt-3">
                        @foreach (var p in Model.PaymentBreakdown)
                        {
                            <div class="d-flex justify-content-between align-items-center small py-1 border-bottom">
                                <span class="fw-semibold text-dark">@p.Method</span>
                                <div>
                                    <span class="text-muted me-2">₹@p.TotalAmount.ToString("N0")</span>
                                    <span class="badge bg-light text-dark border">@p.Percentage%</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Detailed Breakdown Datagrid -->
        <div class="glass-card p-4 mb-4 animated-fade-in shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0"><i class="fa-solid fa-table-list text-success me-2"></i>@(isMarathi ? "तपशीलवार विक्री विवरण" : "Detailed Sales Statement")</h5>
                <div class="d-flex gap-2 no-print">
                    <a href="@($"{exportBaseUrl}&reportType=Sales")" class="btn btn-sm btn-outline-success rounded-pill px-3">
                        <i class="fa-solid fa-file-excel text-success me-1"></i> Excel (.csv)
                    </a>
                    <button onclick="printSpecificReport('sales-pane', 'Sales Statement')" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                        <i class="fa-solid fa-print me-1"></i> Print / PDF
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th>@(isMarathi ? "कालावधी / तारीख" : "Period")</th>
                            <th class="text-center">@(isMarathi ? "ऑर्डर्स" : "Orders")</th>
                            <th class="text-center">@(isMarathi ? "डायन-इन" : "Dine-in")</th>
                            <th class="text-center">@(isMarathi ? "पार्सल" : "Takeaway")</th>
                            <th class="text-end">@(isMarathi ? "एकूण विक्री" : "Gross Sales")</th>
                            <th class="text-end">@(isMarathi ? "कर (GST)" : "Tax (GST)")</th>
                            <th class="text-end">@(isMarathi ? "सूट" : "Discounts")</th>
                            <th class="text-end">@(isMarathi ? "निव्वळ महसूल" : "Net Revenue")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.BreakdownList.Any() || Model.BreakdownList.All(b => b.OrdersCount == 0 && b.NetRevenue == 0))
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-chart-line fs-2 d-block mb-2 text-secondary opacity-50"></i>
                                    <p class="small mb-0">@(isMarathi ? "या कालावधीसाठी कोणत्याही पूर्ण झालेल्या ऑर्डर्स सापडल्या नाहीत." : "No completed orders found for this selected period range.")</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in Model.BreakdownList)
                            {
                                <tr class="@(row.OrdersCount > 0 ? "" : "text-muted opacity-75")">
                                    <td class="fw-bold text-dark">@row.PeriodLabel</td>
                                    <td class="text-center">
                                        @if (row.OrdersCount > 0)
                                        {
                                            <span class="badge rounded-pill bg-info-subtle text-info-emphasis border border-info-subtle px-3 py-1">@row.OrdersCount</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-center small">@(row.DineInCount > 0 ? row.DineInCount.ToString() : "-")</td>
                                    <td class="text-center small">
                                        @if (row.TakeawayCount > 0)
                                        {
                                            <span class="badge rounded-pill" style="background:#ccfbf1; color:#0f766e; font-size:0.75rem;">@row.TakeawayCount</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-end text-secondary">₹@row.GrossSales.ToString("N0")</td>
                                    <td class="text-end text-warning-emphasis">₹@row.TaxCollected.ToString("N0")</td>
                                    <td class="text-end text-danger">@(row.DiscountGiven > 0 ? $"-₹{row.DiscountGiven:N0}" : "₹0")</td>
                                    <td class="text-end fw-bold text-success fs-6">₹@row.NetRevenue.ToString("N0")</td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td>@(isMarathi ? "एकूण (TOTALS)" : "TOTALS")</td>
                            <td class="text-center text-info">@Model.TotalOrders</td>
                            <td class="text-center">@Model.BreakdownList.Sum(b => b.DineInCount)</td>
                            <td class="text-center" style="color:#0f766e;">@Model.BreakdownList.Sum(b => b.TakeawayCount)</td>
                            <td class="text-end">₹@Model.BreakdownList.Sum(b => b.GrossSales).ToString("N0")</td>
                            <td class="text-end text-warning">₹@Model.TotalTax.ToString("N0")</td>
                            <td class="text-end text-danger">-₹@Model.TotalDiscount.ToString("N0")</td>
                            <td class="text-end text-success fs-5">₹@Model.TotalRevenue.ToString("N0")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- TAB 2: TABLE-WISE COLLECTION -->
    <div class="tab-pane fade" id="table-pane" role="tabpanel">
        <div class="glass-card p-4 mb-4 animated-fade-in shadow-sm">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div>
                    <h5 class="fw-bold text-dark mb-0"><i class="fa-solid fa-chair text-primary me-2"></i>@(isMarathi ? "टेबलनिहाय महसूल व वसुली अहवाल" : "Table-wise Revenue & Collection Report")</h5>
                    <div class="text-muted small">@(isMarathi ? "प्रत्येक टेबलद्वारे व्युत्पन्न झालेली एकूण बिले, ऑर्डर्स आणि महसूल वाटा" : "Orders served, total bill amount, average ticket and % share per table")</div>
                </div>
                <div class="d-flex gap-2 no-print">
                    <a href="@($"{exportBaseUrl}&reportType=Table")" class="btn btn-sm btn-outline-success rounded-pill px-3">
                        <i class="fa-solid fa-file-excel text-success me-1"></i> Excel (.csv)
                    </a>
                    <button onclick="printSpecificReport('table-pane', 'Table-Wise Collection Report')" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                        <i class="fa-solid fa-print me-1"></i> Print / PDF
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th>@(isMarathi ? "टेबल / जागा" : "Table / Location")</th>
                            <th>@(isMarathi ? "फ्लोअर" : "Floor")</th>
                            <th class="text-center">@(isMarathi ? "पूर्ण ऑर्डर्स" : "Orders Served")</th>
                            <th class="text-end">@(isMarathi ? "सरासरी बिल" : "Avg Ticket (₹)")</th>
                            <th class="text-end">@(isMarathi ? "एकूण वसुली (₹)" : "Total Collection (₹)")</th>
                            <th style="min-width: 140px;">@(isMarathi ? "महसूल वाटा (%)" : "Revenue Share (%)")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.TableBreakdown.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-chair fs-2 d-block mb-2 text-secondary opacity-50"></i>
